{
  "name": "venn-website",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 8000",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 8000",
    "test:e2e": "node --test --test-concurrency=1 e2e/consent.spec.mjs e2e/team.spec.mjs e2e/share.spec.mjs",
    "qa:mobile": "node scripts/mobile-qa.mjs",
    "delete-request": "node scripts/portal/delete.mjs",
    "test": "node --test scripts/qa/*.test.mjs scripts/portal/*.test.mjs src/scripts/portal/*.test.ts src/lib/portal/*.test.ts src/data/*.test.ts",
    "qa:portal": "node scripts/qa/portal.mjs",
    "qa:results": "node scripts/qa/results-journeys.mjs",
    "seed:portal": "node scripts/portal/seed.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^8.2.11",
    "@fontsource/dancing-script": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "astro": "^5.18.2"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true
  },
  "devDependencies": {
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0"
  }
}
