---
import Base from '../layouts/Base.astro';
---
<Base title="Refer friends to Venn" description="Share your Venn application and bring a friend." noindex>
  <section class="refer">
    <div class="refer-bg" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="glass" id="card">

      <div class="screen" data-screen="loading">
        <p class="muted">Loading...</p>
      </div>

      <div class="screen" data-screen="missing" hidden>
        <h1 class="h" tabindex="-1">We couldn't find that link.</h1>
        <p class="sub">Open the link from your confirmation email. Haven't applied yet? Start there.</p>
        <div class="row"><a class="btn" href="/apply">Apply to Venn</a></div>
      </div>

      <div class="screen" data-screen="error" hidden>
        <h1 class="h" tabindex="-1">That didn't load.</h1>
        <p class="sub" id="error-msg">Check your connection and try again.</p>
        <div class="row"><button class="btn" type="button" id="retry">Try again</button></div>
      </div>

      <div class="screen" data-screen="main" hidden>
        <div>
          <p class="label" id="steps-label">Step 1 of 3 done</p>
          <div class="bar" aria-hidden="true"><i id="bar"></i></div>
        </div>
        <h1 class="h" tabindex="-1" id="headline"></h1>
        <p class="sub" id="subline"></p>

        <ol class="steps">
          <li class="step done" data-step="applied">
            <div class="step-head static"><span class="tick"></span><span class="step-t">Applied</span></div>
          </li>

          <li class="step" data-step="linkedin">
            <button class="step-head" type="button" aria-expanded="false" aria-controls="p-linkedin" data-toggle="linkedin">
              <span class="tick"></span><span class="step-t">Post on LinkedIn</span><span class="step-s" id="s-linkedin">About 1 minute</span>
            </button>
            <div class="panel" id="p-linkedin" hidden>
              <p class="sub">Fill in the blank, then copy the post to LinkedIn.</p>
              <label class="field">
                <span class="field-l">I am building</span>
                <input type="text" id="building" autocomplete="off" maxlength="80" placeholder="a robotics app for my school" />
              </label>
              <label class="field">
                <span class="field-l">Your post (edit it if you like)</span>
                <textarea id="post" rows="6"></textarea>
              </label>
              <p class="tip">Before you post, type @Venn and pick <strong>Venn, the student org connector</strong> from the list (tap the one with the Venn logo). Plain "@Venn" text doesn't count.</p>
              <div class="row"><a class="btn" id="open-li" target="_blank" rel="noopener" href="https://www.linkedin.com/feed/">Copy post and open LinkedIn</a></div>
              <p class="hint" id="li-fill" hidden>Fill in the blank above to unlock the post.</p>
              <p class="hint">Post box empty? Paste what you copied.</p>

              <div class="part">
                <p class="err" id="li-err" role="alert"></p>
                <div class="row"><button class="btn" type="button" id="li-save">I posted it</button></div>
              </div>
            </div>
          </li>

          <li class="step" data-step="friends">
            <button class="step-head" type="button" aria-expanded="false" aria-controls="p-friends" data-toggle="friends">
              <span class="tick"></span><span class="step-t">Refer friends</span><span class="step-s" id="s-friends">About 1 minute</span>
            </button>
            <div class="panel" id="p-friends" hidden>
              <p class="sub">Send your link to a friend who builds things. Up to 10 count.</p>
              <p class="count" id="count" aria-live="polite"></p>
              <p class="hint" id="pending" hidden></p>
              <div class="row stack">
                <a class="btn" id="email" href="#" target="_blank" rel="noopener">Email a friend</a>
                <button class="btn btn-ghost" type="button" id="share" hidden>Send in a text or app</button>
                <button class="btn btn-ghost" type="button" id="copylink">Copy my link</button>
              </div>
              <a class="link" id="email-alt" href="#" hidden>Not on Gmail? Open your default mail app</a>
              <div class="manual" id="manual" hidden>
                <label class="field" for="manual-link"><span class="field-l">Press and hold to copy</span></label>
                <textarea id="manual-link" rows="2" readonly></textarea>
              </div>
              <p class="hint">Your link: <code id="mylink"></code></p>
            </div>
          </li>
        </ol>
      </div>

    </div>
  </section>
</Base>

<style>
  .refer { position: relative; overflow: hidden; padding: 112px 16px 72px; min-height: 100vh; }
  @media (min-width: 768px) { .refer { padding: 140px 16px 104px; } }
  .refer-bg {
    position: absolute; inset: 0; pointer-events: none;
    -webkit-mask-image: linear-gradient(transparent, #000 14%, #000 86%, transparent); mask-image: linear-gradient(transparent, #000 14%, #000 86%, transparent);
  }
  .refer-bg i { position: absolute; width: 70vmax; aspect-ratio: 1; animation: drift 22s ease-in-out infinite alternate; }
  .refer-bg i:nth-child(1) { background: radial-gradient(closest-side, rgba(159, 191, 154, .5), rgba(159, 191, 154, .28) 40%, rgba(159, 191, 154, .1) 70%, transparent); left: -30vmax; top: -18vmax; }
  .refer-bg i:nth-child(2) { background: radial-gradient(closest-side, rgba(196, 212, 239, .7), rgba(196, 212, 239, .38) 40%, rgba(196, 212, 239, .12) 70%, transparent); right: -32vmax; top: -6vmax; width: 75vmax; animation-duration: 27s; animation-delay: -9s; }
  .refer-bg i:nth-child(3) { background: radial-gradient(closest-side, rgba(159, 191, 154, .4), rgba(159, 191, 154, .2) 45%, rgba(159, 191, 154, .07) 72%, transparent); left: 10%; bottom: -34vmax; width: 62vmax; animation-duration: 31s; animation-delay: -16s; }
  @keyframes drift { to { transform: translate(7vw, -5vh) scale(1.12); } }
  .glass {
    position: relative; max-width: 560px; margin: 0 auto; padding: 24px 20px 20px; border-radius: 28px;
    background: rgba(255, 255, 255, .5); -webkit-backdrop-filter: blur(28px) saturate(1.8); backdrop-filter: blur(28px) saturate(1.8);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .95), inset 0 0 0 1px rgba(255, 255, 255, .6), inset 0 -1px 0 rgba(255, 255, 255, .35), 0 40px 90px -40px rgba(30, 45, 35, .3);
  }
  @media (min-width: 640px) { .glass { padding: 36px 40px 28px; } }

  .screen { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; align-content: start; }
  .screen.in { animation: s-in .45s var(--ease); }
  @keyframes s-in { from { opacity: 0; transform: translateY(14px); filter: blur(4px); } }
  .h { font-size: clamp(1.9rem, 7vw, 2.6rem); font-weight: 600; letter-spacing: -.04em; line-height: 1.05; }
  .h:focus { outline: none; }
  .sub { color: var(--body); font-size: 16px; }
  .label { margin-bottom: 8px; }
  .bar { height: 6px; border-radius: 6px; background: rgba(0, 0, 0, .08); overflow: hidden; }
  .bar i { display: block; height: 100%; background: var(--black); border-radius: inherit; transform-origin: left; transform: scaleX(.3333); transition: transform .6s var(--ease); }

  .steps { list-style: none; margin: 4px 0 0; padding: 0; display: grid; gap: 0; }
  .step { border-bottom: 1px solid rgba(0, 0, 0, .08); }
  .step:last-child { border-bottom: 0; }
  .step-head {
    display: flex; align-items: center; gap: 12px; width: 100%; min-height: 56px; padding: 10px 0; text-align: left;
    font: 17px/1.3 var(--font); color: var(--black); background: none; border: 0; cursor: pointer;
  }
  .step-head.static { cursor: default; }
  .step-t { flex: 1; min-width: 0; font-weight: 500; }
  .step-s { flex: none; font-size: 13px; color: var(--muted); }
  .step-head:not(.static)::after { content: ''; flex: none; width: 8px; height: 8px; border: solid var(--muted); border-width: 0 1.5px 1.5px 0; transform: rotate(45deg); transition: transform .3s var(--ease); margin: 0 4px 3px 2px; }
  .step-head[aria-expanded=true]::after { transform: rotate(-135deg); margin-bottom: -3px; }
  .tick { flex: none; width: 24px; height: 24px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px #c9c9cc; position: relative; }
  .done > .step-head > .tick, .done > .tick { background: var(--black); box-shadow: none; }
  .done > .step-head > .tick::after { content: ''; position: absolute; left: 50%; top: 50%; width: 6px; height: 11px; border: solid #fff; border-width: 0 2px 2px 0; transform: translate(-50%, -64%) rotate(45deg); }
  .panel { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; padding: 4px 0 22px; }
  .panel[hidden] { display: none; }

  .row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 2px; }
  .row .btn { flex: 1 1 auto; min-height: 52px; }
  .row.stack { flex-direction: column; }
  .row.stack .btn { flex: none; }

  .field { display: grid; gap: 6px; }
  .field-l { font-size: 14px; color: var(--muted); }
  input[type=text], input[type=url], textarea {
    font: 17px/1.5 var(--font); color: var(--text); background: rgba(255, 255, 255, .85);
    border: 0; box-shadow: inset 0 0 0 1px #e0e0e0; border-radius: 14px; padding: 13px 16px; width: 100%; min-height: 48px;
  }
  textarea { resize: vertical; min-height: 120px; }
  @media (min-width: 641px) { #post { min-height: 260px; } }
  textarea[readonly] { min-height: 64px; font-size: 15px; }
  input:focus, textarea:focus { outline: none; box-shadow: inset 0 0 0 2px #000; }
  input::placeholder { color: #a5a5a8; }
  .tip { font-size: 14px; line-height: 1.5; color: var(--text); background: rgba(255, 255, 255, .7); border-radius: 14px; padding: 12px 16px; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .05); }
  .hint { font-size: 14px; color: var(--muted); line-height: 1.5; overflow-wrap: anywhere; }
  .hint code { font: 13px/1.4 var(--mono); color: var(--text); }
  .err { font-size: 14px; color: #b91c1c; }
  .err:empty { display: none; }
  .part { display: grid; gap: 10px; padding-top: 16px; border-top: 1px solid rgba(0, 0, 0, .08); margin-top: 4px; }
  .part .field { margin-bottom: -4px; }
  .count { font-size: 17px; font-weight: 500; color: var(--black); }
  .manual { display: grid; gap: 8px; }
  .manual[hidden] { display: none; }

  .link { font: 15px/1 var(--font); color: var(--muted); background: none; border: 0; padding: 14px 0; min-height: 44px; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: #ccc; justify-self: start; }
  .link:hover { color: var(--black); }
  .link[hidden] { display: none; }

  .btn:focus-visible, .link:focus-visible, .step-head:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    .refer-bg i { animation: none; }
    .screen.in { animation: none; }
    .bar i, .step-head::after { transition: none; }
  }
</style>

<script>
  const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
  const SB_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

  type Status = { first_name: string; ref_code: string; linkedin: boolean; referrals: number; pending: number };

  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll<T>(s)];
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  class RpcError extends Error {
    kind: 'server' | 'network' | 'client';
    constructor(kind: 'server' | 'network' | 'client', msg: string) { super(msg); this.kind = kind; }
  }
  const rpc = async (fn: string, args: Record<string, unknown>) => {
    // kind 'server' = our side (missing config, bad key, 5xx); 'network' = the visitor's connection.
    if (!SB_URL || !SB_KEY) throw new RpcError('server', 'missing config');
    let r: Response;
    try {
      r = await fetch(`${SB_URL}/rest/v1/rpc/${fn}`, {
        method: 'POST',
        headers: { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}`, 'Content-Type': 'application/json' },
        body: JSON.stringify(args),
      });
    } catch { throw new RpcError('network', 'offline'); }
    const j = await r.json().catch(() => null);
    if (!r.ok) throw new RpcError(r.status === 400 || r.status === 422 ? 'client' : 'server', String(j?.message ?? 'request failed'));
    return j;
  };

  const code = (new URLSearchParams(location.search).get('code') ?? '').trim().toLowerCase().slice(0, 40);
  const draft = {
    get: () => { try { return localStorage.getItem('venn-refer-building:' + code) ?? ''; } catch { return ''; } },
    set: (v: string) => { try { localStorage.setItem('venn-refer-building:' + code, v); } catch { /* private mode */ } },
  };

  const ua = navigator.userAgent;
  const isIOS = /iPhone|iPad|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const isAndroid = /Android/i.test(ua);
  const isPhone = isIOS || isAndroid;

  const MAX_FRIENDS = 10; // the SQL view counts at most 10 verified referrals
  const cap = (s: string) => s.charAt(0).toLocaleUpperCase() + s.slice(1);
  let st: Status | null = null;
  let link = '';
  let open: 'linkedin' | 'friends' | null = null;

  const show = (name: string) => {
    $$('[data-screen]').forEach((s) => { s.hidden = s.dataset.screen !== name; s.classList.remove('in'); });
    const scr = $(`[data-screen="${name}"]`);
    if (!calm) { void scr.offsetWidth; scr.classList.add('in'); }
  };

  // ---- Render: everything comes from the last referral_status, never from memory ----
  const setOpen = (which: 'linkedin' | 'friends' | null) => {
    open = which;
    (['linkedin', 'friends'] as const).forEach((k) => {
      const on = which === k;
      $(`#p-${k}`).hidden = !on;
      $(`[data-toggle="${k}"]`).setAttribute('aria-expanded', String(on));
    });
  };

  const render = () => {
    if (!st) return;
    const friends = st.referrals;
    const shown = Math.min(friends, MAX_FRIENDS);
    const maxed = friends >= MAX_FRIENDS;
    const nm = cap(st.first_name);
    const n = 1 + +st.linkedin + +(friends > 0);
    $('#steps-label').textContent = `Step ${n} of 3 done`;
    $('#bar').style.transform = `scaleX(${n / 3})`;
    $('#headline').textContent =
      n === 3 ? `All 3 steps done, ${nm}.` : n === 1 ? `Your application is in, ${nm}.` : `Nice, ${nm}. ${n} of 3 done.`;
    $('#subline').textContent =
      n === 3 ? 'Every friend who applies with your link counts, up to 10.'
      : n === 1 ? 'Two quick steps left. Applications with people behind them get a closer look.'
      : 'One step left.';

    $('.step[data-step="linkedin"]').classList.toggle('done', st.linkedin);
    $('.step[data-step="friends"]').classList.toggle('done', friends > 0);
    $('#s-linkedin').textContent = st.linkedin ? 'Done' : '1 min';
    $('#s-friends').textContent = maxed ? `${MAX_FRIENDS} of ${MAX_FRIENDS}` : friends > 0 ? `${shown} applied` : '1 min';
    $('#li-save').textContent = st.linkedin ? 'Posted' : 'I posted it';
    $<HTMLButtonElement>('#li-save').disabled = st.linkedin;

    $('#count').textContent =
      maxed ? `${MAX_FRIENDS} of ${MAX_FRIENDS} friends counted. That's the max, thank you.`
      : friends > 0 ? `${shown} ${shown === 1 ? 'friend' : 'friends'} applied with your link.` : 'No friends yet.';
    const pend = $('#pending');
    pend.hidden = st.pending < 1;
    pend.textContent = st.pending < 1 ? '' : `${st.pending} more ${st.pending === 1 ? 'counts' : 'count'} once their confirmation email goes out.`;
  };

  const merge = (s: Status | null) => { if (s) { st = s; render(); } };

  // ---- LinkedIn -----------------------------------------------------------
  const PLACEHOLDER = '<what you\'re working on>';
  const blank = () => $<HTMLInputElement>('#building').value.trim() || PLACEHOLDER;
  const postText = () =>
    `I just applied to Venn's F26 season, a program for high schoolers building things.\n\nI'm building ${blank()}.\n\nIf you're building something too, apply here: ${link}`;
  const post = () => $<HTMLTextAreaElement>('#post');
  const liHref = () => `https://www.linkedin.com/feed/?shareActive=true&text=${encodeURIComponent(post().value)}`;
  const syncPost = () => {
    const ta = post();
    if (ta.dataset.edited !== '1') ta.value = postText();
    $<HTMLAnchorElement>('#open-li').href = liHref();
    gateCopy();
  };
  // Never copy the literal placeholder: hold the button until the blank is filled (or the post is edited past it).
  const gateCopy = () => {
    const a = $<HTMLAnchorElement>('#open-li');
    const blocked = post().value.includes(PLACEHOLDER);
    a.setAttribute('aria-disabled', blocked ? 'true' : 'false');
    a.style.opacity = blocked ? '0.45' : '';
    a.style.pointerEvents = blocked ? 'none' : '';
    $('#li-fill').hidden = !blocked;
  };

  const execCopy = (text: string) => {
    const t = document.createElement('textarea');
    t.value = text; t.style.position = 'fixed'; t.style.opacity = '0';
    document.body.appendChild(t); t.select();
    let ok = false;
    try { ok = document.execCommand('copy'); } catch { /* nothing */ }
    t.remove();
    return ok;
  };
  // Starts the copy synchronously (inside the click). Resolves true when the text reached the clipboard.
  const copy = (text: string): Promise<boolean> => {
    if (navigator.clipboard?.writeText) {
      try { return navigator.clipboard.writeText(text).then(() => true, () => execCopy(text)); } catch { /* fall through */ }
    }
    return Promise.resolve(execCopy(text));
  };
  const flash = (btn: HTMLElement, msg: string) => {
    const old = btn.dataset.label ?? btn.textContent ?? '';
    btn.dataset.label = old;
    btn.textContent = msg;
    setTimeout(() => { btn.textContent = old; }, 1800);
  };

  // ---- Friends: every composer opens inside the click, nothing awaited first ----
  const mailParts = () => ({
    subject: 'Apply to Venn with me',
    body:
      `Hey,\n\nI just applied to Venn's F26 season, a free program for high schoolers building things. ` +
      `I thought of you because you're building something too.\n\n` +
      `It's a short form. Apply with my link:\n${link}\n\n${st ? cap(st.first_name) : ''}`,
  });
  const q = encodeURIComponent;
  const mailto = () => { const m = mailParts(); return `mailto:?subject=${q(m.subject)}&body=${q(m.body)}`; };
  const gmailWeb = () => { const m = mailParts(); return `https://mail.google.com/mail/?view=cm&fs=1&su=${q(m.subject)}&body=${q(m.body)}`; };
  const gmailApp = () => { const m = mailParts(); return `googlegmail://co?to=&subject=${q(m.subject)}&body=${q(m.body)}`; };

  const logEmail = () => { rpc('record_step', { code, kind: 'email', url: null }).catch(() => { /* analytics only */ }); };

  const showManual = () => {
    $('#manual').hidden = false;
    const ta = $<HTMLTextAreaElement>('#manual-link');
    ta.value = link;
    ta.focus();
    ta.select();
    ta.setSelectionRange(0, link.length);
  };

  const wireFriends = () => {
    const email = $<HTMLAnchorElement>('#email');
    const alt = $<HTMLAnchorElement>('#email-alt');
    // Phones: plain mailto is the default action (Android hands it to the Gmail app or a chooser); iOS is handled below.
    // Desktop: a real anchor to the Gmail web composer, opened in a new tab by the browser itself (no popup blocker).
    if (isPhone) email.removeAttribute('target');
    alt.hidden = false;
    email.addEventListener('click', (e) => {
      if (isIOS) {
        e.preventDefault();
        // Gmail app missing: the page is still here and visible a moment later, so use the mail app instead.
        // Any sign we left (Gmail opened, app switch, tab hidden) cancels the fallback so both never open.
        const timer = setTimeout(() => { stop(); if (document.visibilityState === 'visible') location.href = mailto(); }, 1200);
        const gone = () => { clearTimeout(timer); stop(); };
        const stop = () => {
          removeEventListener('pagehide', gone);
          removeEventListener('blur', gone);
          document.removeEventListener('visibilitychange', gone);
        };
        addEventListener('pagehide', gone);
        addEventListener('blur', gone);
        document.addEventListener('visibilitychange', gone);
        location.href = gmailApp();
      }
      logEmail();
    });
    alt.addEventListener('click', logEmail);

    $('#copylink').addEventListener('click', (e) => {
      const btn = e.currentTarget as HTMLElement;
      copy(link).then((ok) => {
        if (ok) flash(btn, 'Link copied');
        else showManual();
      });
      logEmail();
    });

    if (isPhone && typeof navigator.share === 'function') {
      const b = $('#share');
      b.hidden = false;
      b.addEventListener('click', () => {
        const p = navigator.share({ text: "I just applied to Venn's F26 season. If you're building something, apply with my link:", url: link });
        p.then(logEmail, () => { /* cancelled */ });
      });
    }
  };

  // ---- Wiring -------------------------------------------------------------
  const wire = () => {
    $$('[data-toggle]').forEach((b) => b.addEventListener('click', () => {
      const k = b.dataset.toggle as 'linkedin' | 'friends';
      setOpen(open === k ? null : k);
    }));

    const building = $<HTMLInputElement>('#building');
    building.value = draft.get();
    building.addEventListener('input', () => { draft.set(building.value); syncPost(); });
    post().addEventListener('input', () => { post().dataset.edited = '1'; $<HTMLAnchorElement>('#open-li').href = liHref(); gateCopy(); });

    // Copy first (started inside the click), then the browser follows the link to LinkedIn.
    $('#open-li').addEventListener('click', (e) => {
      if (post().value.includes(PLACEHOLDER)) { e.preventDefault(); return; }
      $<HTMLAnchorElement>('#open-li').href = liHref();
      copy(post().value);
    });

    const err = $('#li-err');
    const save = $<HTMLButtonElement>('#li-save');
    save.addEventListener('click', async () => {
      err.textContent = '';
      save.disabled = true;
      try {
        merge((await rpc('record_step', { code, kind: 'linkedin', url: null })) as Status | null);
        setOpen('friends');
        $('#headline').focus({ preventScroll: true });
        scrollTo({ top: 0, behavior: calm ? 'auto' : 'smooth' });
      } catch {
        err.textContent = 'Could not save that. Try again in a moment.';
        save.disabled = false;
      }
    });

    wireFriends();
    $('#retry').addEventListener('click', boot);
  };

  let lastFetch = 0;
  const refresh = async () => {
    if (!st || Date.now() - lastFetch < 4000) return;
    lastFetch = Date.now();
    try { merge((await rpc('referral_status', { code })) as Status | null); } catch { /* keep showing what we have */ }
  };

  async function boot() {
    show('loading');
    if (!code) return show('missing');
    let s: Status | null;
    try { s = (await rpc('referral_status', { code })) as Status | null; } catch (ex) {
      $('#error-msg').textContent = (ex as RpcError).kind === 'network'
        ? 'Check your connection and try again.'
        : "Something's off on our end. Try again in a little while.";
      return show('error');
    }
    if (!s) return show('missing');
    lastFetch = Date.now();
    st = s;
    link = `https://joinvenn.org/apply?ref=${encodeURIComponent(s.ref_code)}`;
    $('#mylink').textContent = link.replace('https://', '');
    syncPost();
    $<HTMLAnchorElement>('#email').href = isPhone ? mailto() : gmailWeb();
    $<HTMLAnchorElement>('#email-alt').href = mailto();
    render();
    setOpen(s.linkedin ? 'friends' : 'linkedin');
    show('main');
    $('#headline').focus({ preventScroll: true });
  }

  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') refresh(); });
  addEventListener('focus', refresh);
  addEventListener('pageshow', (e) => { if ((e as PageTransitionEvent).persisted) refresh(); });

  wire();
  boot();
</script>
