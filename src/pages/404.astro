---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Venn" description="This page doesn't exist. Head back to Venn's homepage or guides.">
  <section style="padding-top:180px;padding-bottom:140px">
    <div class="narrow" style="text-align:center">
      <p class="label">404</p>
      <h1 class="h2" style="margin-top:12px">This page doesn't exist.</h1>
      <p class="lede" style="margin-inline:auto">The link may be old or mistyped.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:32px">
        <a class="btn" href="/#apply">Apply to Venn</a>
        <a class="btn btn-ghost" href="/guides/">Read the guides</a>
      </div>
    </div>
  </section>
</Base>
