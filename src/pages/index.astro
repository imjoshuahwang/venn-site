---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import LogoWall from '../components/home/LogoWall.astro';
import Statement from '../components/home/Statement.astro';
import ApplyScene from '../components/home/ApplyScene.astro';
import PastSeasons from '../components/home/PastSeasons.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Faq from '../components/home/Faq.astro';
import Closer from '../components/home/Closer.astro';

---
<Base title="Venn: the student organization connector" description="Venn is a free program that connects high school and college students building clubs, nonprofits, projects, and startups with college clubs and companies in their field. Apply for Fall ’26.">
  <!-- Old shared links (/?ref=maya-7k2) go straight to the focused apply page. -->
  <script is:inline>{`var r=new URLSearchParams(location.search).get('ref');if(r)location.replace('/apply?ref='+encodeURIComponent(r));`}</script>
  <Hero />
  <LogoWall />
  <Statement />
  <ApplyScene />
  <PastSeasons />
  <Testimonials />
  <Faq />
  <Closer />
</Base>
