---
export const prerender = false;
import Portal from '../../layouts/Portal.astro';
import CohortSlides from '../../components/portal/results/CohortSlides.astro';
import SharePill from '../../components/portal/SharePill.astro';
import GuidingQuestions from '../../components/portal/GuidingQuestions.astro';
import { logoUrl } from '../../data/mou';
import { getMyGuidingAnswers, guidingAccess } from '../../lib/portal/guiding';
import { Waitlist, NotThisSeason, ResultState, Peer, Cohort } from '../../components/portal/results';
import { pageFor } from '../../data/portal-copy';
import { peerView, stateOf } from '../../data/portal-peer';
import { getMyResult, getMyPeers, getCohortView, stubResult } from '../../lib/portal/rpc-adapter';
import { getMyResult as getFullResult } from '../../lib/portal/api';

let result = null;
let peer: ReturnType<typeof peerView>[] = [];
let cohort = null;
let cohortView = null;
let guiding = {};
let failed = false;
let firstName = '';
try {
  const stub = import.meta.env.DEV ? Astro.url.searchParams.get('stub') : null;
  result = stub ? stubResult(stub) : await getMyResult(Astro.locals.supabase);
  if (result?.outcome === 'cohort' && !stub) {
    const full = await getFullResult(Astro.locals.supabase);
    if (full.error) throw new Error(full.error.message);
    cohort = full.data;
    guiding = cohort ? await getMyGuidingAnswers(Astro.locals.supabase, cohort.id) : {};
    cohortView = cohort ? await getCohortView(Astro.locals.supabase, cohort.id) : null;
  }
  if (result?.outcome === 'peer') {
    const rows = await getMyPeers(Astro.locals.supabase);
    // A load only reads: the tap is written by the explicit POST. get_my_peer carries the contact once both are down.
    peer = rows.map((row) => peerView(row, stateOf(row) === 'both' ? row.contact : null));
  }
} catch {
  failed = true;
}
if (result && !failed) firstName = ((await Astro.locals.supabase.rpc('get_my_first_name')).data ?? '').split(' ')[0];
const access = guidingAccess({ isLead: cohortView?.isLead ?? false, cutoff: cohort?.cohort?.guiding_cutoff });
const page = result ? pageFor(result.outcome) : null;
---
<Portal title="Your Result">
  {failed ? <ResultState state="error" />
    : result?.outcome === 'cohort' ? <Cohort result={cohort} view={cohortView}>
      <CohortSlides slot="slides" cohort={cohort?.cohort} firstName={firstName} logo={logoUrl(cohort?.cohort?.logo_path, import.meta.env.PUBLIC_SUPABASE_URL)} />
      {cohort && <GuidingQuestions slot="guidingQuestions" resultId={cohort.id} answers={guiding} closed={access === 'closed'} readonly={access === 'readonly'} />}
    </Cohort>
    : result?.outcome === 'peer' ? <Peer view={peer} />
    : page === 'waitlist' ? <Waitlist outcome={result.outcome} letter={result.letter} />
    : page === 'not_this_season' ? <NotThisSeason letter={result.letter} />
    : <ResultState state="empty" />}
  {!failed && (result?.outcome === 'cohort' || result?.outcome === 'peer') && <SharePill name={firstName} label={cohort?.cohort?.name} kind={result.outcome} />}
</Portal>
