---
export const prerender = false;
import Portal from '../../layouts/Portal.astro';
import NextStep from '../../components/portal/NextStep.astro';
import TextJosh from '../../components/portal/TextJosh.astro';
import { pickNextStep, loadHome, type NextStepInput } from '../../lib/portal/home';
import { joshPhone } from '../../scripts/portal/text-link';
import { stubSavePhone } from '../../lib/portal/rpc-adapter';
import { getConsentState } from '../../lib/portal/api';
import { CONSENT_VERSION } from '../../data/consent';

const dev = import.meta.env.DEV ? Astro.url.searchParams.get('state') : null;
const stubs: Record<string, Partial<NextStepInput>> = {
  'waiting-on-parent': { under18: true, parentSigned: false },
  'consent-missing': { consentGiven: false },
  'sign-mou': { outcome: 'cohort', mouSigned: false },
  'guiding-questions': { guidingAnswered: false },
  'text-josh': { phoneSaved: false },
  'kickoff-countdown': { kickoffAt: new Date(Date.now() + 6.5 * 86_400_000).toISOString() },
  'all-set': {},
};
const empty: NextStepInput = { under18: null, parentSigned: null, consentGiven: null, mouSigned: null, outcome: null, guidingAnswered: null, phoneSaved: null, kickoffAt: null };
let input: NextStepInput = empty;
let result = null;
let failed = false;
let team: { email_key: string }[] = [];
let cohortName: string | null = null;
let savedPhone: string | null = null;
let savedCode: string | null = null;
try {
  if (dev === 'error') throw new Error('stub');
  if (dev && stubs[dev]) {
    input = { ...empty, ...stubs[dev] };
    result = { outcome: input.outcome ?? 'cohort' };
    if (input.phoneSaved !== false) { savedPhone = '+14155550123'; savedCode = stubSavePhone('', false); }
  } else {
    const h = await loadHome(Astro.locals.supabase);
    input = h.input;
    result = h.result;
    team = h.team;
    cohortName = h.cohortName;
    savedPhone = h.phone;
    savedCode = h.code;
  }
} catch {
  failed = true;
}
// A missing or failing consent_state must be visible, never a silent skip of the consent redirect.
let consent = null;
let consentFailed = false;
try {
  const r = await getConsentState(Astro.locals.supabase, CONSENT_VERSION);
  consent = r.data;
  consentFailed = !!r.error || !r.data;
} catch {
  consentFailed = true;
}
if (!consentFailed && consent?.application && consent.done === false) return Astro.redirect('/portal/ceremony', 303);
const under18 = consent?.minor === true || input.under18 === true;
const locked = under18 && input.parentSigned !== true;
const showParentForm = !dev && consent?.minor === true && input.parentSigned !== true;
const step = pickNextStep({ ...input, under18 });

---
<Portal title="Your Venn home">
  {consentFailed ? <><p role="alert">We could not load this page.</p><form method="get" action="/portal"><button class="pill" type="submit" data-retry>Retry</button></form></> : failed ? <p role="alert" data-home-error>We could not load your home page. Please refresh, or email contact@joinvenn.org.</p> : (
    <>
      <NextStep step={step} />
      <a class="pill" style="margin-top: var(--sp-32)" href="/portal/consent">Review consent</a>
      {showParentForm && <form method="post" action="/portal/parent-request" class="parent-request" style="display: flex; flex-direction: column; align-items: flex-start; gap: var(--sp-12); margin-top: var(--sp-32)">
        <label for="parent_email">Parent email</label>
        <input id="parent_email" name="parent_email" type="email" required autocomplete="off" style="min-height: 44px" />
        <button class="pill" type="submit">Send to my parent</button>
      </form>}
      <section class="home-section" id="text-josh">
        <TextJosh firstName="" code={savedCode ?? ''} phone={savedPhone ?? ''} josh={joshPhone(import.meta.env)} locked={locked} />
      </section>
      {result && <section class="home-section" data-result-summary>
        <h2>Your Result</h2>
        <a class="pill" href="/portal/result">View your Result</a>
      </section>}
      <section class="home-section" data-team>
        <h2>Your team</h2>
        {team.length ? <p>{team.length === 1 ? '1 teammate' : `${team.length} teammates`} on your team.</p> : <p data-empty>No teammates yet.</p>}
      </section>
      <section class="home-section" data-partner>
        <h2>Your cohort</h2>
        {cohortName ? <p>{cohortName}</p> : <p data-empty>Your cohort will show here once you are placed.</p>}
      </section>
    </>
  )}
</Portal>
<style>
  .home-section { display: grid; gap: var(--sp-16); justify-items: start; margin-top: var(--sp-32); }
  .home-section h2 { margin: 0; font-size: var(--fs-22); font-weight: var(--fw-600); letter-spacing: var(--track-tight); }
  .home-section p { margin: 0; font-size: var(--fs-17); color: var(--ink); }
  [data-home-error] { font-size: var(--fs-17); color: var(--ink); }
</style>
