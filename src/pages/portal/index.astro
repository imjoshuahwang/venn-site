---
export const prerender = false;
import Portal from '../../layouts/Portal.astro';
import '../../components/portal/results/outcome.css';
import SlideDeck from '../../components/portal/slides/SlideDeck.astro';
import Slide from '../../components/portal/slides/Slide.astro';
import Ceremony from '../../components/portal/Ceremony.astro';
import { getCeremonyData, stubMode } from '../../lib/portal/ceremony-data';
import { initialScreen } from '../../lib/portal/ceremony.mjs';
import { getConsentState } from '../../lib/portal/api';
import { loadHome } from '../../lib/portal/home';
import { CONSENT_VERSION } from '../../data/consent';
import { nextStepsFor } from '../../data/next-steps';
import { getMyMatch } from '../../lib/portal/match-rpc';

import { onboardingRedirect } from '../../lib/portal/onboarding';
import { fixture } from '../../lib/portal/ceremony-data';
import { STUB_EMAIL } from '../../lib/portal/dev-fixtures';
// Dev only (#314): ?stub=<outcome>|none|error[&done=1] renders the home or the ceremony with no session.
const stub = import.meta.env.DEV ? Astro.url.searchParams.get('stub') : null;
const onboarding = stub ? null : await onboardingRedirect(Astro.locals.supabase);
if (onboarding) return Astro.redirect(onboarding, 303);
const home = stub ? { ceremony: fixture(stub, Astro.url.searchParams.get('done') === '1'), consentFailed: false, redirectToConsent: false } : await loadHome({
  ceremony: () => getCeremonyData(Astro),
  consent: () => getConsentState(Astro.locals.supabase, CONSENT_VERSION),
});
const { ceremony, consentFailed } = home;
const replay = ceremony.status === 'ok' && !!ceremony.result.doneAt && Astro.url.searchParams.get('replay') === '1';
const inCeremony = replay || (ceremony.status === 'ok' && initialScreen(ceremony.result) === 'ceremony');
// #127 consent, #128 parent, #132 phone are on their own pages: setup slots show only in stub mode unless ?setup=0.
const showSlots = !replay && !!stubMode() && Astro.url.searchParams.get('setup') !== '0';
const setup = { consent: !showSlots, parent: !showSlots, phone: !showSlots };
if (home.redirectToConsent) return Astro.redirect('/portal/ceremony', 303);
const email = stub ? STUB_EMAIL : Astro.locals.user?.email ?? '';
const none = ceremony.status === 'none' && !consentFailed;
const failed = ceremony.status === 'error' || consentFailed;
// The match page is offered once a match is approved or past it; a failing lookup just hides the link.
const hasMatchLink = !stub && !inCeremony && !failed && !none && await getMyMatch(Astro.locals.supabase).then((m) => !!m?.status && ['approved', 'revealed', 'requested', 'accepted'].includes(m.status), () => false);
---
<Portal title="Your Venn home">
  {inCeremony ? <Ceremony result={replay ? { ...ceremony.result, viewedAt: ceremony.result.viewedAt ?? ceremony.result.doneAt } : ceremony.result} setup={setup} replay={replay} /> : failed ? (
    <SlideDeck label="Home"><Slide title="We could not load this page." lead="That one is on us. Give it another go in a moment." cta=""><form method="get" action="/portal"><button class="btn" type="submit" data-retry>Try again</button></form></Slide></SlideDeck>
  ) : none ? (
    <SlideDeck label="Home"><Slide title="We could not find a result for you." lead={`Nothing turned up for ${email}. If you applied with another address, sign in with that one.`} cta="">
      <div class="actions"><form method="post" action="/portal/logout"><button class="btn" type="submit">Sign in with a different email</button></form><a class="btn btn-ghost" href="mailto:contact@joinvenn.org">Write to contact@joinvenn.org</a></div>
    </Slide></SlideDeck>
  ) : (
    <SlideDeck label="Home" data-home>
      <Slide title="Your results are here." lead={ceremony.status === 'ok' && ceremony.result.cohortName ? ceremony.result.cohortName : 'Read your letter, then see what comes next.'} cta="">
        <div class="actions" data-home>
          <a class="btn" href="/portal/result">View your results</a>
          {hasMatchLink && <a class="btn btn-ghost" href="/portal/match" data-match-link>Your match</a>}
          <a class="btn btn-ghost" href="/portal/next-steps" data-next-step>Next: {ceremony.status === 'ok' && ceremony.result.outcome === 'cohort' ? nextStepsFor(null).steps[0] : 'what to do from here'}</a>
          {ceremony.status === 'ok' && <a class="btn btn-ghost" href="/portal?replay=1" data-watch-again>Watch again</a>}
          <a class="btn btn-ghost" href="/portal/consent">Review consent</a>
        </div>
      </Slide>
    </SlideDeck>
  )}
</Portal>
