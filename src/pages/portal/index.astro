---
export const prerender = false;
import Portal from '../../layouts/Portal.astro';
import { Waitlist, NotThisSeason, ResultState } from '../../components/portal/results';
import { pageFor } from '../../data/portal-copy';
import { getMyResult, stubResult } from '../../lib/portal/rpc-adapter';

let result = null;
let failed = false;
try {
  const stub = import.meta.env.DEV ? Astro.url.searchParams.get('stub') : null;
  result = stub ? stubResult(stub) : await getMyResult(Astro.locals.supabase);
} catch {
  failed = true;
}
const page = result ? pageFor(result.outcome) : null;
---
<Portal title="Your Result">
  {failed ? <ResultState state="error" />
    : page === 'waitlist' ? <Waitlist outcome={result.outcome} letter={result.letter} />
    : page === 'not_this_season' ? <NotThisSeason letter={result.letter} />
    : <ResultState state="empty" />}
</Portal>
