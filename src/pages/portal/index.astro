---
export const prerender = false;
import Portal from '../../layouts/Portal.astro';
import Ceremony from '../../components/portal/Ceremony.astro';
import { getCeremonyData, stubMode } from '../../lib/portal/ceremony-data';
import { initialScreen } from '../../lib/portal/ceremony.mjs';
import { getConsentState } from '../../lib/portal/api';
import { loadHome } from '../../lib/portal/home';
import { CONSENT_VERSION } from '../../data/consent';
import { nextStepsFor } from '../../data/next-steps';
import { getMyMatch } from '../../lib/portal/match-rpc';

const home = await loadHome({
  ceremony: () => getCeremonyData(Astro),
  consent: () => getConsentState(Astro.locals.supabase, CONSENT_VERSION),
});
const { ceremony, consentFailed } = home;
const replay = ceremony.status === 'ok' && !!ceremony.result.doneAt && Astro.url.searchParams.get('replay') === '1';
const inCeremony = replay || (ceremony.status === 'ok' && initialScreen(ceremony.result) === 'ceremony');
// #127 consent, #128 parent, #132 phone are on their own pages: setup slots show only in stub mode unless ?setup=0.
const showSlots = !replay && !!stubMode() && Astro.url.searchParams.get('setup') !== '0';
const setup = { consent: !showSlots, parent: !showSlots, phone: !showSlots };
if (home.redirectToConsent) return Astro.redirect('/portal/ceremony', 303);
const email = Astro.locals.user?.email ?? '';
const none = ceremony.status === 'none' && !consentFailed;
const failed = ceremony.status === 'error' || consentFailed;
// The match page is offered once a match is approved or past it; a failing lookup just hides the link.
const hasMatchLink = !inCeremony && !failed && !none && await getMyMatch(Astro.locals.supabase).then((m) => !!m?.status && ['approved', 'revealed', 'requested', 'accepted'].includes(m.status), () => false);
---
<Portal title="Your Venn home">
  {inCeremony ? <Ceremony result={replay ? { ...ceremony.result, viewedAt: ceremony.result.viewedAt ?? ceremony.result.doneAt } : ceremony.result} setup={setup} replay={replay} /> : failed ? <><section class="home" data-error><h1 role="alert">We could not load this page</h1><form method="get" action="/portal"><button class="pill" type="submit" data-retry>Try again</button></form></section></> : none ? (
    <section class="home" data-none>
      <h1>We could not find a result for {email}</h1>
      <form method="post" action="/portal/logout"><button class="pill" type="submit">Sign in with a different email</button></form>
      <p class="help">Questions? Write to <span class="nw"><a href="mailto:contact@joinvenn.org">contact@joinvenn.org</a>.</span></p>
    </section>
  ) : (
    <section class="home" data-home>
      {ceremony.status === 'ok' && ceremony.result.cohortName && <p class="cohort" data-cohort-name>{ceremony.result.cohortName}</p>}
      <h1>Your results are here</h1>
      <a class="pill" href="/portal/result">View your results</a>
      {hasMatchLink && <a class="pill" href="/portal/match" data-match-link>Your match</a>}
      {ceremony.status === 'ok' && ceremony.result.outcome === 'cohort' && <a class="pill ghost" href="/portal/next-steps" data-next-step>Next: {nextStepsFor(null).steps[0]}</a>}
      {ceremony.status === 'ok' && <a class="pill ghost" href="/portal?replay=1" data-watch-again>Watch again</a>}
      <a class="pill ghost" href="/portal/consent">Review consent</a>
    </section>
  )}
</Portal>
<style>
  .home { display: grid; gap: var(--sp-24); justify-items: start; }
  .home h1 { margin: 0; font-size: var(--fs-28); font-weight: var(--fw-800); letter-spacing: var(--track-tight); line-height: 1.15; }
  .cohort { margin: 0; font-size: var(--fs-15); font-weight: var(--fw-800); color: var(--muted); }
  .home .pill.ghost:last-child { margin-top: var(--sp-16); }
  .nw { white-space: nowrap; }
  .help { margin: 0; font-size: var(--fs-15); color: var(--muted); }
  .help a { display: inline-flex; align-items: center; min-height: 44px; color: inherit; text-underline-offset: 3px; }
</style>
