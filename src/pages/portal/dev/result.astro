---
export const prerender = false;
import Portal from '../../../layouts/Portal.astro';
import CohortSlides from '../../../components/portal/results/CohortSlides.astro';
import GuidingQuestions from '../../../components/portal/GuidingQuestions.astro';
import { logoUrl } from '../../../data/mou';
import { STUB_GUIDING } from '../../../lib/portal/guiding';
import { Waitlist, NotThisSeason, ResultState, Peer, Cohort } from '../../../components/portal/results';
import { peerView } from '../../../data/portal-peer';
import { stubPeer, STUB_CONTACT } from '../../../lib/portal/rpc-adapter';
if (!import.meta.env.DEV) return new Response(null, { status: 404 });
const q = Astro.url.searchParams;
const outcome = q.get('outcome') ?? 'network_waitlist';
const state = q.get('state') ?? 'ready';
const letter = state === 'empty' ? null : `Dear Applicant,\n\nThank you for the care you put into your application. This fixture letter stands in for the one the team writes for you.\n\nThe Venn team`;
// Peer states: not-tapped (default), waiting, both-down. `fail=1` makes the tap error; `mutual=1` makes the tap complete the pair.
const peerState = state === 'waiting' ? 'waiting' : state === 'both-down' ? 'both' : 'none';
const peerEndpoint = '/portal/dev/peer-down?' + (q.get('fail') ? 'fail=1' : q.get('mutual') ? 'mutual=1' : '');
// Cohort states: unsigned (default), signed, full, null (missing cohort fields), member (non-lead), plus loading/error. `fail=full|signed|not_owner|invalid|retry` makes Sign error.
const cohortRow = state === 'null' ? { id: 1, name: 'Fall cohort', company: null, goal: null, criteria: null, timeline: null, video_url: null, slides_url: null, logo_path: null }
  : { id: 1, name: 'Teaching Tools', company: 'Lincoln Labs', goal: 'Ship one tool that a teacher uses every week.', criteria: 'A team of students with a working prototype and a real user.', timeline: 'Sept to Dec 2026, one session a week.', video_url: 'https://www.youtube.com/watch?v=fixture', slides_url: 'https://example.com/slides', logo_path: 'https://wirjadichvbmrqzamwtp.supabase.co/storage/v1/object/public/cohort-logos/fixture.png' };
const cohortResult = { id: 1, letter, cohort: cohortRow };
const cohortView = { signature: state === 'signed' ? { typed_name: 'Maya Lee', signed_at: '2026-11-18T17:00:00Z' } : null, isLead: state !== 'member', orgCount: state === 'null' ? null : 4 };
const mouEndpoint = '/portal/dev/mou' + (q.get('fail') ? `?fail=${encodeURIComponent(q.get('fail'))}` : '');
const guidingEndpoint = '/portal/dev/guiding' + (q.get('gfail') ? `?fail=${encodeURIComponent(q.get('gfail'))}` : '');
const peer = peerView(stubPeer(peerState), peerState === 'both' ? STUB_CONTACT : null);
---
<Portal title="Result fixture">
  {state === 'loading' || state === 'error' ? <ResultState state={state} />
    : outcome === 'cohort' ? <Cohort result={cohortResult} view={cohortView} full={state === 'full'} endpoint={mouEndpoint}>
      <CohortSlides slot="slides" cohort={cohortRow} logo={logoUrl(cohortRow.logo_path, import.meta.env.PUBLIC_SUPABASE_URL)} />
      <GuidingQuestions slot="guidingQuestions" resultId={cohortResult.id} answers={state === 'empty-answers' ? {} : STUB_GUIDING} endpoint={guidingEndpoint} closed={q.get('gfail') === 'closed-load'} />
    </Cohort>
    : outcome === 'peer' ? <Peer view={state === 'empty' ? null : peer} endpoint={peerEndpoint} />
    : outcome === 'not_this_season' ? <NotThisSeason letter={letter} />
    : <Waitlist outcome={outcome === 'track_waitlist' ? 'track_waitlist' : 'network_waitlist'} letter={letter} />}
</Portal>
