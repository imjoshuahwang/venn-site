---
import Portal from '../../../layouts/Portal.astro';
import ParentConsent from '../../../components/portal/ParentConsent.astro';
import { parseParentState } from '../../../data/parent-consent';

export const prerender = false;
const sb = Astro.locals.supabase;
const token = Astro.params.token ?? '';
if (Astro.request.method === 'POST' && Astro.request.headers.get('origin') === Astro.url.origin) {
  await sb.rpc('sign_parent_consent', { p_token: token });
}
const { data: st } = await sb.rpc('parent_consent_state', { p_token: token });
const { data: rows } = st === 'ok' || st === 'used' ? await sb.rpc('parent_consent_context', { p_token: token }) : { data: null };
const { state, ctx } = parseParentState({ state: st, ...(rows?.[0] ?? {}) });
---
<Portal title="Parent consent" dataLine={state === 'used'}>
  <ParentConsent state={state} ctx={ctx} />
</Portal>
