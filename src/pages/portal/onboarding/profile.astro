---
import { devError } from '../../../lib/portal/dev-fixtures';
import Base from '../../../layouts/Base.astro';
import SlideDeck from '../../../components/portal/slides/SlideDeck.astro';
import Slide from '../../../components/portal/slides/Slide.astro';
import { getOnboarding, nextOnboardingPath, validateProfile } from '../../../lib/portal/onboarding';

export const prerender = false;
const sb = Astro.locals.supabase;
const stub = import.meta.env.DEV ? Astro.url.searchParams.get('stub') : null;
let error = devError(stub);
let v = { name: '', location: '' };
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const r = validateProfile(Object.fromEntries(f));
  v = { name: String(f.get('name') ?? ''), location: String(f.get('location') ?? '') };
  if (!r.ok) error = r.error;
  else {
    const { error: e } = await sb.rpc('save_onboarding_profile', { p_name: r.name, p_location: r.location, p_birthday: r.birthday });
    if (!e) return Astro.redirect(nextOnboardingPath(await getOnboarding(sb)) ?? '/portal', 303);
    error = 'We could not save that. Please try again.';
  }
} else {
  const s = await getOnboarding(sb);
  if (s && s.profileDone) return Astro.redirect(nextOnboardingPath(s) ?? '/portal', 303);
  v.name = s?.name ?? '';
}
const today = new Date().toISOString().slice(0, 10);
---
<Base title="Your details | Venn" description="A few details so your cohort knows who you are." bare noindex>
  <SlideDeck action={Astro.url.pathname + Astro.url.search} label="Your details" start={error ? 2 : 0}>
    <Slide title="First, what should we call you?" lead="Your full name, the way you would want it on a certificate.">
      <input name="name" autocomplete="name" enterkeyhint="next" maxlength="200" required value={v.name} aria-label="full name" placeholder="Full name" />
    </Slide>
    <Slide title="And where do you live?" lead="A city and country is plenty. It helps us place you in a cohort that fits your time zone.">
      <input name="location" autocomplete="address-level2" enterkeyhint="next" maxlength="200" required value={v.location} aria-label="place you live" placeholder="City, country" />
    </Slide>
    <Slide title="When were you born?" lead="We ask once so we know who needs a parent to sign alongside you. Nothing else uses it." cta="Save" error={error}>
      <input name="birthday" type="date" autocomplete="bday" required min="1900-01-01" max={today} aria-label="birthday" />
    </Slide>
  </SlideDeck>
</Base>
