---
import { devError } from '../../../lib/portal/dev-fixtures';
import Base from '../../../layouts/Base.astro';
import SlideDeck from '../../../components/portal/slides/SlideDeck.astro';
import Slide from '../../../components/portal/slides/Slide.astro';
import { CONTACT_CONSENT_TEXT, getOnboarding, nextOnboardingPath, validateContact } from '../../../lib/portal/onboarding';

export const prerender = false;
const sb = Astro.locals.supabase;
const stub = import.meta.env.DEV ? Astro.url.searchParams.get('stub') : null;
let error = devError(stub);
const s = await getOnboarding(sb);
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const r = validateContact(Object.fromEntries(f));
  if (!r.ok) error = r.error;
  else {
    const { error: e } = await sb.rpc('save_onboarding_contact', { p_org_ok: r.orgOk, p_org_correction: r.orgCorrection, p_phone: r.phone, p_whatsapp: r.whatsapp, p_consent: true });
    if (e) error = 'We could not save that. Please try again.';
    else return Astro.redirect(nextOnboardingPath(await getOnboarding(sb)) ?? '/portal', 303);
  }
} else if (s && s.required && !s.profileDone) return Astro.redirect('/portal/onboarding/profile', 303);
else if (s && s.contactDone) return Astro.redirect(nextOnboardingPath(s) ?? '/portal', 303);
const org = s?.org || 'your organization';
---
<Base title="Your organization and phone | Venn" description="Confirm your organization and the number your cohort can reach you on." bare noindex>
  <SlideDeck action={Astro.url.pathname + Astro.url.search} label="Your organization and phone" start={error ? 3 : 0}>
    <Slide title={`Are you here with ${org}?`} lead="We matched you to this organization from your application, so tell us if we got it wrong." cta="">
      <label class="choice"><input type="radio" name="orgOk" value="yes" data-auto /> Yes, that's me</label>
      <label class="choice"><input type="radio" name="orgOk" value="no" /> Not quite</label>
      <div data-if-no hidden>
        <input name="orgCorrection" maxlength="300" aria-label="your organization" placeholder="Which organization, then?" />
        <button type="button" class="btn" data-next>Continue</button>
      </div>
    </Slide>
    <Slide title="What number can we reach you on?" lead="Include the country code, like +14155550123, so a message from us lands in the right place.">
      <input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+14155550123" enterkeyhint="next" maxlength="30" required aria-label="phone number" />
    </Slide>
    <Slide title="Do you use WhatsApp on that number?" lead="It is where most of your cohort talks, so a yes means you will not miss anything." cta="">
      <label class="choice"><input type="radio" name="whatsapp" value="yes" data-auto /> Yes</label>
      <label class="choice"><input type="radio" name="whatsapp" value="no" data-auto /> No</label>
    </Slide>
    <Slide title="Is it okay if we message you?" lead={CONTACT_CONSENT_TEXT} cta="Yes, that's fine" error={error}>
      <input type="hidden" name="consent" value="on" />
    </Slide>
  </SlideDeck>
</Base>
<script>
  // Choosing an answer is the whole step, so it moves on by itself. "Not quite" waits for the correction.
  const deck = document.querySelector<HTMLElement>('[data-deck]')!;
  const hint = deck.querySelector<HTMLElement>('[data-if-no]')!;
  deck.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.type !== 'radio') return;
    if (t.name === 'orgOk') {
      const no = t.value === 'no';
      hint.hidden = !no;
      if (no) hint.querySelector('input')!.focus({ preventScroll: true });
    }
    if (t.hasAttribute('data-auto')) deck.dispatchEvent(new Event('deck:next'));
  });
</script>
<style is:global>
  .deck [data-if-no] { width: 100%; display: flex; flex-direction: column; gap: var(--sp-16); }
  .deck [data-if-no][hidden] { display: none; }
</style>
