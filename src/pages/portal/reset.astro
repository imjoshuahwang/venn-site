---
import Base from '../../layouts/Base.astro';
import SlideDeck from '../../components/portal/slides/SlideDeck.astro';
import Slide from '../../components/portal/slides/Slide.astro';
import AuthBits from '../../components/portal/AuthBits.astro';
import { TURNSTILE_TEST } from '../../lib/portal/turnstile-test-keys.ts';
import { rpcStore } from '../../lib/portal/ratelimit';
import { authGuard, guardStatus } from '../../scripts/portal/auth-errors';

export const prerender = false;
// Sprint 1 only sends a reset email to the test address (#130 lifts this with Turnstile + rate limits + resend).
const RESET_ALLOWED = ['contact+portal-t1@joinvenn.org'];
const expired = Astro.url.searchParams.get('expired') === '1';
let error = '';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? TURNSTILE_TEST.siteKey : '');
let notice = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const email = String(f.get('email') ?? '').trim().toLowerCase();
  error = (await authGuard('reset', Astro.request, { skipTurnstile: !!Astro.locals.demo, form: f, store: rpcStore(Astro.locals.supabase) })) ?? '';
  if (error) Astro.response.status = guardStatus(error);
  if (!error) {
    if (RESET_ALLOWED.includes(email)) {
      await Astro.locals.supabase.auth.resetPasswordForEmail(email, { redirectTo: `${Astro.url.origin}/portal/auth/callback?next=${encodeURIComponent('/portal/set-password')}` });
    }
    // Same answer whether or not the address has an account.
    notice = 'If that email has a Venn account, a link to reset your password is on its way. Check your inbox and spam.';
  }
}
---
<Base title="Reset password | Venn" description="Reset your Venn portal password." bare noindex>
  {notice ? (
    <SlideDeck label="Reset your password">
      <Slide title="Check your inbox." lead={notice} cta="">
        <a slot="more" href="/portal/login">Back to sign in</a>
      </Slide>
    </SlideDeck>
  ) : (
    <SlideDeck action={Astro.url.pathname + Astro.url.search} label="Reset your password">
      <Slide title={expired ? 'That link expired.' : 'Forgot your password?'} lead={expired ? 'They only work once. Pop your email in for a fresh one.' : 'No stress. What email did you sign up with?'} cta="Send link" error={error}>
        <input name="email" type="email" aria-label="email" autocomplete="email" inputmode="email" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="go" maxlength="320" placeholder="you@school.edu" required />
        {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-appearance="interaction-only"></div>}
        <a slot="more" href="/portal/login">Back to sign in</a>
      </Slide>
    </SlideDeck>
  )}
  <AuthBits />
  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Base>
