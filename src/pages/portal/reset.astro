---
import Base from '../../layouts/Base.astro';
import AuthForm from '../../components/portal/AuthForm.astro';
import { rpcStore } from '../../lib/portal/ratelimit';
import { authGuard, guardStatus } from '../../scripts/portal/auth-errors';

export const prerender = false;
// Sprint 1 only sends a reset email to the test address (#130 lifts this with Turnstile + rate limits + resend).
const RESET_ALLOWED = ['contact+portal-t1@joinvenn.org'];
const expired = Astro.url.searchParams.get('expired') === '1';
let error = '';
let notice = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const email = String(f.get('email') ?? '').trim().toLowerCase();
  error = (await authGuard('reset', Astro.request, { skipTurnstile: !!Astro.locals.demo, form: f, store: rpcStore(Astro.locals.supabase) })) ?? '';
  if (error) Astro.response.status = guardStatus(error);
  if (!error) {
    if (RESET_ALLOWED.includes(email)) {
      await Astro.locals.supabase.auth.resetPasswordForEmail(email, { redirectTo: `${Astro.url.origin}/portal/auth/callback?next=${encodeURIComponent('/portal/set-password')}` });
    }
    // Same answer whether or not the address has an account.
    notice = 'If that email has a Venn account, a link to reset your password is on its way. Check your inbox and spam.';
  }
}
---
<Base title="Reset password | Venn" description="Reset your Venn portal password." bare noindex>
  <AuthForm turnstile title={expired ? 'That link has expired' : 'Reset your password'}
    lede={expired ? 'Links work once and only for a short while. Enter your email and we will send a new one.' : 'Enter your email and we will send you a link.'}
    fields={notice ? [] : ['email']} submit="Send link" error={error} notice={notice}
    links={[{ href: '/portal/login', label: 'Back to sign in' }]} />
</Base>
