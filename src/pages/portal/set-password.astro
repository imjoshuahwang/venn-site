---
import Base from '../../layouts/Base.astro';
import AuthForm from '../../components/portal/AuthForm.astro';
import { authGuard, authMessage, changePassword, safeRedirect } from '../../scripts/portal/auth-errors';

export const prerender = false;
// Reached from the invite or recovery link via /portal/auth/callback, which has already opened a session.
if (!Astro.locals.user) return Astro.redirect('/portal/login', 302);
const next = safeRedirect(Astro.url.searchParams.get('next'));
let error = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  error = (await authGuard('set-password', Astro.request)) ?? '';
  if (!error) {
    const e = await changePassword(Astro.locals.supabase, String(f.get('password') ?? ''));
    // #117 (ceremony) will intercept the first /portal visit; until then the landing is plain /portal.
    if (!e) return Astro.redirect(safeRedirect(String(f.get('next') ?? next)), 303);
    error = authMessage(e);
  }
}
---
<Base title="Set your password | Venn" description="Choose a password for your Venn portal." bare noindex>
  <AuthForm title="Set your password" lede="You'll use it with your email to sign in." fields={['new-password']} submit="Save password" error={error} next={next === '/portal' ? '' : next} />
</Base>
