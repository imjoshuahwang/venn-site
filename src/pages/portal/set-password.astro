---
import { devError, STUB_EMAIL } from '../../lib/portal/dev-fixtures';
import Base from '../../layouts/Base.astro';
import SlideDeck from '../../components/portal/slides/SlideDeck.astro';
import Slide from '../../components/portal/slides/Slide.astro';
import AuthBits from '../../components/portal/AuthBits.astro';
import { TURNSTILE_TEST } from '../../lib/portal/turnstile-test-keys.ts';
import { getOnboarding, nextOnboardingPath } from '../../lib/portal/onboarding';
import { authGuard, authMessage, changePassword, safeRedirect } from '../../scripts/portal/auth-errors';
import { portalEvent } from '../../lib/portal/api.ts';

export const prerender = false;
// Reached from the invite or recovery link via /portal/auth/callback, which has already opened a session.
const stub = import.meta.env.DEV ? Astro.url.searchParams.get('stub') : null;
if (!Astro.locals.user && !stub) return Astro.redirect('/portal/login', 302);
const next = safeRedirect(Astro.url.searchParams.get('next'));
let error = devError(stub);
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? TURNSTILE_TEST.siteKey : '');
const email = stub ? STUB_EMAIL : Astro.locals.user?.email ?? '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  error = (await authGuard('set-password', Astro.request, { form: f, skipTurnstile: !!Astro.locals.demo })) ?? '';
  if (!error) {
    // The sign-out of other devices runs after the response (waitUntil when the host has it), so the redirect never waits on it.
    const defer = (p: Promise<unknown>) => { import('@vercel/functions').then((m) => m.waitUntil(p)).catch(() => {}); };
    const before = await getOnboarding(Astro.locals.supabase);
    const first = before !== null && !before.started; // an unreadable state keeps the sign-out of other devices
    const e = await changePassword(Astro.locals.supabase, String(f.get('password') ?? ''), defer, { first });
    if (!e) {
      await portalEvent(Astro.locals.supabase, 'password_set');
      await Astro.locals.supabase.rpc('start_onboarding');
      const onboarding = nextOnboardingPath(await getOnboarding(Astro.locals.supabase));
      return Astro.redirect(onboarding ?? safeRedirect(String(f.get('next') ?? next)), 303);
    }
    error = authMessage(e);
  }
}
---
<Base title="Set your password | Venn" description="Choose a password for your Venn portal." bare noindex>
  <SlideDeck action={Astro.url.pathname + Astro.url.search} label="Create your account" start={error ? 1 : 0}>
    {next !== '/portal' && <input type="hidden" name="next" value={next} />}
    <Slide title="Create your account." lead={email ? `You are joining as ${email}.` : 'You are almost in.'} cta="Let's go" />
    <Slide title="Pick a password." lead="At least 8 characters." cta="Create account" error={error}>
      <div class="pw">
        <input name="password" type="password" aria-label="password" autocomplete="new-password" enterkeyhint="go" minlength="8" maxlength="200" placeholder="Password" required />
        <button type="button" class="show" data-show aria-pressed="false">Show</button>
      </div>
      {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-appearance="interaction-only"></div>}
    </Slide>
  </SlideDeck>
  <AuthBits />
  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Base>
