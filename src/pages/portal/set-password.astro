---
import Portal from '../../layouts/Portal.astro';
import { sameOrigin, formFields, MIN_PASSWORD } from '../../lib/portal/form';
export const prerender = false;

// Reached from a reset link: the callback already turned the link into a session.
if (!Astro.locals.user) return Astro.redirect('/portal/login?m=link', 303);
let error = '';
if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro)) return new Response('Forbidden', { status: 403 });
  const f = await formFields(Astro);
  const pw = f.password ?? '';
  if (pw.length < MIN_PASSWORD) error = `Use at least ${MIN_PASSWORD} characters.`;
  else if (pw !== (f.confirm ?? '')) error = "Those two passwords don't match.";
  else {
    const { error: e } = await Astro.locals.supabase.auth.updateUser({ password: pw });
    if (!e) {
      await Astro.locals.supabase.auth.signOut({ scope: 'others' });
      return Astro.redirect('/portal', 303);
    }
    error = e.code === 'same_password' ? "Pick a password you haven't used here before."
      : e.code === 'weak_password' ? 'Pick a stronger password.' : "That didn't work. Ask for a new reset link.";
  }
}
---
<Portal title="New password" signedIn>
  <div class="card">
    <h1>Set a new password</h1>
    <p class="lede">Then you're straight back to your update.</p>
    <form method="post" class="stack" novalidate>
      {error && <p class="note err" role="alert">{error}</p>}
      <label class="field"><span class="field-l">New password, at least {MIN_PASSWORD} characters</span>
        <input name="password" type="password" autocomplete="new-password" minlength={MIN_PASSWORD} required />
      </label>
      <label class="field"><span class="field-l">New password again</span>
        <input name="confirm" type="password" autocomplete="new-password" minlength={MIN_PASSWORD} required />
      </label>
      <button class="btn btn-full" type="submit">Save password</button>
    </form>
  </div>
</Portal>
