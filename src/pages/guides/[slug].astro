---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  return (await getCollection('guides')).map((g) => ({ params: { slug: g.id }, props: { g } }));
}

const { g } = Astro.props;
const { headings } = await render(g);
// Split the rendered article on h2 so two Apply cards can sit ~1/3 and ~2/3 of the way through (build time, no JS).
const parts = (g.rendered?.html ?? '').split(/(?=<h2[\s>])/);
const n = parts.length - 1;
// Three Apply moments, each a different size so they never read as repeats: a quiet note (~1/3), a card with tiles (~2/3), a big panel at the end.
const noteAt = n >= 3 ? Math.round(n / 3) + 1 : -1;
const cardAt = n >= 3 ? Math.min(n, Math.round((2 * n) / 3) + 1) : -1;
// The note floats beside the section's first paragraph, so split that section after its first </p>.
const noteSplit = (html: string) => { const k = html.indexOf('</p>'); return k < 0 ? [html, ''] : [html.slice(0, k + 4), html.slice(k + 4)]; };
const kinds: [string, string, string][] = [
  ['Club', 'users', 'g'], ['Nonprofit', 'heart', 'b'], ['Project', 'bulb', 'w'], ['Startup', 'rocket', 'g'],
];
const icons: Record<string, string> = {
  users: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5M16 4.6a3.5 3.5 0 0 1 0 6.8M18.5 14.8c1.6.8 2.6 2.6 3 5.2"/>',
  heart: '<path d="M12 20s-7.5-4.4-9-9.2C2 7.4 4.4 4.5 7.5 4.5c2 0 3.5 1.1 4.5 2.6 1-1.5 2.5-2.6 4.5-2.6 3.1 0 5.5 2.9 4.5 6.3C19.5 15.6 12 20 12 20z"/>',
  bulb: '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"/>',
  rocket: '<path d="M5 15c-1.5 1.3-2 4-2 6 2 0 4.7-.5 6-2M9 12a22 22 0 0 1 11-9c0 4-1.5 8-9 11M9 12H5l2-4h5M12 15v4l4-2v-5"/>',
};
for (const k in icons) icons[k] = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${icons[k]}</svg>`;
const toc = headings.filter((h) => h.depth === 2);
const date = g.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const words = (g.body ?? '').split(/\s+/).length;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: g.data.title,
  description: g.data.description,
  datePublished: g.data.pubDate.toISOString(),
  author: { '@type': 'Person', name: 'Joshua Hwang' },
  publisher: { '@type': 'Organization', name: 'Venn', logo: { '@type': 'ImageObject', url: 'https://joinvenn.org/Venn_Square_Logo_Dark.png' } },
  mainEntityOfPage: new URL(`/guides/${g.id}/`, Astro.site).href,
};
---
<Base title={`${g.data.title} | Venn`} description={g.data.description} type="article" schema={schema}>
  <div class="narrow article-head">
    <a href="/guides/" class="label" style="text-decoration:none">← Guides</a>
    <h1>{g.data.title}</h1>
    <p class="intro">{g.data.description}</p>
    <div class="byline">
      <img src="/founder.jpg" alt="" width="40" height="40">
      <span>Written by <b>Joshua Hwang</b> · {date} · {Math.max(1, Math.round(words / 230))} min read</span>
    </div>
  </div>
  <div class="article-grid">
    <nav class="toc" aria-label="On this page">
      {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
    </nav>
    <article class="prose narrow">
      {parts.map((html, i) => (
        <>
          {i === cardAt && (
            <aside class="cta-card" aria-label="Apply to Venn">
              <div class="cta-tiles" aria-hidden="true">
                {kinds.map(([label, icon, c]) => (
                  <span class:list={['cta-tile', c]}><span class="cta-ico" set:html={icons[icon]} />{label}</span>
                ))}
              </div>
              <div class="cta-card-body">
                <p class="cta-card-h">Whatever you’re building, bring it.</p>
                <p class="cta-card-sub">Clubs, nonprofits, projects, startups. Venn connects you with people in your field.</p>
                <a class="btn btn-ghost btn-sm" href="/#apply">See how to apply</a>
              </div>
            </aside>
          )}
          {i === noteAt ? (
            <>
              <Fragment set:html={noteSplit(html)[0]} />
              <aside class="cta-note" aria-label="Apply to Venn">
                <span>Already building something? Venn is free for students.</span>
                <a href="/#apply">Apply to Venn <span aria-hidden="true">→</span></a>
              </aside>
              <Fragment set:html={noteSplit(html)[1]} />
            </>
          ) : <Fragment set:html={html} />}
        </>
      ))}
    </article>
  </div>
  <section class="cta-end" aria-label="Apply to Venn">
    <div class="cta-end-bg" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="cta-end-panel reveal">
      <h2>Apply to Venn.</h2>
      <p class="cta-end-sub">For high school and college students already building a club, nonprofit, project or startup. We connect you with college clubs, companies and students in your field.</p>
      <p class="cta-end-free">Free for students, always.</p>
      <a class="btn" href="/#apply">Apply for Fall ’26</a>
    </div>
  </section>
  <script>
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((a) => a.classList.toggle('active', a.hash === `#${e.target.id}`));
    }), { rootMargin: '0px 0px -70% 0px' });
    document.querySelectorAll('.prose h2[id]').forEach((h) => io.observe(h));
  </script>
</Base>

<style>
  .article-head { padding-top: 140px; padding-bottom: 8px; }
  .article-head h1 { font-size: clamp(2rem, 6vw, 3.25rem); font-weight: 600; letter-spacing: -.035em; line-height: 1.12; margin-top: 16px; }
  .article-head .intro { font-size: clamp(1.1rem, 2.2vw, 1.3rem); font-weight: 300; color: #555; margin-top: 20px; line-height: 1.6; }
  .byline { display: flex; align-items: center; gap: 12px; margin-top: 28px; padding-bottom: 28px; border-bottom: 1px solid var(--line); font-size: 14px; color: var(--muted); }
  .byline img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
  .byline b { color: var(--text); font-weight: 500; }
  /* The prose column is centered on the page (same 720px measure as the header); the TOC hangs in the left gutter. */
  .article-grid { padding-block: 48px 24px; }
  @media (min-width: 1200px) { .article-grid { display: grid; grid-template-columns: 1fr minmax(0, 720px) 1fr; } }
  .toc { display: none; }
  @media (min-width: 1200px) {
    .toc { display: block; grid-column: 1; justify-self: end; width: 200px; margin-right: 8px; position: sticky; top: 100px; align-self: start; font-size: 13px; }
    .prose { grid-column: 2; width: 100%; }
    .toc a { display: block; padding: 5px 0 5px 12px; border-left: 2px solid var(--line); color: var(--faint); text-decoration: none; line-height: 1.4; }
    .toc a:hover, .toc a.active { color: var(--black); border-color: var(--black); }
  }
  .prose { font-size: 17px; line-height: 1.8; color: var(--body); min-width: 0; }
  .prose > :global(* + *) { margin-top: 1.2em; }
  .prose :global(h2) { font-size: clamp(1.5rem, 4vw, 2rem); letter-spacing: -.02em; line-height: 1.3; margin-top: 2.4em; }
  .prose :global(h3) { font-size: 1.2rem; font-weight: 600; letter-spacing: -.01em; line-height: 1.4; margin-top: 1.8em; }
  .prose :global(a:not(.btn)) { color: var(--black); text-decoration-color: rgba(0, 0, 0, .25); text-underline-offset: 2px; }
  .prose :global(a:not(.btn):hover) { text-decoration-color: currentColor; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3em; }
  .prose :global(li + li) { margin-top: .4em; }
  .prose :global(strong) { color: var(--text); }
  .prose :global(blockquote) { margin-left: 0; padding-left: 20px; border-left: 2px solid var(--black); color: var(--text); }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 15px; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); }
  /* 1/3: quiet note. Slim glass strip in the column; on wide screens it floats out into the right gutter like a margin note. */
  .prose .cta-note {
    display: grid; grid-template-columns: 1fr; align-items: center; gap: 4px 12px; padding: 12px 18px; border-radius: 18px;
    font-size: 15px; line-height: 1.45; color: var(--text);
    background: linear-gradient(120deg, rgba(227, 236, 225, .75), rgba(234, 240, 249, .75));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .95), inset 0 0 0 1px rgba(255, 255, 255, .7), 0 12px 30px -18px rgba(30, 45, 35, .35);
  }
  .prose .cta-note > * { margin: 0; }
  .prose .cta-note a { justify-self: start; }
  .prose .cta-note a { font-weight: 600; text-decoration: none; white-space: nowrap; }
  .prose .cta-note a:hover { text-decoration: underline; }
  @media (min-width: 1200px) {
    .prose .cta-note { float: right; clear: right; width: 250px; margin: .4em -190px 1em 28px; grid-template-columns: 1fr; gap: 8px; padding: 18px 20px; border-radius: 22px; }
  }
  /* 2/3: medium card with Club/Nonprofit/Project/Startup tiles on the left, ghost button. */
  .prose .cta-card {
    clear: both; display: grid; gap: 20px; margin-block: 2.6em; padding: 20px; border-radius: 28px;
    background: linear-gradient(150deg, rgba(234, 240, 249, .6), rgba(255, 255, 255, .5) 55%, rgba(227, 236, 225, .6));
    -webkit-backdrop-filter: blur(28px) saturate(1.8); backdrop-filter: blur(28px) saturate(1.8);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .95), inset 0 0 0 1px rgba(255, 255, 255, .6), inset 0 -1px 0 rgba(255, 255, 255, .35), 0 30px 70px -40px rgba(30, 45, 35, .3), 0 0 0 1px rgba(0, 0, 0, .04);
  }
  .cta-tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .cta-tile { display: flex; flex-direction: column; justify-content: space-between; gap: 10px; aspect-ratio: 1; padding: 10px; border-radius: 16px; font-size: 12px; font-weight: 500; line-height: 1.2; color: var(--black); letter-spacing: -.01em; }
  .cta-tile.g { background: linear-gradient(160deg, #e3ece1, #c8d9c4); }
  .cta-tile.b { background: linear-gradient(160deg, #eaf0f9, #c9d8f0); }
  .cta-tile.w { background: linear-gradient(160deg, #f6f4f1, #e8e4de); }
  .cta-ico { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 9px; background: rgba(255, 255, 255, .7); }
  .cta-ico :global(svg) { width: 62%; height: 62%; }
  .prose .cta-card-h { font-size: 1.3rem; font-weight: 600; letter-spacing: -.025em; line-height: 1.25; color: var(--black); }
  .prose .cta-card-sub { font-size: 15px; line-height: 1.55; color: var(--muted); margin: 6px 0 16px; }
  .prose .cta-card .btn-ghost { box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .18); background: rgba(255, 255, 255, .5); }
  @media (min-width: 640px) {
    .prose .cta-card { grid-template-columns: 200px 1fr; align-items: center; gap: 28px; padding: 24px 32px 24px 24px; }
    .cta-tiles { grid-template-columns: repeat(2, 1fr); }
    .cta-tile:nth-child(2), .cta-tile:nth-child(4) { transform: translateY(12px); }
    .cta-tiles { padding-bottom: 12px; }
  }
  /* End: wide glass panel on drifting green/blue blobs. */
  .cta-end { position: relative; overflow: hidden; padding: 56px 16px 88px; margin-top: -24px; }
  .cta-end-bg { position: absolute; inset: 0; pointer-events: none; -webkit-mask-image: linear-gradient(transparent, #000 20%, #000 80%, transparent); mask-image: linear-gradient(transparent, #000 20%, #000 80%, transparent); }
  .cta-end-bg i { position: absolute; width: 60vmax; aspect-ratio: 1; animation: drift 22s ease-in-out infinite alternate; }
  .cta-end-bg i:nth-child(1) { background: radial-gradient(closest-side, rgba(159, 191, 154, .55), rgba(159, 191, 154, .28) 40%, rgba(159, 191, 154, .1) 70%, transparent); left: -18vmax; top: -10vmax; }
  .cta-end-bg i:nth-child(2) { background: radial-gradient(closest-side, rgba(196, 212, 239, .75), rgba(196, 212, 239, .38) 40%, rgba(196, 212, 239, .12) 70%, transparent); right: -20vmax; top: -4vmax; width: 65vmax; animation-duration: 27s; animation-delay: -9s; }
  .cta-end-bg i:nth-child(3) { background: radial-gradient(closest-side, rgba(159, 191, 154, .4), rgba(159, 191, 154, .2) 45%, rgba(159, 191, 154, .07) 72%, transparent); left: 25%; bottom: -30vmax; width: 52vmax; animation-duration: 31s; animation-delay: -16s; }
  @keyframes drift { to { transform: translate(6vw, -4vh) scale(1.1); } }
  .cta-end-panel {
    position: relative; max-width: 728px; margin: 0 auto; padding: 36px 22px; border-radius: 28px; text-align: center;
    background: rgba(255, 255, 255, .42); -webkit-backdrop-filter: blur(28px) saturate(1.8); backdrop-filter: blur(28px) saturate(1.8);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .95), inset 0 0 0 1px rgba(255, 255, 255, .6), inset 0 -1px 0 rgba(255, 255, 255, .35), 0 40px 90px -40px rgba(30, 45, 35, .3);
  }
  @media (min-width: 768px) { .cta-end-panel { padding: 60px 44px; } }
  /* Fades in like the homepage glass card: rises from a smaller, softer, rounder shape. */
  .cta-end-panel.reveal { transition: opacity 1.1s var(--ease), transform 1.1s var(--ease), filter 1.1s var(--ease), border-radius 1.1s var(--ease); }
  .cta-end-panel.reveal:not(.in) { transform: translateY(32px) scale(.86); border-radius: 64px; }
  .cta-end h2 { font-size: clamp(2.1rem, 6vw, 3.5rem); font-weight: 600; letter-spacing: -.045em; line-height: 1; }
  .cta-end-sub { max-width: 30em; margin: 16px auto 0; font-size: clamp(.95rem, 1.6vw, 1.05rem); line-height: 1.6; color: var(--body); }
  .cta-end-free { margin: 8px 0 22px; font-weight: 600; color: var(--black); }
  @media (prefers-reduced-motion: reduce) { .cta-end-bg i { animation: none; } }
</style>
