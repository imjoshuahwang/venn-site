---
import Base from '../layouts/Base.astro';

// One screen per step. Everything is rendered hidden; the script shows one at a time.
const posts = [
  {
    kind: 'linkedin',
    label: 'LinkedIn, 1 of 3',
    h: 'Post it on LinkedIn.',
    sub: 'This one matters most. The post is already written, you just fill in one blank.',
    open: 'Open LinkedIn',
    tip: 'Before you post: type @Venn and pick Venn from the list that pops up. It has to be picked from the list, not just typed, or we won't see it.',
    found: 'On your post, tap the ... menu, then Copy link to post.',
    placeholder: 'https://www.linkedin.com/posts/...',
    next: 'x',
  },
  {
    kind: 'x',
    label: 'X, 2 of 3',
    h: 'Now a short one on X.',
    sub: 'Same idea, fewer words.',
    open: 'Open X',
    tip: '',
    found: 'On your post, tap the share icon, then Copy link.',
    placeholder: 'https://x.com/you/status/...',
    next: 'friends',
  },
];
---
<Base title="Boost your application" description="Share your Venn application and bring a friend." noindex>
  <section class="boost">
    <div class="boost-bg" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="glass" id="card">

      <div class="progress" id="progress" hidden>
        <div class="progress-bar"><i id="bar"></i></div>
        <span class="progress-txt" id="progress-txt">1 of 4 done</span>
      </div>

      <div class="screen" data-screen="loading">
        <p class="muted">Finding your application...</p>
      </div>

      <div class="screen" data-screen="missing" hidden>
        <h1 class="h" tabindex="-1">We couldn't find that link.</h1>
        <p class="sub">The link from your confirmation email should open this page directly. If you haven't applied yet, that is the first step.</p>
        <div class="row"><a class="btn" href="/apply">Apply to Venn</a></div>
      </div>

      <div class="screen" data-screen="error" hidden>
        <h1 class="h" tabindex="-1">That didn't load.</h1>
        <p class="sub">Check your connection and try again.</p>
        <div class="row"><button class="btn" type="button" id="retry">Try again</button></div>
      </div>

      <div class="screen" data-screen="intro" hidden>
        <h1 class="h" tabindex="-1">Boost your application, <span data-name></span>.</h1>
        <p class="sub">Venn scores community, so applications with people behind them get a closer look. Three quick things, each takes a minute or less. Skip any of them.</p>
        <ul class="list">
          <li class="done"><span class="tick"></span>Applied</li>
          <li><span class="tick"></span>Post on LinkedIn</li>
          <li><span class="tick"></span>Post on X</li>
          <li><span class="tick"></span>Tell three friends</li>
        </ul>
        <div class="row"><button class="btn" type="button" data-go="linkedin">Start</button></div>
      </div>

      {posts.map((p) => (
        <div class="screen" data-screen={p.kind} hidden>
          <p class="label">{p.label}</p>
          <h2 class="h" tabindex="-1">{p.h}</h2>
          <p class="sub">{p.sub}</p>

          <div class="part" data-part="write">
            <label class="field">
              <span class="field-l">I am building</span>
              <input type="text" class="building" autocomplete="off" maxlength="80" placeholder="a robotics app for my school" />
            </label>
            <label class="field">
              <span class="field-l">Your post, edit it however you like</span>
              <textarea class="post" rows={p.kind === 'x' ? 6 : 10} data-kind={p.kind}></textarea>
            </label>
            <p class="tip" data-tip hidden={!p.tip}>{p.tip}</p>
            <div class="row">
              <button class="btn btn-ghost" type="button" data-copy-post={p.kind}>Copy post</button>
              <a class="btn" target="_blank" rel="noopener" data-open={p.kind} href="#">{p.open}</a>
            </div>
            <p class="hint">If the post box is empty when it opens, paste what you copied.</p>
          </div>

          <div class="part" data-part="paste" hidden>
            <label class="field">
              <span class="field-l">Paste your post link</span>
              <input type="url" inputmode="url" class="post-url" data-kind={p.kind} autocomplete="off" autocapitalize="off" spellcheck="false" placeholder={p.placeholder} />
              <span class="hint">{p.found}</span>
            </label>
            <p class="err" role="alert" data-err={p.kind}></p>
            <div class="row"><button class="btn" type="button" data-save={p.kind}>Save link</button></div>
          </div>

          <p class="saved" data-saved={p.kind} hidden>Got it. Thank you.</p>

          <div class="foot">
            <button class="link" type="button" data-show-paste={p.kind}>Already posted? Paste the link</button>
            <span class="foot-r">
              <button class="link" type="button" data-back>Back</button>
              <button class="link" type="button" data-go={p.next}>Skip for now</button>
            </span>
          </div>
        </div>
      ))}

      <div class="screen" data-screen="friends" hidden>
        <p class="label">Friends, 3 of 3</p>
        <h2 class="h" tabindex="-1">Who do you know who is building something?</h2>
        <p class="sub">Name up to three people. First names only, they stay on your device and are never sent anywhere. Naming them makes you far more likely to actually send it.</p>
        <div class="names">
          <input type="text" class="friend" autocomplete="off" maxlength="30" placeholder="First name" aria-label="Friend 1" />
          <input type="text" class="friend" autocomplete="off" maxlength="30" placeholder="First name" aria-label="Friend 2" />
          <input type="text" class="friend" autocomplete="off" maxlength="30" placeholder="First name" aria-label="Friend 3" />
        </div>
        <div class="row stack">
          <a class="btn" id="mail" href="#">Write the email</a>
          <button class="btn btn-ghost" type="button" id="share" hidden>Send in a text</button>
          <button class="btn btn-ghost" type="button" id="copylink">Copy link</button>
        </div>
        <p class="hint" id="friends-hint">The email opens in your mail app with your link already in it. Texts get answered faster than email, so the link works there too.</p>
        <div class="foot">
          <button class="link" type="button" data-back>Back</button>
          <button class="link" type="button" id="friends-next" data-go="done">Skip for now</button>
        </div>
      </div>

      <div class="screen" data-screen="done" hidden>
        <h2 class="h" tabindex="-1">You're set, <span data-name></span>.</h2>
        <ul class="list" id="final-list">
          <li data-item="applied" class="done"><span class="tick"></span>Applied</li>
          <li data-item="linkedin"><span class="tick"></span><span>Posted on LinkedIn</span><button class="link" type="button" data-go="linkedin">Add it</button></li>
          <li data-item="x"><span class="tick"></span><span>Posted on X</span><button class="link" type="button" data-go="x">Add it</button></li>
          <li data-item="email"><span class="tick"></span><span>Told friends</span><button class="link" type="button" data-go="friends">Add it</button></li>
        </ul>
        <p class="proof" id="proof" aria-live="polite"></p>
        <div class="linkbox">
          <span class="field-l">Your link, for anyone you think of later</span>
          <div class="linkrow">
            <code id="mylink"></code>
            <button class="btn btn-ghost btn-sm" type="button" id="copylink2">Copy</button>
          </div>
        </div>
        <div class="foot"><button class="link" type="button" data-back>Back</button></div>
      </div>

    </div>
  </section>
</Base>

<style>
  .boost { position: relative; overflow: hidden; padding: 112px 16px 72px; min-height: 100vh; }
  @media (min-width: 768px) { .boost { padding: 140px 16px 104px; } }
  .boost-bg {
    position: absolute; inset: 0; pointer-events: none;
    -webkit-mask-image: linear-gradient(transparent, #000 14%, #000 86%, transparent); mask-image: linear-gradient(transparent, #000 14%, #000 86%, transparent);
  }
  .boost-bg i { position: absolute; width: 70vmax; aspect-ratio: 1; animation: drift 22s ease-in-out infinite alternate; }
  .boost-bg i:nth-child(1) { background: radial-gradient(closest-side, rgba(159, 191, 154, .5), rgba(159, 191, 154, .28) 40%, rgba(159, 191, 154, .1) 70%, transparent); left: -30vmax; top: -18vmax; }
  .boost-bg i:nth-child(2) { background: radial-gradient(closest-side, rgba(196, 212, 239, .7), rgba(196, 212, 239, .38) 40%, rgba(196, 212, 239, .12) 70%, transparent); right: -32vmax; top: -6vmax; width: 75vmax; animation-duration: 27s; animation-delay: -9s; }
  .boost-bg i:nth-child(3) { background: radial-gradient(closest-side, rgba(159, 191, 154, .4), rgba(159, 191, 154, .2) 45%, rgba(159, 191, 154, .07) 72%, transparent); left: 10%; bottom: -34vmax; width: 62vmax; animation-duration: 31s; animation-delay: -16s; }
  @keyframes drift { to { transform: translate(7vw, -5vh) scale(1.12); } }
  .glass {
    position: relative; max-width: 560px; margin: 0 auto; padding: 24px 20px 20px; border-radius: 28px;
    background: rgba(255, 255, 255, .5); -webkit-backdrop-filter: blur(28px) saturate(1.8); backdrop-filter: blur(28px) saturate(1.8);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .95), inset 0 0 0 1px rgba(255, 255, 255, .6), inset 0 -1px 0 rgba(255, 255, 255, .35), 0 40px 90px -40px rgba(30, 45, 35, .3);
  }
  @media (min-width: 640px) { .glass { padding: 36px 40px 28px; } }

  .progress { display: flex; align-items: center; gap: 12px; margin-bottom: 28px; font-size: 13px; color: var(--muted); }
  .progress-bar { flex: 1; height: 4px; border-radius: 4px; background: rgba(0, 0, 0, .08); overflow: hidden; }
  .progress-bar i { display: block; height: 100%; background: var(--black); border-radius: inherit; transform-origin: left; transform: scaleX(.25); transition: transform .6s var(--ease); }
  .progress-txt { min-width: 5.5em; text-align: right; font-variant-numeric: tabular-nums; }

  .screen { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; align-content: start; }
  .screen.in { animation: s-in .45s var(--ease); }
  @keyframes s-in { from { opacity: 0; transform: translateY(14px); filter: blur(4px); } }
  .h { font-size: clamp(1.9rem, 7vw, 2.6rem); font-weight: 600; letter-spacing: -.04em; line-height: 1.05; }
  .h:focus { outline: none; }
  .sub { color: var(--body); font-size: 16px; }
  .label { margin-bottom: -6px; }

  .list { list-style: none; margin: 4px 0; padding: 0; display: grid; gap: 4px; }
  .list li { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid rgba(0, 0, 0, .06); color: var(--muted); font-size: 16px; }
  .list li:last-child { border-bottom: 0; }
  .list li.done { color: var(--black); }
  .list li > span:not(.tick) { flex: 1; }
  .tick { flex: none; width: 22px; height: 22px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px #c9c9cc; position: relative; }
  .done > .tick { background: var(--black); box-shadow: none; }
  .done > .tick::after { content: ''; position: absolute; left: 7px; top: 4px; width: 5px; height: 10px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .list li:not(.done) .link { margin-left: auto; }
  .list li.done .link { display: none; }

  .row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  .row .btn { flex: 1 1 auto; min-height: 52px; }
  .row.stack { flex-direction: column; }
  .btn[aria-disabled=true] { opacity: .3; pointer-events: none; }

  .field { display: grid; gap: 6px; }
  .field-l { font-size: 13px; color: var(--muted); }
  input[type=text], input[type=url], textarea {
    font: 17px/1.5 var(--font); color: var(--text); background: rgba(255, 255, 255, .85);
    border: 0; box-shadow: inset 0 0 0 1px #e0e0e0; border-radius: 14px; padding: 13px 16px; width: 100%;
  }
  textarea { resize: vertical; min-height: 120px; }
  input:focus, textarea:focus { outline: none; box-shadow: inset 0 0 0 2px #000; }
  input::placeholder { color: #a5a5a8; }
  .names { display: grid; gap: 10px; }
  .tip { font-size: 14px; line-height: 1.5; color: var(--text); background: rgba(255, 255, 255, .7); border-radius: 14px; padding: 12px 16px; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .05); }
  .hint { font-size: 13px; color: var(--muted); line-height: 1.5; }
  .err { font-size: 14px; color: #b91c1c; }
  .err:empty { display: none; }
  .saved { font-size: 15px; color: var(--black); font-weight: 500; }
  .part { display: grid; gap: 14px; }
  .part[data-part=paste] { padding-top: 16px; border-top: 1px solid rgba(0, 0, 0, .08); margin-top: 4px; }

  .foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 6px; }
  .foot-r { display: flex; gap: 20px; margin-left: auto; }
  .link { font: 15px/1 var(--font); color: var(--muted); background: none; border: 0; padding: 10px 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: #ccc; }
  .link:hover { color: var(--black); }

  .proof { font-size: 17px; color: var(--black); font-weight: 500; line-height: 1.4; }
  .linkbox { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; }
  .linkrow { display: flex; align-items: center; gap: 10px; background: rgba(255, 255, 255, .7); border-radius: 14px; padding: 8px 8px 8px 16px; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .06); }
  .linkrow .btn { flex: none; }
  .linkrow code { flex: 1; min-width: 0; font: 14px/1.4 var(--mono); color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .btn:focus-visible, .link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    .boost-bg i { animation: none; }
    .screen.in { animation: none; }
    .progress-bar i { transition: none; }
  }
</style>

<script>
  // Josh sets this once the X account exists. Empty = no tag in the post and no tag instruction.
  const X_HANDLE = '';

  const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
  const SB_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

  type Status = { first_name: string; ref_code: string; referrals: number; linkedin: boolean; x: boolean; email: boolean };

  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s);
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll<T>(s)];
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const rpc = async (fn: string, args: Record<string, unknown>) => {
    const r = await fetch(`${SB_URL}/rest/v1/rpc/${fn}`, {
      method: 'POST',
      headers: { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}`, 'Content-Type': 'application/json' },
      body: JSON.stringify(args),
    });
    const j = await r.json().catch(() => null);
    if (!r.ok) throw new Error(String(j?.message ?? 'request failed'));
    return j;
  };

  const code = (new URLSearchParams(location.search).get('code') ?? '').trim().toLowerCase().slice(0, 40);
  const store = {
    get: () => { try { return localStorage.getItem('venn-boost:' + code); } catch { return null; } },
    set: (v: string) => { try { localStorage.setItem('venn-boost:' + code, v); } catch { /* private mode */ } },
  };

  let st: Status | null = null;
  let link = '';
  let building = '';
  let current = 'loading';
  const order = ['intro', 'linkedin', 'x', 'friends', 'done'];

  const show = (name: string, remember = true) => {
    current = name;
    $$('[data-screen]').forEach((s) => { s.hidden = s.dataset.screen !== name; s.classList.remove('in'); });
    const scr = $(`[data-screen="${name}"]`)!;
    if (!calm) { void scr.offsetWidth; scr.classList.add('in'); }
    $('#progress')!.hidden = !st;
    if (st && remember && order.includes(name)) store.set(name);
    if (name === 'done') renderDone();
    scrollTo({ top: 0, behavior: calm ? 'auto' : 'smooth' });
    $<HTMLElement>('.h', scr)?.focus({ preventScroll: true });
  };

  const doneCount = () => (st ? 1 + +st.linkedin + +st.x + +st.email : 1);
  const renderProgress = () => {
    const n = doneCount();
    $<HTMLElement>('#bar')!.style.transform = `scaleX(${n / 4})`;
    $('#progress-txt')!.textContent = `${n} of 4 done`;
  };

  // ---- Post texts -------------------------------------------------------
  const blank = () => building.trim() || '___';
  const texts: Record<string, () => string> = {
    linkedin: () =>
      `I just applied to Venn's F26 season, a program for high schoolers building things.\n\nI am building ${blank()}.\n\nIf you're building something too, apply here: ${link}`,
    x: () =>
      `I just applied to Venn's F26 season for high schoolers building things. I am building ${blank()}.${X_HANDLE ? ` @${X_HANDLE}` : ''}\n\n${link}`,
  };
  const openHref = (kind: string, text: string) =>
    kind === 'linkedin'
      ? `https://www.linkedin.com/feed/?shareActive=true&text=${encodeURIComponent(text)}`
      : `https://x.com/intent/post?text=${encodeURIComponent(text)}`;

  const taFor = (kind: string) => $<HTMLTextAreaElement>(`textarea[data-kind="${kind}"]`)!;
  const refreshOpen = (kind: string) => {
    $<HTMLAnchorElement>(`[data-open="${kind}"]`)!.href = openHref(kind, taFor(kind).value);
  };
  const fillPosts = () => {
    (['linkedin', 'x'] as const).forEach((k) => {
      const ta = taFor(k);
      if (ta.dataset.edited !== '1') ta.value = texts[k]();
      refreshOpen(k);
    });
  };

  const copy = async (text: string) => {
    try { await navigator.clipboard.writeText(text); return true; } catch { /* fall through */ }
    const t = document.createElement('textarea');
    t.value = text; t.style.position = 'fixed'; t.style.opacity = '0';
    document.body.appendChild(t); t.select();
    let ok = false;
    try { ok = document.execCommand('copy'); } catch { /* nothing */ }
    t.remove();
    return ok;
  };
  const flash = (btn: HTMLElement, msg: string) => {
    const old = btn.dataset.label ?? btn.textContent ?? '';
    btn.dataset.label = old;
    btn.textContent = msg;
    setTimeout(() => { btn.textContent = old; }, 1800);
  };

  // ---- Saving -------------------------------------------------------------
  const merge = (s: Status | null) => { if (s) { st = s; renderProgress(); } };
  const mark = async (kind: string, url: string | null) => merge(await rpc('record_boost', { code, kind, url }));

  const normalize = (v: string) => {
    v = v.trim();
    return v && !/^https?:\/\//i.test(v) ? 'https://' + v : v;
  };
  const hostOk = (kind: string, url: string) => {
    try {
      const h = new URL(url).hostname.replace(/^www\./, '').toLowerCase();
      return kind === 'linkedin' ? ['linkedin.com', 'lnkd.in'].includes(h) : ['x.com', 'twitter.com'].includes(h);
    } catch { return false; }
  };
  const kindMsg: Record<string, string> = {
    linkedin: 'That doesn't look like a LinkedIn post link. It should start with linkedin.com or lnkd.in.',
    x: 'That needs to be a link to your post on x.com or twitter.com.',
  };

  const wirePost = (kind: 'linkedin' | 'x') => {
    const scr = $(`[data-screen="${kind}"]`)!;
    const ta = taFor(kind);
    const paste = $<HTMLElement>('[data-part="paste"]', scr)!;
    const showPaste = () => { paste.hidden = false; $<HTMLElement>('[data-show-paste]', scr)!.hidden = true; };
    ta.addEventListener('input', () => { ta.dataset.edited = '1'; refreshOpen(kind); });
    $(`[data-open="${kind}"]`)!.addEventListener('click', () => { refreshOpen(kind); setTimeout(showPaste, 400); });
    $<HTMLElement>(`[data-copy-post="${kind}"]`)!.addEventListener('click', async (e) => {
      const ok = await copy(ta.value);
      flash(e.currentTarget as HTMLElement, ok ? 'Copied' : 'Select and copy');
      showPaste();
    });
    $(`[data-show-paste="${kind}"]`)!.addEventListener('click', showPaste);
    const err = $(`[data-err="${kind}"]`)!;
    const input = $<HTMLInputElement>('.post-url', scr)!;
    input.addEventListener('input', () => { err.textContent = ''; });
    $<HTMLButtonElement>(`[data-save="${kind}"]`)!.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const url = normalize(input.value);
      if (!url || !hostOk(kind, url)) { err.textContent = kindMsg[kind]; input.focus(); return; }
      btn.disabled = true;
      try {
        await mark(kind, url);
        $(`[data-saved="${kind}"]`)!.hidden = false;
        setTimeout(() => show(kind === 'linkedin' ? 'x' : 'friends'), calm ? 0 : 900);
      } catch (ex) {
        err.textContent = /post link/.test((ex as Error).message) ? kindMsg[kind] : 'Could not save that. Try again in a moment.';
      } finally { btn.disabled = false; }
    });
  };

  // ---- Friends ------------------------------------------------------------
  const friendNames = () => $$<HTMLInputElement>('.friend').map((i) => i.value.trim()).filter(Boolean);
  const joinNames = (n: string[]) => (n.length < 2 ? n.join('') : n.slice(0, -1).join(', ') + ' and ' + n[n.length - 1]);
  const refreshMail = () => {
    const n = friendNames();
    const subject = n.length === 1 ? `${n[0]}, apply to Venn with me` : 'Apply to Venn with me';
    const body =
      `Hey${n.length ? ' ' + joinNames(n) : ''},\n\n` +
      `I just applied to Venn's F26 season, a free program for high schoolers building things. ` +
      `I thought of you because you're building something too.\n\n` +
      `It's a short form. Apply with my link:\n${link}\n\n${st?.first_name ?? ''}`;
    $<HTMLAnchorElement>('#mail')!.href = `mailto:?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  };
  const sharedOnce = () => {
    const nx = $('#friends-next')!;
    nx.textContent = 'Finish';
    nx.classList.add('btn');
    nx.classList.remove('link');
    nx.style.padding = '';
  };
  const recordEmail = () => {
    mark('email', null).catch(() => { /* the share itself worked; counting it can fail quietly */ });
    sharedOnce();
  };

  const wireFriends = () => {
    $$('.friend').forEach((i) => i.addEventListener('input', refreshMail));
    $('#mail')!.addEventListener('click', recordEmail);
    $('#copylink')!.addEventListener('click', async (e) => {
      const ok = await copy(link);
      flash(e.currentTarget as HTMLElement, ok ? 'Link copied' : 'Select and copy');
      recordEmail();
    });
    if (typeof navigator.share === 'function') {
      const b = $('#share')!;
      b.hidden = false;
      b.addEventListener('click', async () => {
        try {
          await navigator.share({ text: "I just applied to Venn's F26 season. If you're building something, apply with my link:", url: link });
          recordEmail();
        } catch { /* cancelled */ }
      });
    }
    refreshMail();
  };

  // ---- Final screen -------------------------------------------------------
  const renderDone = () => {
    if (!st) return;
    (['linkedin', 'x', 'email'] as const).forEach((k) => $(`[data-item="${k}"]`)!.classList.toggle('done', st![k]));
    const n = st.referrals;
    $('#proof')!.textContent =
      n > 0 ? `${n} ${n === 1 ? 'friend' : 'friends'} applied through your link.` : 'When a friend applies through your link, it shows up here.';
  };
  let lastFetch = 0;
  const refresh = async () => {
    if (!code || Date.now() - lastFetch < 4000) return;
    lastFetch = Date.now();
    try {
      const s = (await rpc('boost_status', { code })) as Status | null;
      if (s) { st = s; renderProgress(); if (current === 'done') renderDone(); }
    } catch { /* keep showing what we have */ }
  };

  // ---- Boot ---------------------------------------------------------------
  const boot = async () => {
    show('loading', false);
    if (!code) return show('missing', false);
    let s: Status | null;
    try { s = (await rpc('boost_status', { code })) as Status | null; } catch { return show('error', false); }
    if (!s) return show('missing', false);
    st = s;
    link = `https://joinvenn.org/apply?ref=${s.ref_code}`;
    $$('[data-name]').forEach((e) => { e.textContent = s!.first_name; });
    $('#mylink')!.textContent = link.replace('https://', '');
    renderProgress();
    fillPosts();
    refreshMail();
    (['linkedin', 'x'] as const).forEach((k) => { $(`[data-saved="${k}"]`)!.hidden = !s![k]; });
    if (X_HANDLE) {
      const tip = $('[data-screen="x"] [data-tip]')!;
      tip.textContent = `Keep @${X_HANDLE} in the post so we see it.`;
      tip.hidden = false;
    }
    const saved = store.get();
    show(saved && order.includes(saved) ? saved : 'intro', false);
  };

  $('#retry')!.addEventListener('click', boot);
  $$<HTMLInputElement>('.building').forEach((inp) => inp.addEventListener('input', () => {
    building = inp.value;
    $$<HTMLInputElement>('.building').forEach((o) => { if (o !== inp) o.value = building; });
    fillPosts();
  }));
  wirePost('linkedin');
  wirePost('x');
  wireFriends();
  $('#copylink2')!.addEventListener('click', async (e) => {
    flash(e.currentTarget as HTMLElement, (await copy(link)) ? 'Copied' : 'Select and copy');
  });
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-go]');
    if (t) show(t.dataset.go!);
    const b = (e.target as HTMLElement).closest('[data-back]');
    if (b) show(order[Math.max(0, order.indexOf(current) - 1)]);
  });
  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') refresh(); });
  addEventListener('focus', refresh);

  boot();
</script>
