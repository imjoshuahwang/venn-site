---
import Base from '../../layouts/Base.astro';
---
<Base title="Payment received · Venn" description="Thanks for running a program with Venn." noindex>
  <section class="t">
    <div class="narrow">
      <p class="label">Payment received</p>
      <h1>You’re in. We’ll be in touch within a day.</h1>
      <p class="muted">Your receipt and invoice are on their way by email. Next: a 20-minute kickoff call to write down your goal and match your orgs.</p>
      <a class="btn" href="/startups">Back to Venn</a>
    </div>
  </section>
</Base>

<style>
  .t { padding-top: 160px; text-align: center; min-height: 70vh; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 600; letter-spacing: -.035em; line-height: 1.1; margin: 12px 0 16px; }
  .btn { margin-top: 28px; }
</style>
