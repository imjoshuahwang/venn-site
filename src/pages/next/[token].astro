---
import { createClient } from '@supabase/supabase-js';
import Portal from '../../layouts/Portal.astro';
import { loadNext, submitNext, fixtureClient, COPY, type Page } from '../../lib/portal/next-cohort.ts';
import { memoryStore, rpcStore, clientIp } from '../../lib/portal/ratelimit.ts';
import { TURNSTILE_TEST } from '../../lib/portal/turnstile-test-keys.ts';

export const prerender = false;
const token = Astro.params.token ?? '';
const fixture = import.meta.env.DEV ? fixtureClient(token) : null;
const sb = fixture ?? createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.SUPABASE_SERVICE_ROLE_KEY ?? 'x', { auth: { persistSession: false } });
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? TURNSTILE_TEST.siteKey : '');
const secret = process.env.TURNSTILE_SECRET_KEY ?? '';
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex');
Astro.response.headers.set('Referrer-Policy', 'same-origin');

let page: Page;
try {
  if (Astro.request.method === 'POST') {
    if (Astro.request.headers.get('origin') !== Astro.url.origin) return new Response('Forbidden', { status: 403 });
    const form = await Astro.request.formData();
    page = await submitNext(token, { sb, ip: clientIp(Astro.request), store: fixture ? memoryStore() : rpcStore(sb), secret: siteKey && secret ? secret : undefined }, String(form.get('cf-turnstile-response') ?? ''));
  } else page = await loadNext(sb, token);
} catch (e) {
  console.error('next page failed:', (e as Error).message);
  return new Response('Something went wrong. Try again in a minute.', { status: 503, headers: { 'content-type': 'text/plain; charset=utf-8' } });
}
const widget = !!(siteKey && secret);
const name = 'firstName' in page && page.firstName ? `, ${page.firstName}` : '';
---
<Portal title="Venn">
  <section class="next">
    {page.kind === 'open' && (
      <form method="post">
        <h1>{COPY.open.h}{name}</h1>
        <p>{COPY.open.p}</p>
        {widget && <div class="cf-turnstile" data-sitekey={siteKey} data-appearance="interaction-only"></div>}
        <button class="pill" type="submit">{COPY.open.b}</button>
      </form>
    )}
    {page.kind === 'done' && (<><h1>{COPY.done.h}{name}</h1><p>{COPY.done.p}</p></>)}
    {(page.kind === 'expired' || page.kind === 'unknown') && (<><h1>{COPY[page.kind].h}</h1><p>{COPY[page.kind].p}</p></>)}
    {page.kind === 'refused' && (<><h1>{page.why === 'limited' ? 'Too many tries' : 'Check failed'}</h1><p><a href={Astro.url.pathname}>Back</a></p></>)}
  </section>
  {widget && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Portal>
<style>
  .next { display: grid; gap: var(--sp-16); padding-top: var(--sp-48); }
  h1 { margin: 0; font-size: var(--fs-28); font-weight: var(--fw-800); letter-spacing: var(--track-tight); line-height: 1.15; overflow-wrap: anywhere; }
  p { margin: 0; font-size: var(--fs-17); overflow-wrap: anywhere; }
  form { display: grid; gap: var(--sp-16); }
  .pill { width: 100%; border: 0; font-family: inherit; cursor: pointer; min-height: 56px; }
</style>
