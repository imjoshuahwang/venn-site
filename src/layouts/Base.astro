---
import { Image } from 'astro:assets';
import logo from '../assets/venn-logo.png';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>;
  bare?: boolean; // focused pages (/apply): no nav, footer or links out, and kept out of search
}

const { title, description, type = 'website', schema, bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  {bare && <meta name="robots" content="noindex">}
  <link rel="sitemap" href="/sitemap-index.xml">
  <meta property="og:type" content={type}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={new URL('/Venn_Horizontal_Logo_Light.png', Astro.site)}>
  <meta name="twitter:card" content="summary_large_image">
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body>
  {!bare && <header class="nav" id="nav">
    <div class="nav-inner">
      <a href="/" class="brand"><Image src={logo} alt="Venn" width={132} densities={[1, 2]} loading="eager" /></a>
      <nav>
        <a href="/guides/" class="btn btn-ghost btn-sm">Guides</a>
        <a href="/#seasons" class="btn btn-ghost btn-sm">Seasons</a>
        <a href="/#apply" class="btn btn-sm">Apply</a>
      </nav>
      <i class="nav-progress"></i>
    </div>
  </header>}

  <main><slot /></main>

  {!bare && <footer class="footer">
    <div class="wrap footer-grid">
      <div>
        <p class="muted">The student organization connector. Free, always.</p>
      </div>
      <div>
        <p class="footer-h">Venn</p>
        <a href="/#apply">Apply</a>
        <a href="/#faq">FAQ</a>
      </div>
      <div>
        <p class="footer-h">Guides</p>
        <a href="/guides/">All guides</a>
      </div>
      <div>
        <p class="footer-h">Contact</p>
        <a href="mailto:contact@joinvenn.org">contact@joinvenn.org</a>
        <a href="https://linkedin.com/in/joshua-jaekang-hwang" rel="noopener">LinkedIn</a>
      </div>
    </div>
    <p class="wrap muted small">© {new Date().getFullYear()} Venn</p>
    <Image class="footer-mark" src={logo} alt="" widths={[480, 860, 1021]} sizes="(min-width: 935px) 860px, 92vw" loading="lazy" />
  </footer>}

  <script>
    import { onScroll, calm } from '../scripts/scroll';

    // Scroll line in the nav chases the real position, so even a fast fling reads as a smooth glide.
    // The loop only runs while it is catching up.
    const nav = document.getElementById('nav');
    const bar = document.querySelector<HTMLElement>('.nav-progress');
    let shown = 0, target = 0, gliding = false;
    const glide = () => {
      shown += (target - shown) * 0.12;
      if (Math.abs(target - shown) < 0.0005) shown = target;
      bar?.style.setProperty('--p', shown.toFixed(4));
      gliding = shown !== target;
      if (gliding) requestAnimationFrame(glide);
    };
    onScroll(() => {
      nav?.classList.toggle('scrolled', scrollY > 24);
      if (calm) return;
      const max = document.documentElement.scrollHeight - innerHeight;
      target = max > 0 ? scrollY / max : 0;
      if (!gliding) { gliding = true; requestAnimationFrame(glide); }
    });

    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('in');
      io.unobserve(e.target);
    }), { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</body>
</html>
