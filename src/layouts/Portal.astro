---
import '../styles/portal.css';
import Icons from '../components/Icons.astro';
const { title = 'Portal' } = Astro.props;
const user = Astro.locals.user;
const email = user?.email ?? 'Account';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <Icons />
  </head>
  <body>
    <div class="blobs" aria-hidden="true"><i class="g"></i><i class="b"></i></div>
    {user && (
      <header class="topbar">
        <details class="account">
          <summary aria-label="Account menu"><span class="who">{email}</span></summary>
          <form method="post" action="/portal/logout"><button type="submit">Sign out</button></form>
        </details>
      </header>
    )}
    <main><slot /></main>
    <footer class="data-line">Want your data deleted? <a href="mailto:contact@joinvenn.org">Email contact@joinvenn.org</a></footer>
  </body>
</html>
<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; font-family: var(--font); font-size: var(--fs-17); line-height: 1.5; color: var(--ink); background: var(--white); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
  main { position: relative; max-width: 640px; margin: 0 auto; padding: var(--sp-24) var(--gutter) var(--sp-64); }
  .topbar { position: relative; max-width: 640px; margin: 0 auto; padding: env(safe-area-inset-top) max(var(--gutter), env(safe-area-inset-right)) 0 max(var(--gutter), env(safe-area-inset-left)); display: flex; justify-content: flex-end; }
  .account { position: relative; min-width: 0; max-width: 100%; }
  @media (max-width: 480px) { .account { width: 100%; } .topbar summary { width: 100%; } }
  .topbar .who { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .topbar summary { display: flex; align-items: center; min-height: 44px; min-width: 44px; max-width: 100%; padding: 0 var(--sp-16); margin-top: var(--sp-8); border-radius: var(--r-pill); background: rgba(255, 255, 255, 0.85); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12); font-size: var(--fs-15); font-weight: var(--fw-600); color: var(--ink); cursor: pointer; list-style: none; }
  .topbar summary::-webkit-details-marker { display: none; }
  .topbar form { position: absolute; right: 0; top: 100%; z-index: 1; background: var(--white); border-radius: var(--r-12); box-shadow: 0 4px 24px rgba(0, 0, 0, 0.12); }
  .topbar button { min-height: 44px; min-width: 44px; padding: 0 var(--sp-24); border: 0; background: none; font: inherit; font-size: var(--fs-15); color: var(--ink); cursor: pointer; white-space: nowrap; }
  .data-line { max-width: 640px; margin: 0 auto; padding: 0 max(var(--gutter), env(safe-area-inset-right)) calc(var(--sp-48) + env(safe-area-inset-bottom)) max(var(--gutter), env(safe-area-inset-left)); font-size: var(--fs-15); color: var(--muted); }
  .data-line a { display: inline-flex; align-items: center; min-height: 44px; padding: 0; color: inherit; text-underline-offset: 3px; }
  .blobs { position: fixed; inset: 0; z-index: -1; overflow: hidden; }
  .blobs i { position: absolute; width: 70vmax; height: 70vmax; border-radius: var(--r-pill); filter: blur(80px); opacity: 0.45; }
  .blobs .g { background: var(--green); top: -30vmax; left: -25vmax; }
  .blobs .b { background: var(--blue); bottom: -35vmax; right: -30vmax; }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--ink); outline-offset: var(--sp-4); }
  .pill { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; padding: var(--sp-12) var(--sp-24); border-radius: var(--r-pill); background: var(--ink); color: var(--white); font-size: var(--fs-15); font-weight: var(--fw-600); text-decoration: none; transition: opacity var(--dur-1) var(--ease); }
  button, input, select, textarea { font-family: inherit; }
  .pill.ghost { background: var(--white); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); }
  button.pill { border: 0; cursor: pointer; }
  .pill:hover { opacity: 0.85; }
  @media (prefers-reduced-motion: reduce) { .pill { transition: none; } }
</style>
