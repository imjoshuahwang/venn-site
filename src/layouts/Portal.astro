---
import { Image } from 'astro:assets';
import logo from '../assets/venn-logo.png';
import '../styles/global.css';

interface Props { title: string; signedIn?: boolean; wide?: boolean }
const { title, signedIn = false, wide = false } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <meta name="referrer" content="same-origin">
  <title>{title} · Venn</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
</head>
<body class="portal">
  <header class="p-top">
    <a href="/portal" class="brand"><Image src={logo} alt="Venn" width={110} densities={[1, 2]} loading="eager" /></a>
    {signedIn && <form method="post" action="/portal/logout"><button class="btn btn-ghost btn-sm" type="submit">Sign out</button></form>}
  </header>
  <main class:list={['p-main', { wide }]}><slot /></main>
  <footer class="p-foot muted small">Questions? <a href="mailto:contact@joinvenn.org">contact@joinvenn.org</a></footer>
</body>
</html>

<style is:global>
  body.portal { background: var(--panel); min-height: 100dvh; display: flex; flex-direction: column; }
  .p-top { display: flex; align-items: center; justify-content: space-between; padding: calc(12px + env(safe-area-inset-top)) 16px 12px; max-width: 640px; width: 100%; margin: 0 auto; }
  .p-top .brand img { height: 30px; width: auto; filter: saturate(.6); }
  .p-main { flex: 1; width: 100%; max-width: 480px; margin: 0 auto; padding: 8px 16px 40px; }
  .p-main.wide { max-width: 640px; }
  .p-foot { text-align: center; padding: 24px 16px calc(24px + env(safe-area-inset-bottom)); }
  .card { background: #fff; border-radius: 24px; padding: 28px 22px; box-shadow: 0 0 0 1px rgba(0,0,0,.05), 0 12px 32px -20px rgba(15,23,42,.18); }
  @media (min-width: 480px) { .card { padding: 36px 32px; } }
  .card + .card { margin-top: 16px; }
  .card h1 { font-size: 28px; letter-spacing: -.02em; line-height: 1.15; margin-bottom: 8px; }
  .card h2 { font-size: 20px; letter-spacing: -.01em; margin-bottom: 6px; }
  .stack { display: flex; flex-direction: column; gap: 14px; margin-top: 20px; }
  .field { display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 500; color: var(--black); }
  .field input { font: 400 16px/1.4 var(--font); padding: 14px 16px; border-radius: 14px; border: 1px solid #ddd; background: #fff; color: var(--text); min-height: 48px; }
  .field input:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
  .hint { font-size: 13px; color: var(--muted); font-weight: 400; }
  .note { font-size: 14px; padding: 12px 14px; border-radius: 14px; background: #f1f5fb; color: #2b3f63; }
  .note.err { background: #fdf0f0; color: #8a2b2b; }
  .note.ok { background: #eef7f0; color: #25573a; }
  .btn-full { width: 100%; min-height: 52px; }
  .or { display: flex; align-items: center; gap: 12px; color: var(--faint); font-size: 13px; margin: 4px 0; }
  .or::before, .or::after { content: ''; flex: 1; height: 1px; background: var(--line); }
  .links { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 18px; font-size: 14px; }
  .links a { color: var(--muted); min-height: 44px; display: inline-flex; align-items: center; }
  .p-foot a { color: var(--muted); }
</style>
