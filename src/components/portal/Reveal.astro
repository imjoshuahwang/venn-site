---
import { splitLetter } from '../../lib/portal/ceremony.mjs';
const { outcome, letter } = Astro.props;
const { headline, body } = splitLetter(letter);
const label = { cohort: "Cohort", peer: "Peer match", network_waitlist: "Waitlist", track_waitlist: "Waitlist", not_this_season: "Not this season" }[outcome as string];
---
<section class="reveal" data-reveal data-outcome={outcome} hidden>
  <div class="glow" data-glow></div>
  <div class="card letter" data-card>
    <div class="seal-cover" data-seal aria-hidden="true"><p class="eyebrow">Fall '26</p><p class="headline">Your Fall '26 Result</p></div>
    <p class="eyebrow">{label}</p>
    <h1 class="headline" aria-label={headline} data-headline>
      {[...headline].map((ch) => <span aria-hidden="true" class="ch">{ch}</span>)}
    </h1>
    <div class="body" data-body>
      {body.map((p) => <p>{p}</p>)}
    </div>
    <div class="actions" data-actions>
      <button class="pill ghost" type="button" data-share>Share</button>
      <button class="pill" type="button" data-next>Go to my portal</button>
    </div>
    <p class="muted" role="status" data-note></p>
  </div>
</section>
