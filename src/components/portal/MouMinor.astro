---
// Under-18 MOU (#224) as slides: terms, student signature, parent here or by emailed link, confirm.
// The terms text is the consent pages (DRAFT pending the lawyer, src/data/consent.ts). Slides are linear indexes; the
// parent choice jumps over the branch it does not use with deck:goto, and Back retraces what the student actually saw.
import { CONSENT_PAGES } from '../../data/consent';
import SlideDeck from './slides/SlideDeck.astro';
import Slide from './slides/Slide.astro';
interface Props { state: { minor_signed: boolean; parent_signed: boolean; parent_link_signed: boolean; parent_name: string | null }; email: string }
const { state } = Astro.props;
const start = !state.minor_signed ? 0 : (state.parent_signed || state.parent_link_signed) ? 6 : 2;
---
<SlideDeck label="Your MOU" start={start}>
  <Slide title="Here is what you are agreeing to." lead="Because you are under 18, a parent or guardian signs next to you. Read it through first, and ask us anything that is unclear." cta="I've read it">
    <div class="terms" tabindex="0" role="region" aria-label="Terms">
      {CONSENT_PAGES.map((p) => (<><h2>{p.title}</h2>{p.body.map((t) => <p>{t}</p>)}</>))}
    </div>
  </Slide>
  <Slide title="Sign your name." lead="Use your finger or your mouse, the way you would on paper." cta="Save my signature">
    <div class="pad"><canvas data-pad="minor" aria-label="Your signature"></canvas></div>
    <button slot="more" type="button" class="link" data-clear>Start over</button>
  </Slide>
  <Slide title="Now a parent or guardian." lead="Is one of them with you right now? If so, pass them the screen. If not, we will email them a link they can sign from their own phone." cta="">
    <button type="button" class="btn" data-jump="3">They are here with me</button>
    <button type="button" class="btn btn-ghost" data-jump="5">Email them a link</button>
  </Slide>
  <Slide title="What is their full name?" lead="Exactly as they would sign it.">
    <input name="parent_name" autocomplete="off" maxlength="120" value={state.parent_name ?? ''} aria-label="parent or guardian full name" placeholder="Full name" />
  </Slide>
  <Slide title="Parent or guardian, please sign." lead="By signing, you confirm you are this student's parent or legal guardian and you agree to the terms they just read." cta="Save signature">
    <div class="pad"><canvas data-pad="parent" aria-label="Parent or guardian signature"></canvas></div>
    <button slot="more" type="button" class="link" data-clear>Start over</button>
  </Slide>
  <Slide title="Where should we send it?" lead="Their email, not yours. The link works on any phone and takes about a minute." cta="Send the link">
    <input name="parent_email" type="email" autocomplete="off" inputmode="email" autocapitalize="off" enterkeyhint="go" aria-label="parent or guardian email" placeholder="parent@email.com" />
  </Slide>
  <Slide title="That is everything." cta="Confirm my MOU">
    <p class="lead via" data-via="here">Your signature and your parent or guardian's are saved. Confirm and you are in.</p>
    <p class="lead via" data-via="link" hidden>The link is on its way. When they have signed it, come back here and confirm.</p>
  </Slide>
</SlideDeck>
<script>
  const deck = document.querySelector<HTMLElement>('[data-deck]')!;
  const slides = [...deck.querySelectorAll<HTMLElement>('[data-slide]')];
  const go = (i: number) => deck.dispatchEvent(new CustomEvent('deck:goto', { detail: i }));
  const post = async (b: object) => {
    const r = await fetch('/portal/mou/minor/api', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(b) }).catch(() => null);
    return { ok: !!r?.ok, error: r ? (await r.json().catch(() => ({}))).error as string | undefined : 'No connection. Try again.' };
  };
  const errOf = (i: number) => slides[i].querySelector<HTMLElement>('[data-err]')!;
  const fail = (i: number, msg?: string) => { errOf(i).textContent = msg ?? 'That did not save. Try again.'; };
  const busy = (i: number, on: boolean) => { const b = slides[i].querySelector<HTMLButtonElement>('[data-next]'); if (b) b.disabled = on; };
  // Canvas: DPR-sized, pointer events, remembers whether a real stroke (not a dot) was drawn.
  const pads = new Map<HTMLCanvasElement, { drawn: number }>();
  deck.querySelectorAll<HTMLCanvasElement>('canvas').forEach((c) => {
    const ctx = c.getContext('2d')!; const st = { drawn: 0 }; pads.set(c, st);
    let last: [number, number] | null = null;
    const pt = (e: PointerEvent): [number, number] => { const r = c.getBoundingClientRect(); return [e.clientX - r.left, e.clientY - r.top]; };
    c.addEventListener('pointerdown', (e) => { c.setPointerCapture(e.pointerId); last = pt(e); });
    c.addEventListener('pointermove', (e) => {
      if (!last) return; const p = pt(e);
      ctx.beginPath(); ctx.moveTo(...last); ctx.lineTo(...p); ctx.stroke();
      st.drawn += Math.hypot(p[0] - last[0], p[1] - last[1]); last = p;
    });
    const end = () => { last = null; };
    c.addEventListener('pointerup', end); c.addEventListener('pointercancel', end);
  });
  function size() {
    pads.forEach((st, c) => {
      if (!c.offsetWidth || c.dataset.sized) return;
      const d = window.devicePixelRatio || 1; c.dataset.sized = '1';
      c.width = c.offsetWidth * d; c.height = c.offsetHeight * d;
      const ctx = c.getContext('2d')!; ctx.scale(d, d); ctx.lineWidth = 2.5; ctx.lineCap = 'round'; ctx.strokeStyle = '#111';
    });
  }
  deck.addEventListener('deck:change', size);
  size();
  deck.querySelectorAll<HTMLElement>('[data-clear]').forEach((b) => b.addEventListener('click', () => {
    const c = b.closest('[data-slide]')!.querySelector('canvas')!;
    c.getContext('2d')!.clearRect(0, 0, c.width, c.height); pads.get(c)!.drawn = 0;
  }));
  deck.querySelectorAll<HTMLElement>('[data-jump]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.jump))));

  const sign = async (i: number, role: 'minor' | 'parent', name?: string) => {
    const c = slides[i].querySelector('canvas')!;
    if (pads.get(c)!.drawn < 40) return fail(i, 'Please sign in the box.');
    busy(i, true);
    const r = await post({ action: 'sign', role, png: c.toDataURL('image/png').split(',')[1], parentName: name });
    busy(i, false);
    if (!r.ok) return fail(i, r.error);
    errOf(i).textContent = '';
    go(role === 'minor' ? 2 : 6);
  };
  // Slides that save something take over the advance; everything else moves on by itself.
  deck.addEventListener('deck:before', async (e) => {
    const i = (e as CustomEvent<{ index: number }>).detail.index;
    if (i < 1 || i === 3) {
      if (i === 3 && deck.querySelector<HTMLInputElement>('[name=parent_name]')!.value.trim().length < 2) { e.preventDefault(); fail(3, 'Type the parent or guardian\'s full name.'); }
      return;
    }
    e.preventDefault();
    if (i === 1) await sign(1, 'minor');
    else if (i === 4) await sign(4, 'parent', deck.querySelector<HTMLInputElement>('[name=parent_name]')!.value.trim());
    else if (i === 5) {
      busy(5, true);
      const r = await post({ action: 'send', parentEmail: deck.querySelector<HTMLInputElement>('[name=parent_email]')!.value });
      busy(5, false);
      if (!r.ok) return fail(5, r.error);
      deck.querySelector<HTMLElement>('[data-via=here]')!.hidden = true;
      deck.querySelector<HTMLElement>('[data-via=link]')!.hidden = false;
      go(6);
    } else if (i === 6) {
      busy(6, true);
      const r = await post({ action: 'confirm' });
      if (r.ok) { location.assign('/portal'); return; }
      busy(6, false); fail(6, r.error);
    }
  });
</script>
<style is:global>
  .deck h2 { font-size: var(--fs-17); margin: var(--sp-16) 0 var(--sp-4); }
  .deck h2:first-child { margin-top: 0; }
  .deck .terms { max-height: 42vh; overflow-y: auto; padding: var(--sp-16); border-radius: var(--r-20); background: var(--panel); font-size: var(--fs-15); line-height: 1.55; color: var(--body); overflow-wrap: anywhere; }
  .deck .terms p { margin: 0 0 var(--sp-8); }
  .deck .pad { width: 100%; border-radius: var(--r-20); background: var(--white); box-shadow: inset 0 0 0 1px var(--line); }
  .deck canvas { display: block; width: 100%; height: 200px; touch-action: none; }
  .deck .via[hidden] { display: none; }
  .deck .body > .btn { width: 100%; }
</style>
