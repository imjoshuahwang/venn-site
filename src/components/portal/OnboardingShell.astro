---
// One question per screen: panels slide in, the bar fills, a server-posted form underneath (all panels show without JS).
interface Props { done: number; total: number; start?: number }
const { done, total, start = 0 } = Astro.props;
---
<div class="ob" data-ob data-done={done} data-total={total} data-start={start}>
  <div class="ob-top">
    <div class="ob-bar" role="progressbar" aria-valuemin="0" aria-valuemax={total} aria-valuenow={done}><i style={`width:${Math.round((done / total) * 100)}%`}></i></div>
    <p class="ob-count" data-count>Step {done + 1} of {total}</p>
  </div>
  <form method="post" class="ob-form" novalidate data-form><slot /></form>
</div>
<script>
  const root = document.querySelector<HTMLElement>('[data-ob]');
  const form = root?.querySelector<HTMLFormElement>('[data-form]');
  if (root && form) {
    const panels = [...form.querySelectorAll<HTMLElement>('[data-panel]')];
    const done = Number(root.dataset.done), total = Number(root.dataset.total);
    const fill = root.querySelector<HTMLElement>('.ob-bar i')!, count = root.querySelector<HTMLElement>('[data-count]')!, bar = root.querySelector<HTMLElement>('.ob-bar')!;
    let i = Math.min(Number(root.dataset.start) || 0, panels.length - 1);
    root.classList.add('js');
    const sync = () => { // the org correction is only required when the answer is No
      const no = form.querySelector<HTMLInputElement>('input[name=orgOk][value=no]')?.checked;
      form.querySelectorAll<HTMLElement>('[data-if-no]').forEach((el) => { el.hidden = !no; el.querySelector('input')?.toggleAttribute('required', !!no); });
    };
    const show = (n: number, dir: 'fwd' | 'back' | 'none', focus = true) => {
      i = n;
      panels.forEach((p, k) => { p.hidden = k !== n; p.dataset.dir = k === n ? dir : ''; });
      const at = done + n + 1;
      fill.style.width = `${Math.round((at / total) * 100)}%`; bar.setAttribute('aria-valuenow', String(at)); count.textContent = `Step ${at} of ${total}`;
      sync();
      if (focus) panels[n].querySelector<HTMLElement>('input:not([type=radio]):not([type=hidden]):not([type=checkbox])')?.focus({ preventScroll: true });
    };
    const problem = (p: HTMLElement): string => {
      for (const el of p.querySelectorAll<HTMLInputElement>('input[required]')) {
        if (el.type === 'radio') { if (!p.querySelector(`input[name="${el.name}"]:checked`)) return el.dataset.msg || 'Choose an option.'; }
        else if (el.type === 'checkbox') { if (!el.checked) return el.dataset.msg || 'Tick the box to agree.'; }
        else if (!el.value.trim()) return el.dataset.msg || 'This is required.';
        else if (el.dataset.phone != null && !/^\+[1-9][0-9]{6,14}$/.test(el.value.replace(/[\s().-]/g, ''))) return el.dataset.msg || 'Check this number.';
        else if (el.type === 'date' && el.max && el.value > el.max) return 'Enter a valid birthday.';
      }
      return '';
    };
    const check = () => {
      const p = panels[i]; const msg = problem(p); const err = p.querySelector<HTMLElement>('[data-err]');
      if (err) { err.textContent = msg; err.hidden = !msg; }
      return !msg;
    };
    const next = () => { if (check() && i < panels.length - 1) show(i + 1, 'fwd'); };
    form.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-next]')) { e.preventDefault(); next(); }
      else if (t.closest('[data-back]')) { e.preventDefault(); if (i > 0) show(i - 1, 'back'); }
    });
    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement; sync();
      if (t.type === 'radio' && t.hasAttribute('data-auto')) next();
    });
    form.addEventListener('keydown', (e) => {
      const t = e.target as HTMLInputElement;
      if (e.key === 'Enter' && t.tagName === 'INPUT' && t.type !== 'checkbox' && i < panels.length - 1) { e.preventDefault(); next(); }
    });
    form.addEventListener('submit', (e) => {
      if (!check()) { e.preventDefault(); return; }
      const b = form.querySelector<HTMLButtonElement>('button[type=submit]');
      if (b) { b.dataset.label = b.textContent ?? ''; b.textContent = 'Saving...'; b.setAttribute('aria-busy', 'true'); setTimeout(() => (b.disabled = true), 0); }
    });
    // A failed save re-renders the page; back/forward restores from cache, so put the button back either way.
    addEventListener('pageshow', () => {
      const b = form.querySelector<HTMLButtonElement>('button[type=submit]');
      if (b?.dataset.label) { b.disabled = false; b.removeAttribute('aria-busy'); b.textContent = b.dataset.label; }
    });
    show(i, 'none', false);
  }
</script>
<style is:global>
  .ob { max-width: 26rem; margin: 0 auto; padding: calc(24px + env(safe-area-inset-top)) 0 32px; display: grid; gap: 28px; }
  .ob-top { display: grid; gap: 8px; }
  .ob-bar { height: 6px; border-radius: var(--r-pill); background: var(--line); overflow: hidden; }
  .ob-bar i { display: block; height: 100%; border-radius: inherit; background: var(--ink); transition: width var(--dur-3) var(--ease); }
  .ob-count { margin: 0; font-size: var(--fs-13); color: var(--muted); }
  .ob-form { display: grid; }
  .ob-panel { display: grid; gap: var(--sp-16); }
  .ob-panel[hidden], .ob [data-if-no][hidden] { display: none; }
  .ob.js .ob-panel[data-dir=fwd] { animation: ob-in-fwd var(--dur-2) var(--ease); }
  .ob.js .ob-panel[data-dir=back] { animation: ob-in-back var(--dur-2) var(--ease); }
  @keyframes ob-in-fwd { from { opacity: 0; transform: translateX(28px); } to { opacity: 1; transform: none; } }
  @keyframes ob-in-back { from { opacity: 0; transform: translateX(-28px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .ob .ob-panel, .ob-bar i { animation: none !important; transition: none !important; } }
  .ob h1 { margin: 0; font-size: clamp(1.75rem, 7vw, 2.25rem); letter-spacing: -0.035em; line-height: 1.1; font-weight: var(--fw-800); }
  .ob .lede { margin: -4px 0 0; color: var(--muted); font-size: var(--fs-17); overflow-wrap: anywhere; }
  .ob input:not([type=hidden]):not([type=radio]):not([type=checkbox]) { font: inherit; font-size: var(--fs-17); color: var(--ink); background: var(--white); min-height: 52px; width: 100%; -webkit-appearance: none; appearance: none; border: 0; box-shadow: inset 0 0 0 1px #e5e5e5; border-radius: 14px; padding: 14px 16px; }
  .ob input:focus-visible { outline: none; box-shadow: inset 0 0 0 2px #000; }
  .ob-err { margin: 0; padding: 12px 14px; border-radius: 14px; background: #fef2f2; color: var(--err); font-size: 16px; overflow-wrap: anywhere; }
  .ob-err[hidden] { display: none; }
  .ob-choice { display: flex; align-items: center; gap: 12px; min-height: 56px; padding: 0 16px; border-radius: 14px; background: var(--white); box-shadow: inset 0 0 0 1px #e5e5e5; cursor: pointer; font-size: var(--fs-17); }
  .ob-choice:has(input:checked) { box-shadow: inset 0 0 0 2px #000; }
  .ob-choice input { width: 20px; height: 20px; margin: 0; accent-color: #000; flex: none; }
  .ob-consent { display: flex; align-items: flex-start; gap: 12px; padding: 16px; border-radius: 14px; background: var(--panel); font-size: var(--fs-15); line-height: 1.5; cursor: pointer; }
  .ob-consent input { width: 22px; height: 22px; margin: 1px 0 0; accent-color: #000; flex: none; }
  .ob-nav { display: flex; gap: var(--sp-12); }
  .ob-nav .pill { flex: 1; border: 0; font-family: inherit; cursor: pointer; min-height: 52px; }
  .ob-nav .pill.ghost { flex: 0 0 auto; background: var(--white); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); }
  .ob-nav .pill:disabled { opacity: 0.6; cursor: default; }
</style>
