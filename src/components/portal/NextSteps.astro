---
import type { NextStepsConfig } from '../../data/next-steps';
import { mailtoUrl } from '../../lib/portal/gmail';
import SlideDeck from './slides/SlideDeck.astro';
import Slide from './slides/Slide.astro';
import './results/outcome.css';
interface Props { config: NextStepsConfig }
const { config } = Astro.props;
const draft = config.prompts.map((p) => `${p}\n\n`).join('');
---
<SlideDeck label="Next steps">
  <Slide title={config.steps[0]} cta="Next" data-step="1">
    {config.logo && <img src={config.logo} alt="" class="ns-logo" />}
    <ul class="list">{config.legal.map((l) => <li>{l}</li>)}</ul>
  </Slide>
  <Slide title={config.steps[1]} cta="" data-step="2">
    <div data-ns data-subject={config.subject}>
      <label class="ns-label" for="ns-body">Message to your mentor</label>
      <textarea id="ns-body" rows="10">{draft}</textarea>
    </div>
    <div class="actions">
      <button type="button" class="btn" data-send data-next>Send</button>
      <a class="ns-alt" data-mailto href={mailtoUrl({ subject: config.subject, body: draft })}>No Gmail? Open your mail app instead</a>
    </div>
    <div class="actions" data-sent hidden>
      <p class="ns-alt">Did your email go through?</p>
      <button type="button" class="btn btn-ghost" data-sent-btn data-next>I sent it</button>
    </div>
  </Slide>
  <Slide title={config.done.title} lead={config.done.lead} cta="" data-done>
    <ol class="list">{config.done.next.map((n) => <li>{n}</li>)}</ol>
    <ol class="ns-ticks">{config.steps.map((st) => <li data-tick>{st}</li>)}</ol>
    <div class="actions"><a class="btn" href="/portal">Back to your home</a></div>
  </Slide>
</SlideDeck>
<script>
  import { gmailComposeUrl, mailtoUrl } from '../../lib/portal/gmail';
  const root = document.querySelector<HTMLElement>('[data-ns]')!;
  const body = () => (root.querySelector('#ns-body') as HTMLTextAreaElement).value;
  const sent = document.querySelector<HTMLElement>('[data-sent]')!;
  const mailto = document.querySelector<HTMLAnchorElement>('[data-mailto]')!;
  mailto.addEventListener('click', () => { mailto.href = mailtoUrl({ subject: root.dataset.subject!, body: body() }); sent.hidden = false; });
  document.querySelector('[data-send]')!.addEventListener('click', () => {
    window.open(gmailComposeUrl({ subject: root.dataset.subject!, body: body() }), '_blank', 'noopener');
  });
</script>
<style>
  .ns-logo { height: 32px; width: auto; justify-self: start; }
  .ns-label { display: block; margin-bottom: var(--sp-8); font-size: var(--fs-13); color: var(--muted); }
  .ns-alt { margin: 0; font-size: var(--fs-15); color: var(--muted); display: inline-flex; align-items: center; min-height: 44px; }
  .ns-ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-8); font-size: var(--fs-15); color: var(--muted); }
  .ns-ticks li::before { content: '\2713'; margin-right: var(--sp-8); font-weight: var(--fw-600); color: var(--ink); }
</style>
