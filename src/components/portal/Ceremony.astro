---
// The sealed reveal (#321) on SlideDeck: seal -> weighted pause -> open -> full-screen celebration -> "Am I in?" answered on the first slide.
// Cohort results then get one `data-letter-slot` slide per cohort (#322 fills the slot; the current letter text sits there for now).
// Peer hands off to /portal/result after the celebration (#323 owns that page). Props: result, replay (setup is accepted and ignored).
import SlideDeck from './slides/SlideDeck.astro';
import Slide from './slides/Slide.astro';
import { splitLetter } from '../../lib/portal/ceremony.mjs';
const { result, replay = false } = Astro.props;
const { headline, body } = splitLetter(result.letter);
const isCohort = result.outcome === 'cohort';
const cohorts: { slug: string; name: string }[] = isCohort ? (result.cohorts?.length ? result.cohorts : [{ slug: 'cohort', name: result.cohortName ?? 'Your cohort' }]) : [];
const lead = isCohort ? cohorts.map((c) => c.name).join(' and ') : result.outcome === 'peer' ? 'Your peer match is ready.' : body[0] ?? '';
const rest = isCohort || result.outcome === 'peer' ? [] : body.slice(1);
const answerCta = isCohort ? 'Continue' : result.outcome === 'peer' ? 'See my match' : 'Go to my portal';
const config = JSON.stringify({ id: result.id, outcome: result.outcome, viewedAt: result.viewedAt, doneAt: result.doneAt, replay, accents: cohorts.map((c) => c.slug) });
---
<div data-ceremony data-config={config} data-outcome={result.outcome}>
  <SlideDeck label="Your result">
    <Slide title="Your Fall '26 Result" cta="Open" />
    <Slide title={headline} lead={lead} cta={answerCta}>
      {rest.map((p) => <p>{p}</p>)}
    </Slide>
    {cohorts.map((c, i) => (
      <Slide title={c.name} cta={i === cohorts.length - 1 ? 'Go to my portal' : 'Continue'}>
        <div data-letter-slot data-cohort={c.slug}>{body.map((p) => <p>{p}</p>)}</div>
      </Slide>
    ))}
  </SlideDeck>
  <canvas class="celebrate" data-celebrate aria-hidden="true"></canvas>
</div>
<style is:global>
  .celebrate { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 40; pointer-events: none; }
  [data-ceremony] .deck .slide:first-of-type .inner { transition: opacity var(--dur-slide) var(--ease), transform var(--dur-slide) var(--ease); }
  [data-ceremony] .deck[data-opening] .slide[data-pos="current"] .inner { opacity: .35; transform: scale(.94); }
  [data-ceremony] [data-letter-slot] p { margin: 0 0 var(--sp-12); font-size: var(--fs-17); }
</style>
<script>
  import { createCeremony } from '../../lib/portal/ceremony.mjs';
  import { celebrationPlan, runCelebration } from '../../lib/portal/celebrate';
  import { reducedMotion } from '../../lib/portal/motion';

  const root = document.querySelector<HTMLElement>('[data-ceremony]')!;
  const cfg = JSON.parse(root.dataset.config!) as { id: number; outcome: string; viewedAt: string | null; doneAt: string | null; replay: boolean; accents: string[] };
  const deck = root.querySelector<HTMLElement>('[data-deck]')!;
  const canvas = root.querySelector<HTMLCanvasElement>('[data-celebrate]')!;
  const reduced = reducedMotion();
  const ACCENT: Record<string, string> = { aws: '#ff9900', quadron: '#2f6bff' };
  const post = async (action: string) => {
    if (cfg.replay) return;
    const r = await fetch('/portal/api/ceremony', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action, id: cfg.id }) });
    if (!r.ok) throw new Error(action);
  };
  const c = createCeremony({ result: { id: cfg.id, outcome: cfg.outcome, viewedAt: cfg.viewedAt, doneAt: cfg.doneAt }, setup: { consent: true, parent: true, phone: true }, reduced, api: { markViewed: () => post('viewed'), finishCeremony: () => post('finish') } });

  // Weighted pause: the seal dims and shrinks for 700ms before the deck opens. A tap or Enter on the seal goes through here.
  let opened = false, opening = false, replaying = false;
  const advance = () => { replaying = true; deck.querySelector<HTMLElement>('[data-slide] [data-next]')!.click(); replaying = false; };
  const open = async () => {
    if (opening) return;
    if (!opened) {
      opening = true;
      c.reveal();
      deck.dataset.opening = '';
      await new Promise((r) => setTimeout(r, reduced ? 150 : 700));
      delete deck.dataset.opening;
      opened = true; opening = false;
    }
    advance();
  };
  const onSeal = (e: Event) => {
    if (replaying || deck.dataset.index !== '0') return;
    if (e instanceof KeyboardEvent && !['Enter', ' ', 'ArrowDown', 'ArrowRight'].includes(e.key)) return;
    if (e instanceof MouseEvent && !(e.target as HTMLElement).closest('[data-next]')) return;
    e.preventDefault(); e.stopPropagation();
    void open();
  };
  document.addEventListener('keydown', onSeal, true);
  deck.addEventListener('click', onSeal, true);

  let celebrated = false;
  deck.addEventListener('deck:change', (e) => {
    const { index } = (e as CustomEvent).detail;
    if (index !== 1 || celebrated || !['cohort', 'peer'].includes(cfg.outcome)) return;
    celebrated = true;
    canvas.dataset.state = reduced ? 'skipped' : 'running';
    const stop = runCelebration(canvas, celebrationPlan({ reduced, accent: ACCENT[cfg.accents[0]], width: innerWidth }));
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); }, { once: true });
    setTimeout(() => { canvas.dataset.state = 'done'; }, reduced ? 400 : 3600);
  });

  let finishing = false;
  deck.addEventListener('deck:finish', async () => {
    if (finishing) return;
    finishing = true;
    const err = deck.querySelector<HTMLElement>('[data-slide][data-pos="current"] [data-err]');
    await c.finish();
    if (c.state.finishPending && !(await c.retryFinish())) {
      finishing = false;
      if (err) err.textContent = 'We could not save that. Please try once more.';
      return;
    }
    location.assign(cfg.outcome === 'peer' ? '/portal/result' : '/portal');
  });
  root.dataset.ready = '';
</script>
