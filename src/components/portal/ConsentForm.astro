---
// Consent v3 as slides, one idea per screen. DRAFT pending Josh's lawyer: see src/data/consent.ts. Do not send to real students until signed off.
import { CONSENT_CLAUSES, CONSENT_DRAFT, CONSENT_PAGES, CONSENT_VERSION } from '../../data/consent';
import SlideDeck from './slides/SlideDeck.astro';
import Slide from './slides/Slide.astro';
interface Props { answers?: Record<string, boolean>; minor?: boolean }
const { answers = {}, minor = false } = Astro.props;
const clause = Object.fromEntries(CONSENT_CLAUSES.map((c) => [c.key, c]));
const checked = (name: string) => (name in answers ? answers[name] : clause[name].default);
---
<SlideDeck label="Consent">
  <div data-consent data-version={CONSENT_VERSION} data-minor={minor ? '1' : '0'} data-draft={CONSENT_DRAFT ? '1' : '0'} hidden></div>
  {CONSENT_PAGES.map((p) => (
    <Slide title={p.title} lead={p.summary} cta="Got it">
      {(p.choices ?? []).map((n) => (
        <label class="choice tall">
          <input type="checkbox" name={n} checked={checked(n)} />
          <strong>{clause[n].label}</strong>
          <span>{clause[n].text}</span>
        </label>
      ))}
      <details class="full">
        <summary>Read the full text</summary>
        <div class="text">{p.body.map((t) => <p>{t}</p>)}</div>
      </details>
    </Slide>
  ))}
  <Slide title="Does all of that sound fair?" lead="Saying yes means you have read it, or at least the plain version, and you agree to how Venn will run your season and look after what you tell us. You can come back and change your choices whenever you like." cta="Yes, I understand" />
</SlideDeck>
<script>
  const deck = document.querySelector<HTMLElement>('[data-deck]')!;
  const meta = deck.querySelector<HTMLElement>('[data-consent]')!;
  const boxes = [...deck.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];
  const last = deck.querySelectorAll('[data-slide]').length - 1;
  deck.addEventListener('deck:before', async (e) => {
    if (Number(deck.dataset.index) !== last) return;
    e.preventDefault();
    const btn = deck.querySelectorAll<HTMLButtonElement>('[data-next]')[last];
    const err = deck.querySelectorAll<HTMLElement>('[data-err]')[last];
    btn.disabled = true; err.textContent = '';
    // The single yes answers the three required clauses; the optional ones are the choices on the data page.
    const clauses = { coordinator_groups: true, data_use: true, retention: true, ...Object.fromEntries(boxes.map((b) => [b.name, b.checked])) };
    const res = await fetch('/portal/consent', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ version: meta.dataset.version, clauses }) }).catch(() => null);
    if (res && res.ok) { location.assign(meta.dataset.minor === '1' ? '/portal/cosign' : '/portal'); return; }
    btn.disabled = false;
    err.textContent = 'That did not save. Check your connection and try again.';
  });
</script>
