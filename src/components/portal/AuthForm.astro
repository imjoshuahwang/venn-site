---
// Shared shell for the portal auth pages: a plain server-posted form (works without JS), a status line for errors and notices,
// and a loading state on submit. `fields` picks the inputs; `next` rides along as a hidden field.
import { TURNSTILE_TEST } from '../../lib/portal/turnstile-test-keys.ts';
interface Props {
  title: string;
  lede?: string;
  fields: ('email' | 'current-password' | 'new-password' | 'readonly-email')[];
  submit: string;
  error?: string;
  notice?: string;
  next?: string;
  email?: string;
  links?: { href: string; label: string }[];
  turnstile?: boolean;
  lead?: { text: string; href: string; label: string };
}
const { title, lede, fields, submit, error = '', notice = '', next = '', email = '', links = [], turnstile = false, lead } = Astro.props;
// Cloudflare test key in dev only; in production with no key there is no widget and the server refuses sign-in.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? TURNSTILE_TEST.siteKey : '');
---
<section class="auth">
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  {lead && <p class="lead">{lead.text} <a href={lead.href}>{lead.label}</a></p>}
  <p class:list={['status', { err: !!error }]} role={error ? 'alert' : 'status'} hidden={!error && !notice}>{error || notice}</p>
  {fields.length > 0 && (
    <form method="post" class="auth-form" novalidate>
      {next && <input type="hidden" name="next" value={next}>}
      {fields.includes('readonly-email') && (
        <label>Email<input name="email_display" type="email" autocomplete="username" value={email} readonly tabindex="-1"></label>
      )}
      {fields.includes('email') && (
        <label>Email<input name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="next" required maxlength="320" value={email}></label>
      )}
      {fields.includes('current-password') && (
        <label>Password<input name="password" type="password" autocomplete="current-password" enterkeyhint="go" required maxlength="200"></label>
      )}
      {fields.includes('new-password') && (
        <label>New password<span class="pw"><input name="password" type="password" autocomplete="new-password" enterkeyhint="go" required minlength="8" maxlength="200"><button type="button" class="show" data-show aria-pressed="false">Show</button></span></label>
      )}
      {turnstile && siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-appearance="interaction-only"></div>}
      <button class="btn" type="submit" data-working="Working...">{submit}</button>
    </form>
  )}
  {links.length > 0 && <nav class="auth-links">{links.map((l) => <a href={l.href}>{l.label}</a>)}</nav>}
</section>
{turnstile && siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  // The last email typed here stays on this device only (never in a URL or server page), so an expired-link page can prefill it.
  const KEY = 'venn_last_email';
  const emailInput = document.querySelector<HTMLInputElement>('.auth-form input[name=email]');
  try { const saved = localStorage.getItem(KEY); if (emailInput && !emailInput.value && saved) emailInput.value = saved; } catch { /* storage blocked */ }
  document.querySelectorAll<HTMLButtonElement>('[data-show]').forEach((b) => {
    b.addEventListener('click', () => {
      const i = b.parentElement?.querySelector('input');
      if (!i) return;
      const on = i.type === 'password';
      i.type = on ? 'text' : 'password';
      b.textContent = on ? 'Hide' : 'Show';
      b.setAttribute('aria-pressed', String(on));
    });
  });
  document.querySelectorAll<HTMLFormElement>('.auth-form').forEach((f) => {
    f.addEventListener('submit', () => {
      try { const v = f.querySelector<HTMLInputElement>('input[name=email]')?.value.trim(); if (v) localStorage.setItem(KEY, v); } catch { /* storage blocked */ }
      const b = f.querySelector<HTMLButtonElement>('button[type=submit]');
      if (b && f.checkValidity()) { b.textContent = b.dataset.working || 'Working...'; b.setAttribute('aria-busy', 'true'); setTimeout(() => (b.disabled = true), 0); }
    });
  });
</script>
<style>
  .auth { max-width: 26rem; margin: 0 auto; padding: calc(56px + env(safe-area-inset-top)) 16px 48px; display: grid; gap: 16px; }
  h1 { font-size: clamp(1.75rem, 7vw, 2.25rem); letter-spacing: -.035em; line-height: 1.1; }
  .lede { color: var(--muted); font-size: 17px; line-height: 1.5; margin: -4px 0 0; }
  .lead { margin: -8px 0; font-size: 17px; line-height: 1.5; }
  .lead a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 4px; font-weight: 600; text-underline-offset: 3px; }
  .status { font-size: 16px; line-height: 1.45; padding: 12px 14px; border-radius: 14px; background: var(--panel); color: var(--text); margin: 0; overflow-wrap: anywhere; }
  .status[hidden] { display: none; }
  .status.err { background: #fef2f2; color: #b91c1c; }
  .auth-form { display: grid; gap: 16px; }
  label { display: grid; gap: 6px; font-size: 15px; font-weight: 500; color: var(--black); }
  input:not([type=hidden]) {
    font: 17px/1.5 var(--font); color: var(--text); background: #fff; min-height: 52px; -webkit-appearance: none; appearance: none;
    border: 0; box-shadow: inset 0 0 0 1px #e5e5e5; border-radius: 14px; padding: 14px 16px; width: 100%;
  }
  input:focus { outline: none; box-shadow: inset 0 0 0 2px #000; }
  .pw { position: relative; display: block; }
  .pw input { padding-right: 76px; }
  .show { position: absolute; right: 0; top: 0; min-width: 64px; min-height: 52px; background: none; border: 0; font: 600 15px var(--font); color: var(--muted); cursor: pointer; }
  input[readonly] { color: var(--muted); background: var(--panel); }
  .btn { min-height: 52px; width: 100%; }
  .btn:disabled { opacity: .6; cursor: default; }
  .auth-links { display: grid; }
  .auth-links a { display: flex; align-items: center; min-height: 44px; color: var(--muted); font-size: 16px; text-underline-offset: 3px; }
  .auth-links a:hover { color: var(--black); }
</style>
