---
import { PEER_COPY } from '../../../data/portal-peer';
import ResultState from './ResultState.astro';
const { view, endpoint = '/portal/peer-down' } = Astro.props as { view: any; endpoint?: string };
const empty = !view || !view.card.firstName;
---
{empty ? <ResultState state="empty" /> : (
  <article class="peer" data-peer data-match={view.matchId} data-endpoint={endpoint} data-stage={view.stage}>
    <h1>{PEER_COPY.heading}</h1>
    <p class="lede">{PEER_COPY.notIn}</p>
    <section class="card">
      <h2>{view.card.firstName}</h2>
      <p class="project">{view.card.project}</p>
      <p class="place">{view.card.place}</p>
      {view.card.why && <p class="whyLabel">{PEER_COPY.whyLabel}</p>}
      <p class="why">{view.card.why}</p>
    </section>
    <p class="lede">{PEER_COPY.relay}</p>
    <div class="slot">
      <button class="pill" type="button" data-down hidden={view.stage !== 'none'}>{PEER_COPY.pill}</button>
      <p class="status" data-waiting hidden={view.stage !== 'waiting'}>{PEER_COPY.waiting}</p>
      <p class="status" role="alert" data-retry hidden>{PEER_COPY.retry}</p>
      <div class="both" data-both hidden={view.stage !== 'both'}>
        <p class="status">{PEER_COPY.both}</p>
      </div>
    </div>
  </article>
)}
<script>
  const root = document.querySelector<HTMLElement>('[data-peer]');
  if (root) {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const btn = q<HTMLButtonElement>('[data-down]');
    let inflight = false;
    const show = (stage: 'none' | 'waiting' | 'both') => {
      root.dataset.stage = stage;
      btn.hidden = stage !== 'none';
      q('[data-waiting]').hidden = stage !== 'waiting';
      q('[data-both]').hidden = stage !== 'both';
    };
    btn.addEventListener('click', () => {
      if (inflight) return;
      inflight = true;
      q('[data-retry]').hidden = true;
      show('waiting');
      fetch(root.dataset.endpoint!, { method: 'POST', body: `{"matchId":${Number(root.dataset.match)}}` })
        .then(async (r) => {
          if (!r.ok) throw new Error(String(r.status)); // 401 and 5xx share the retry state
          const { contact } = await r.json();
          if (contact?.email || contact?.name) show('both'); // the contact is never rendered; Josh starts the group
        })
        .catch(() => { show('none'); q('[data-retry]').hidden = false; })
        .finally(() => { inflight = false; });
    });
  }
</script>
<style>
  .peer { display: grid; gap: var(--sp-24); justify-items: start; animation: rise var(--dur-3) var(--ease) both; }
  h1 { margin: 0; font-size: var(--fs-28); font-weight: var(--fw-800); letter-spacing: var(--track-tight); line-height: 1.15; }
  h2 { margin: 0; font-size: var(--fs-22); font-weight: var(--fw-800); }
  .card { width: 100%; display: grid; gap: var(--sp-8); padding: var(--sp-24); border: 1px solid var(--line); border-radius: var(--r-20); background: var(--panel); }
  .card p { margin: 0; }
  .project { font-size: var(--fs-17); }
  .place { font-size: var(--fs-15); color: var(--muted); }
  .lede { margin: 0; font-size: var(--fs-17); color: var(--body); }
  .whyLabel { margin-top: var(--sp-8); font-size: var(--fs-13); font-weight: var(--fw-600); color: var(--muted); }
  .why { font-size: var(--fs-15); color: var(--body); }
  .slot { display: grid; gap: var(--sp-12); justify-items: start; width: 100%; }
  .slot [hidden] { display: none; }
  .status { margin: 0; font-size: var(--fs-17); font-weight: var(--fw-600); animation: rise var(--dur-2) var(--ease) both; }
  button.pill { border: 0; cursor: pointer; font-family: inherit; min-height: 44px; }
  @keyframes rise { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .peer, .status { animation: none; } }
</style>
