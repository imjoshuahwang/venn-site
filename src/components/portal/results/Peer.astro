---
import '../results/outcome.css';
import { PEER_COPY } from '../../../data/portal-peer';
import SlideDeck from '../slides/SlideDeck.astro';
import Slide from '../slides/Slide.astro';
import ResultState from './ResultState.astro';
const { view, endpoint = '/portal/peer-down' } = Astro.props as { view: any; endpoint?: string };
const views = ([] as any[]).concat(view ?? []).filter((v) => v?.card?.firstName); // one partner, or two in a triad
---
{views.length === 0 ? <ResultState state="empty" /> : (
  <SlideDeck label="Your result">
    <Slide title="Not this cohort, but not alone." lead={views.length > 1 ? PEER_COPY.notInTwo : PEER_COPY.notIn} cta="Meet them" />
    {views.map((v, i) => (
      <Slide title={`You got matched with ${v.card.firstName}.`} lead="I think you would be awesome together. Want to meet?" cta="" data-peer-slide>
        <div class="person" data-peer data-match={v.matchId} data-endpoint={endpoint} data-stage={v.stage} data-i={i}>
          <h2>{v.card.firstName}</h2>
          <p>{[v.card.project, v.card.place].filter(Boolean).join(', ')}</p>
          {v.card.why && <p class="why">{v.card.why}</p>}
        </div>
        <div class="actions">
          <button class="btn" type="button" data-next data-accept data-for={i}>Accept</button>
          <button class="btn btn-ghost" type="button" data-next data-decline data-for={i}>Decline</button>
        </div>
      </Slide>
    ))}
    <Slide title="Here is where you stand." cta="">
      {views.map((v, i) => (
        <div class="person" data-result data-for={i} data-stage={v.stage}>
          <h2>{v.card.firstName}</h2>
          <p data-waiting hidden={v.stage !== 'waiting'}>{PEER_COPY.waiting}</p>
          <p data-declined hidden>You passed on this one, and that is completely fine. We will not mention it to them.</p>
          <p data-retry role="alert" hidden>{PEER_COPY.retry}</p>
          <div data-both hidden={v.stage !== 'both'}>
            <p class="why">You both said yes. Your intro is unlocked.</p>
            <p data-contact></p>
          </div>
        </div>
      ))}
      <div class="actions">
        <a class="btn" href="/portal/next-steps">See what to do next</a>
        <a class="btn btn-ghost" href="/portal">Back to your home</a>
      </div>
    </Slide>
  </SlideDeck>
)}
<script>
  const show = (box: HTMLElement, stage: 'waiting' | 'declined' | 'both' | 'none') => {
    box.dataset.stage = stage;
    (['waiting', 'declined', 'both'] as const).forEach((k) => { box.querySelector<HTMLElement>(`[data-${k}]`)!.hidden = stage !== k; });
  };
  document.querySelectorAll<HTMLElement>('[data-peer]').forEach((root) => {
    const i = root.dataset.i!;
    const box = document.querySelector<HTMLElement>(`[data-result][data-for="${i}"]`)!;
    const slide = root.closest('[data-slide]')!;
    if (box.dataset.stage === 'both') show(box, 'both');
    slide.querySelector('[data-decline]')!.addEventListener('click', () => show(box, 'declined'));
    slide.querySelector('[data-accept]')!.addEventListener('click', () => {
      if (box.dataset.stage === 'both') return;
      box.querySelector<HTMLElement>('[data-retry]')!.hidden = true;
      show(box, 'waiting');
      fetch(root.dataset.endpoint!, { method: 'POST', body: `{"matchId":${Number(root.dataset.match)}}` })
        .then(async (r) => {
          if (!r.ok) throw new Error(String(r.status)); // 401 and 5xx share the retry state
          const { contact } = await r.json();
          if (contact?.email || contact?.name) {
            box.querySelector('[data-contact]')!.textContent = [contact.name, contact.email].filter(Boolean).join(', ');
            show(box, 'both');
          }
        })
        .catch(() => { show(box, 'none'); box.querySelector<HTMLElement>('[data-retry]')!.hidden = false; });
    });
  });
</script>
