---
import { statLine, STOOD_OUT } from '../../../data/reveal-facts';
import { popupTitle, type RevealPartner } from '../../../data/reveal-partners';
// #226: Play -> dark forest gray -> stat line types -> "But you stood out." -> popup with pastel confetti.
// Everything partner-specific comes from `partner` (src/data/reveal-partners.ts); this component is never forked per company.
const { partner } = Astro.props as { partner: RevealPartner };
const stat = statLine();
const title = popupTitle(partner);
---
<div class="rv" data-cohort-reveal data-state="idle" data-stat-text={stat} hidden>
  <button class="play" type="button" data-reveal-play aria-label="Play">
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
    <span>Play</span>
  </button>
  <div class="story" data-story aria-live="polite">
    <p class="stat"><span data-typed aria-hidden="true"></span><span class="sr" data-stat-full></span></p>
    <p class="stood" data-stood>{STOOD_OUT}</p>
  </div>
  <div class="popup" data-popup role="dialog" aria-modal="true" aria-labelledby="rv-title" hidden>
    <img src={partner.logo} alt={`${partner.name} logo`} width="200" height="120" data-popup-logo />
    <h2 id="rv-title" data-popup-title>{title}</h2>
    <!-- #227: share card and letter render here, between the title and the portal action. -->
    <div data-reveal-extra></div>
    <a class="pill go" href="/portal" data-reveal-next>Go to my portal</a>
  </div>
</div>
<script>
  const root = document.querySelector<HTMLElement>('[data-cohort-reveal]');
  if (root) {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const text = root.dataset.statText ?? '';
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const set = (s: string) => { root.dataset.state = s; };
    $('[data-stat-full]').textContent = text;
    root.hidden = false;
    document.documentElement.style.overflow = 'hidden';

    const confetti = () => {
      const colors = ['#ffc8dd', '#bde0fe', '#cdb4db', '#b9fbc0', '#fdffb6', '#ffd6a5'];
      for (let i = 0; i < 48; i++) {
        const p = document.createElement('i');
        p.className = 'confetti';
        p.dataset.confetti = '';
        p.style.left = `${Math.random() * 100}%`;
        p.style.background = colors[i % colors.length];
        root.appendChild(p);
        p.animate(
          [{ transform: 'translateY(-20px) rotate(0)', opacity: 1 }, { transform: `translateY(${innerHeight}px) rotate(${360 + Math.random() * 360}deg)`, opacity: 0 }],
          { duration: 1800 + Math.random() * 1400, delay: Math.random() * 500, easing: 'ease-in', fill: 'forwards' },
        ).onfinish = () => p.remove();
      }
    };

    $('[data-reveal-play]').addEventListener('click', async () => {
      if (root.dataset.state !== 'idle') return;
      if (reduced) {
        // Play is still tapped, but every beat after it appears at once: no typing, no confetti motion.
        $('[data-typed]').textContent = text;
        set('popup');
        $<HTMLElement>('[data-popup]').hidden = false;
        $<HTMLElement>('[data-reveal-next]').focus();
        return;
      }
      set('dark');
      await wait(900);
      set('typing');
      const el = $('[data-typed]');
      for (let i = 1; i <= text.length; i++) { el.textContent = text.slice(0, i); await wait(22); }
      await wait(500);
      set('stood');
      await wait(1600);
      $<HTMLElement>('[data-popup]').hidden = false;
      set('popup');
      confetti();
      $<HTMLElement>('[data-reveal-next]').focus();
    });
  }
</script>
<style>
  .rv { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; padding: var(--sp-24); background: #fff; color: var(--ink); transition: background 0.9s ease, color 0.9s ease; overflow: hidden; }
  .rv[hidden] { display: none; }
  .rv:not([data-state='idle']) { background: #1f2b26; color: #e7ede9; }
  .play { display: inline-flex; align-items: center; gap: var(--sp-8); min-height: 56px; padding: 0 var(--sp-32); border: 0; border-radius: var(--r-pill); background: var(--ink); color: #fff; font: inherit; font-size: var(--fs-17); font-weight: var(--fw-600); cursor: pointer; transition: opacity 0.4s ease; }
  .play:focus-visible, .go:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .rv:not([data-state='idle']) .play { opacity: 0; pointer-events: none; position: absolute; }
  .story { position: absolute; inset: 0; padding: var(--sp-24); display: none; flex-direction: column; justify-content: space-between; }
  .rv:not([data-state='idle']) .story { display: flex; }
  .stat { margin: 0; padding-top: 12svh; font-size: var(--fs-22); line-height: 1.4; font-weight: var(--fw-600); overflow-wrap: break-word; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .stood { margin: 0; padding-bottom: 8svh; font-size: var(--fs-28); font-weight: var(--fw-800); letter-spacing: var(--track-tight); opacity: 0; transition: opacity 0.8s ease; }
  .rv[data-state='stood'] .stood, .rv[data-state='popup'] .stood { opacity: 1; }
  .popup { position: relative; width: min(100%, 420px); display: grid; justify-items: center; gap: var(--sp-16); padding: var(--sp-32) var(--sp-24); border-radius: var(--r-24, 24px); background: #fff; color: var(--ink); text-align: center; animation: up 0.8s ease both; z-index: 2; }
  .popup[hidden] { display: none; }
  .popup img { width: auto; max-width: 220px; height: 120px; object-fit: contain; }
  .popup h2 { margin: 0; font-size: var(--fs-28); font-weight: var(--fw-800); letter-spacing: var(--track-tight); line-height: 1.15; text-wrap: balance; }
  .go { min-height: 44px; display: inline-flex; align-items: center; text-decoration: none; }
  .rv :global(.confetti) { position: absolute; top: 0; width: 10px; height: 14px; border-radius: 2px; pointer-events: none; z-index: 3; }
  @keyframes up { from { opacity: 0; transform: translateY(24px); } }
  @media (prefers-reduced-motion: reduce) { .rv, .stood, .play { transition: none; } .popup { animation: none; } }
</style>
