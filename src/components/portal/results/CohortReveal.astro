---
import { statLine, STOOD_OUT } from '../../../data/reveal-facts';
import { popupTitle, type RevealPartner } from '../../../data/reveal-partners';
import RevealActions from './RevealActions.astro';
// #226: Play -> dark forest gray -> stat line types -> "But you stood out." -> popup with pastel confetti.
// Everything partner-specific comes from `partner` (src/data/reveal-partners.ts); this component is never forked per company.
// It auto-plays only until the ceremony is done (`done` = ceremony_done_at set); after that the letter shows with a small Replay.
const { partner, resultId, done = false, stub = false, org = '', birthday = null } = Astro.props as { partner: RevealPartner; resultId: number; done?: boolean; stub?: boolean; org?: string; birthday?: string | null };
const stat = statLine();
const hasCopy = Boolean(partner.copy);
const title = popupTitle(partner);
---
<div class="rv" data-cohort-reveal data-state="idle" data-stat-text={stat} data-result-id={resultId} data-done={done ? '1' : '0'} data-stub={stub ? '1' : '0'} data-logo={partner.logo} hidden>
  <button class="play" type="button" data-reveal-play aria-label="Play" disabled>
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
    <span>Play</span>
  </button>
  <div class="story" data-story>
    <p class="stat"><span data-typed aria-hidden="true"></span><span class="sr" role="status" data-stat-full></span></p>
    <p class="stood" data-stood>{STOOD_OUT}</p>
  </div>
  <div class="popup" data-popup role="dialog" aria-modal="true" aria-labelledby="rv-title" hidden>
    <img src={partner.logo} alt={`${partner.name} logo`} width="200" height="120" data-popup-logo />
    <h2 id="rv-title" data-popup-title>{title}</h2>
    <p class="line" data-popup-line>{partner.line}</p>
    <div data-reveal-extra>{hasCopy && <RevealActions cfg={partner} org={org} birthday={birthday} />}</div>
    {!hasCopy && <a class="pill go" href="/portal" data-reveal-next>Go to my portal</a>}
  </div>
</div>
<script>
  import { celebrationPlan, runCelebration } from '../../../lib/portal/celebrate';
  const root = document.querySelector<HTMLElement>('[data-cohort-reveal]');
  if (root) {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const replayBtn = document.querySelector<HTMLElement>('[data-reveal-replay]');
    const text = root.dataset.statText ?? '';
    const stub = root.dataset.stub === '1';
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const store = (k: string, v?: string) => { try { return v === undefined ? sessionStorage.getItem(k) : sessionStorage.setItem(k, v); } catch { return null; } };
    let done = root.dataset.done === '1' || (stub && store('rv-done') === '1');
    let replay = false;
    let skipNow = () => {};
    const skipped = new Promise<void>((r) => { skipNow = r; });
    const wait = (ms: number) => Promise.race([new Promise((r) => setTimeout(r, ms)), skipped]);
    const set = (s: string) => { root.dataset.state = s; };
    const inertOthers = () => document.querySelectorAll('body > *:not(main), main > *:not([data-cohort-reveal])').forEach((el) => { (el as HTMLElement).inert = true; (el as HTMLElement).style.visibility = 'hidden'; });
    const open = () => { root.hidden = false; document.documentElement.style.overflow = 'hidden'; };

    // Finish is sent once, when the popup is reached. A failed POST never blocks; one beacon retry on pagehide.
    let finishPending = false;
    const finish = async () => {
      done = true;
      if (stub) { store('rv-done', '1'); return; }
      const body = JSON.stringify({ action: 'finish', id: Number(root.dataset.resultId) });
      try {
        const r = await fetch('/portal/api/ceremony', { method: 'POST', headers: { 'content-type': 'application/json' }, body });
        if (!r.ok) throw new Error('finish');
      } catch {
        finishPending = true;
        addEventListener('pagehide', () => { if (finishPending) navigator.sendBeacon('/portal/api/ceremony', new Blob([body], { type: 'application/json' })); }, { once: true });
      }
    };

    // Loading beat: logo and fonts are ready before Play can be tapped (capped at 3s so a slow network never strands it).
    const logo = new Image();
    logo.src = root.dataset.logo ?? '';
    Promise.race([Promise.all([logo.decode().catch(() => {}), document.fonts.ready]), new Promise((r) => setTimeout(r, 3000))])
      .then(() => { $<HTMLButtonElement>('[data-reveal-play]').disabled = false; });

    let stopFx = () => {};
    const stopConfetti = () => { stopFx(); root.querySelectorAll('canvas[data-celebrate]').forEach((c) => c.remove()); };
    const confetti = () => {
      stopConfetti();
      const cv = document.createElement('canvas');
      cv.dataset.celebrate = '';
      cv.setAttribute('aria-hidden', 'true');
      cv.style.cssText = 'position:fixed;inset:0;width:100vw;height:100vh;z-index:1000;pointer-events:none';
      root.appendChild(cv);
      stopFx = runCelebration(cv, celebrationPlan({ reduced, width: innerWidth }));
      setTimeout(stopConfetti, 3800);
      document.addEventListener('visibilitychange', () => { if (document.hidden) stopConfetti(); }, { once: true });
    };

    const popup = () => {
      $<HTMLElement>('[data-popup]').hidden = false;
      set('popup');
      inertOthers();
      $<HTMLElement>('[data-reveal-next]').focus();
      if (!done) void finish();
    };

    // On a replay a tap anywhere during the build skips ahead to the popup.
    root.addEventListener('click', (e) => { if (replay && ['dark', 'typing', 'stood'].includes(root.dataset.state ?? '') && !(e.target as HTMLElement).closest('a')) skipNow(); });

    $('[data-reveal-play]').addEventListener('click', async () => {
      if (root.dataset.state !== 'idle') return;
      replay = done;
      $('[data-stat-full]').textContent = text;
      set('dark');
      await wait(900);
      set('typing');
      const el = $('[data-typed]');
      if (reduced) {
        // No typing: the whole line crossfades in. The dim and the pauses stay.
        el.textContent = text;
        await wait(500);
      } else {
        for (let i = 1; i <= text.length; i++) {
          el.textContent = text.slice(0, i);
          await wait(22);
        }
        await wait(500);
      }
      el.textContent = text;
      set('stood');
      await wait(1200);
      popup();
      if (!reduced && !document.hidden) confetti();
    });

    replayBtn?.addEventListener('click', () => open());
    if (done && replayBtn) replayBtn.hidden = false;
    else open();
  }
</script>
<style>
  .rv { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; padding: max(var(--sp-24), env(safe-area-inset-top)) max(var(--sp-24), env(safe-area-inset-right)) max(var(--sp-24), env(safe-area-inset-bottom)) max(var(--sp-24), env(safe-area-inset-left)); background: #fff; color: var(--ink); transition: background var(--dur-5) var(--ease), color var(--dur-5) var(--ease); overflow: hidden; }
  .rv[hidden] { display: none; }
  .rv:not([data-state='idle']) { background: #1f2b26; color: #e7ede9; }
  .play { display: inline-flex; align-items: center; gap: var(--sp-8); min-height: 56px; padding: 0 var(--sp-32); border: 0; border-radius: var(--r-pill); background: var(--ink); color: #fff; font: inherit; font-size: var(--fs-17); font-weight: var(--fw-600); cursor: pointer; transition: opacity var(--dur-3) var(--ease); }
  .play:focus-visible, .go:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .rv:not([data-state='idle']) .play { opacity: 0; pointer-events: none; position: absolute; }
  .story { position: absolute; inset: 0; padding: var(--sp-24); display: none; flex-direction: column; justify-content: space-between; }
  .rv:not([data-state='idle']) .story { display: flex; }
  .stat { margin: 0; padding-top: 12svh; font-size: var(--fs-22); line-height: 1.4; font-weight: var(--fw-600); overflow-wrap: break-word; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .stood { margin: 0; padding-bottom: 8svh; font-size: var(--fs-28); font-weight: var(--fw-800); letter-spacing: var(--track-tight); opacity: 0; transition: opacity var(--dur-4) var(--ease); }
  .rv[data-state='stood'] .stood { opacity: 1; }
  .story { transition: opacity var(--dur-4) var(--ease); }
  .rv[data-step]:not([data-step='intro']) [data-popup-logo], .rv[data-step]:not([data-step='intro']) [data-popup-title] { display: none; }
  .rv[data-state='popup'] .story { opacity: 0; }
  .popup { position: relative; width: min(100%, 420px); display: grid; justify-items: center; gap: var(--sp-16); padding: var(--sp-32) var(--sp-24); border-radius: var(--r-24); background: #fff; color: var(--ink); text-align: center; max-height: 100%; overflow-y: auto; box-sizing: border-box; animation: up var(--dur-4) var(--ease) both; z-index: 2; }
  .popup[hidden] { display: none; }
  @media (max-height: 500px) { .popup img { height: 72px; } .popup { padding: var(--sp-16) var(--sp-24); gap: var(--sp-8); } }
  .popup img { width: auto; max-width: 200px; height: 80px; object-fit: contain; }
  @media (max-height: 740px) { .popup img { height: 48px; } .popup { padding: var(--sp-16) var(--sp-24); gap: var(--sp-8); } }
  .popup h2 { margin: 0; font-size: var(--fs-28); font-weight: var(--fw-800); letter-spacing: var(--track-tight); line-height: 1.15; text-wrap: balance; }
  .popup .line { margin: calc(-1 * var(--sp-8)) 0 0; font-size: var(--fs-17); color: var(--muted); }
  .go { min-height: 44px; display: inline-flex; align-items: center; text-decoration: none; }
  .rv :global(.confetti) { position: absolute; top: 0; width: 10px; height: 14px; border-radius: var(--sp-4); pointer-events: none; z-index: 3; }
  @keyframes up { from { opacity: 0; transform: translateY(24px); } }
  .play:disabled { opacity: 0.5; cursor: default; }
  @media (prefers-reduced-motion: reduce) {
    .stat { opacity: 0; transition: opacity var(--dur-4) var(--ease); }
    .rv[data-state='typing'] .stat, .rv[data-state='stood'] .stat { opacity: 1; }
    .popup { animation: fade var(--dur-4) var(--ease) both; }
  }
  @keyframes fade { from { opacity: 0; } }
</style>
