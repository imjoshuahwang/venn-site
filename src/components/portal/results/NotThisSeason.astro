---
import '../results/outcome.css';
import { CONTACT, viewFor } from '../../../data/portal-copy';
import SlideDeck from '../slides/SlideDeck.astro';
import Slide from '../slides/Slide.astro';
import ResultState from './ResultState.astro';
const { letter } = Astro.props as { letter: unknown };
const v = viewFor('not_this_season', letter);
const optIn = `mailto:${CONTACT}?subject=${encodeURIComponent('Consider me for the next Venn season')}`;
---
{v.letter === null ? <ResultState state="empty" /> : (
  <SlideDeck label="Your result">
    <Slide title="Thank you for applying." lead="Truly. Somebody on our team read every word you wrote, and we do not take that for granted." cta="Read your letter" />
    <Slide title={v.heading} lead={v.note} cta="Continue"><p class="letter">{v.letter}</p></Slide>
    <Slide title="What tends to help" cta="Continue"><ul class="list">{v.tips.map((t) => <li>{t}</li>)}</ul></Slide>
    <Slide title="Want us to keep you in mind?" lead="Say yes and we will consider you for the next season before it opens to everyone. No pressure, and you can change your mind any time." cta="">
      <div class="actions">
        <a class="btn" href={optIn} data-optin>Consider me for the next one</a>
        <a class="btn btn-ghost" href="/portal/next-steps">See what to do next</a>
        <a class="btn btn-ghost" href="/portal">Back to your home</a>
      </div>
    </Slide>
  </SlideDeck>
)}
