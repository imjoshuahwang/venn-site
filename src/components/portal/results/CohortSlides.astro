---
import { buildSlides, SLIDE_COPY } from '../../../scripts/portal/slides';
import { COHORT_COPY } from '../../../data/mou';
import { deckFor, rowDeck } from '../../../data/cohort-decks';
// One idea per slide. AWS and Quadron decks live in code (they end in a prefilled email); every other cohort renders its own row slides.
// `flat` stacks the slides 16:9 for the dev PDF export, no controls.
const { cohort, logo = null, firstName = '', flat = false } = Astro.props as { cohort: any; logo?: string | null; firstName?: string; flat?: boolean };
const slides: any[] = deckFor(cohort?.slug, { firstName }) ?? rowDeck(buildSlides(cohort, logo));
---
{slides.length > 0 && (
  <section class:list={['deck', { flat }]} data-slides role="region" aria-roledescription="carousel" aria-label={SLIDE_COPY.region}>
    <div class="track" data-track tabindex="0">
      {slides.map((s, i) => (
        <article class="slide" data-slide={i} aria-label={SLIDE_COPY.counter(i + 1, slides.length)}>
          {s.logo && <img src={s.logo} alt={COHORT_COPY.logoAlt(s.big || 'Partner')} width="64" height="64" />}
          {s.kicker && <p class="kicker">{s.kicker}</p>}
          <p class="body">{s.big}</p>
          {s.sub && <p class="sub">{s.sub}</p>}
          {s.video && (
            flat ? <img class="poster" src={s.video.poster} alt={s.video.label} width="568" height="320" /> : (
              <video class="video" controls playsinline preload="none" poster={s.video.poster} aria-label={s.video.label} width="568" height="320">
                <source src={s.video.src} type="video/mp4" />
              </video>
            )
          )}
          {s.cta && <a class="pill cta" href={s.cta.href}>{s.cta.label}</a>}
        </article>
      ))}
    </div>
    {!flat && slides.length > 1 && (
      <div class="bar">
        <div class="dots" aria-hidden="true">{slides.map((_, i) => <i data-dot={i}></i>)}</div>
        <span class="count" data-count aria-live="polite">{SLIDE_COPY.counter(1, slides.length)}</span>
        <div class="ctls">
          <button type="button" class="ctl ghost" data-prev aria-label={SLIDE_COPY.prev} disabled>&larr;</button>
          <button type="button" class="pill ctl" data-next aria-label={SLIDE_COPY.next}>Next</button>
        </div>
      </div>
    )}
  </section>
)}
<script>
  import { stepIndex, SLIDE_COPY } from '../../../scripts/portal/slides';
  const root = document.querySelector<HTMLElement>('[data-slides]');
  if (root && root.querySelector('[data-next]')) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const n = track.children.length;
    const count = root.querySelector<HTMLElement>('[data-count]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const current = () => Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));
    const go = (dir: 1 | -1) => {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollTo({ left: stepIndex(current(), n, dir) * track.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
    };
    const sync = () => {
      const i = current();
      if (count) count.textContent = SLIDE_COPY.counter(i + 1, n);
      prev.disabled = i === 0;
      next.hidden = i === n - 1; // the last slide's own button is the end of the deck
      dots.forEach((d, k) => d.classList.toggle('on', k <= i));
      track.querySelectorAll('video').forEach((v) => { if (!v.closest('[data-slide]')!.matches(`[data-slide="${i}"]`)) v.pause(); });
    };
    sync();
    track.addEventListener('scroll', sync, { passive: true });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
    });
    next.addEventListener('click', () => go(1));
    prev.addEventListener('click', () => go(-1));
  }
</script>
<style>
  .deck { display: grid; gap: var(--sp-24); }
  .track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .track::-webkit-scrollbar { display: none; }
  .track:focus-visible, .ctl:focus-visible, .cta:focus-visible { outline: 1px solid var(--muted); outline-offset: 2px; }
  .slide { flex: 0 0 100%; scroll-snap-align: start; scroll-snap-stop: always; min-height: min(56svh, 480px); padding: var(--sp-24) 0; display: grid; align-content: center; justify-items: start; gap: var(--sp-16); }
  img { border-radius: var(--r-12); object-fit: contain; }
  .kicker { margin: 0; font-size: var(--fs-13); font-weight: var(--fw-600); color: var(--muted); }
  .body { margin: 0; font-size: var(--fs-28); font-weight: var(--fw-800); letter-spacing: var(--track-tight); line-height: 1.1; color: var(--ink); overflow-wrap: break-word; text-wrap: balance; }
  .sub { margin: 0; font-size: var(--fs-17); color: var(--muted); max-width: 32ch; text-wrap: pretty; }
  .video, .poster { width: 100%; height: auto; aspect-ratio: 568 / 320; border-radius: var(--r-12); background: var(--panel); }
  .cta { margin-top: var(--sp-12); min-height: 44px; display: inline-flex; align-items: center; text-decoration: none; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-12); }
  .dots { display: flex; gap: var(--sp-4); flex: 1; max-width: 160px; }
  .dots i { flex: 1; height: 2px; border-radius: var(--r-pill); background: var(--line); transition: background var(--dur-2) var(--ease); }
  .dots i.on { background: var(--ink); }
  .count { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .ctls { display: flex; align-items: center; gap: var(--sp-8); }
  .ctl { min-height: 44px; min-width: 44px; padding: 0 var(--sp-24); cursor: pointer; font-size: var(--fs-17); font-family: inherit; }
  .ctl[hidden] { display: none; }
  .ctl.ghost { background: none; border: 0; color: var(--ink); padding: 0 var(--sp-16); }
  .ctl:disabled { opacity: 0.3; cursor: default; }
  button.pill { border: 0; }
  @media (min-width: 640px) { .body { font-size: var(--fs-40); } .slide { padding: var(--sp-32) 0; } .sub { font-size: var(--fs-22); max-width: 36ch; } }
  .deck.flat { gap: 0; }
  .deck.flat .track { display: block; overflow: visible; }
  .deck.flat .slide { width: 1600px; height: 900px; min-height: 0; padding: 0 calc(var(--sp-64) * 2.5); gap: var(--sp-24); break-after: page; }
  .deck.flat .body { font-size: var(--fs-56); }
  .deck.flat .sub { font-size: var(--fs-28); max-width: 28ch; }
  .deck.flat .poster { width: 568px; }
  @media (prefers-reduced-motion: reduce) { .track { scroll-behavior: auto; } .slide, .ctl, .dots i { transition: none; } }
</style>
