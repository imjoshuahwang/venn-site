---
import '../results/outcome.css';
import { CONTACT, viewFor } from '../../../data/portal-copy';
import SlideDeck from '../slides/SlideDeck.astro';
import Slide from '../slides/Slide.astro';
import ResultState from './ResultState.astro';
const { outcome, letter } = Astro.props as { outcome: 'network_waitlist' | 'track_waitlist'; letter: unknown };
const v = viewFor(outcome, letter);
---
{v.letter === null ? <ResultState state="empty" /> : (
  <SlideDeck label="Your result">
    <Slide title={v.heading} lead={v.note} cta="Read your letter" />
    <Slide title="A note from the Venn team" cta="Continue"><p class="letter">{v.letter}</p></Slide>
    <Slide title="What waiting gets you" lead="You are not out, you are next in line, and here is what that means in practice." cta="">
      <ul class="list">{v.perks.map((p) => <li>{p}</li>)}</ul>
      <div class="actions">
        <a class="btn" href="/portal/next-steps">See what to do next</a>
        <a class="btn btn-ghost" href="/portal">Back to your home</a>
        <a class="btn btn-ghost" href={`mailto:${CONTACT}`}>Write to us</a>
      </div>
    </Slide>
  </SlideDeck>
)}
