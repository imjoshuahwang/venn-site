---
// One question per screen. Submissions go straight into Supabase `applications` (insert-only RLS, see supabase/migrations).
const url = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
const building = ['Just me', 'A club', 'A nonprofit', 'A project', 'A startup', 'Research', 'Other'];
---
<form class="form" id="apply-form" data-url={url} data-key={key} novalidate>
  <div class="progress" aria-hidden="true"><div class="progress-bar"><i></i></div><span class="progress-txt">0% done</span></div>

  <div class="qs">
    <div class="q" data-step="role">
      <p class="q-h">Who are you?</p>
      <div class="choices">
        <button type="button" class="choice" data-set="role" data-value="student"><b>I'm a student</b><small>High school or college, building something</small></button>
        <button type="button" class="choice" data-set="role" data-value="college_club"><b>I'm with a college club</b><small>Want to work with students in your field</small></button>
        <button type="button" class="choice" data-set="role" data-value="organization"><b>I'm with a company</b><small>Want to support student builders</small></button>
      </div>
    </div>
    <div class="q" data-step="level" hidden>
      <p class="q-h">Where are you in school?</p>
      <div class="choices three">
        <button type="button" class="choice" data-set="level" data-value="high_school"><b>High school</b></button>
        <button type="button" class="choice" data-set="level" data-value="college"><b>College</b></button>
        <button type="button" class="choice" data-set="level" data-value="other"><b>Other</b></button>
      </div>
      <input name="level_other" placeholder="Tell us a bit more" aria-label="Where are you in school?" hidden>
    </div>
    <div class="q" data-step="building" hidden>
      <p class="q-h">What are you building?</p>
      <p class="q-hint">Pick all that apply.</p>
      <div class="chips">
        {building.map((b) => <label class="chip" data-college-only={b === 'Research' ? '' : undefined} hidden={b === 'Research'}><input type="checkbox" name="building" value={b}><span>{b}</span></label>)}
      </div>
      <input name="building_other" placeholder="What is it?" aria-label="What else are you building?" hidden>
    </div>
    <div class="q" data-step="name" hidden><label class="q-h" for="f-name">What's your name?</label><input id="f-name" name="name" required autocomplete="name"></div>
    <div class="q" data-step="email" hidden><label class="q-h" for="f-email">Where can we reach you?</label><input id="f-email" name="email" type="email" required autocomplete="email" placeholder="you@email.com"></div>
    <div class="q" data-step="org" hidden><label class="q-h" for="f-org" id="l-org">What school do you go to?</label><input id="f-org" name="org" required autocomplete="organization"></div>
    <div class="q" data-step="link" hidden><label class="q-h" for="f-link">Anywhere we can see it?</label><p class="q-hint">Optional. Website, Instagram, LinkedIn.</p><input id="f-link" name="link" inputmode="url" autocapitalize="off" spellcheck="false" placeholder="Link or @handle"></div>
    <div class="q" data-step="working_on" hidden><label class="q-h" for="f-work" id="l-work">What are you working on?</label><textarea id="f-work" name="working_on" required placeholder="What it is, who it's for, how far along it is"></textarea></div>
    <div class="q" data-step="need" hidden><label class="q-h" for="f-need" id="l-need">What would help most right now?</label><p class="q-hint">Optional.</p><textarea id="f-need" name="need" placeholder="A mentor, a partner club, a first event, funding..."></textarea></div>
  </div>
  <input class="hp" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true">

  <div class="q-nav">
    <button class="btn btn-ghost btn-sm q-back" type="button">Back</button>
    <button class="btn q-next" type="submit">Next</button>
  </div>
  <p class="form-status" id="f-status" role="status"></p>
</form>
<div class="done" id="apply-done" hidden>
  <h3>Got it. Thank you.</h3>
  <p class="muted" style="margin-top:8px">Every application is read by a person. You'll hear from us at the email you gave.</p>
</div>

<script>
  const form = document.getElementById('apply-form') as HTMLFormElement;
  const status = document.getElementById('f-status')!;
  const back = form.querySelector<HTMLButtonElement>('.q-back')!;
  const next = form.querySelector<HTMLButtonElement>('.q-next')!;
  const nav = form.querySelector<HTMLElement>('.q-nav')!;
  const bar = form.querySelector<HTMLElement>('.progress-bar i')!;
  const pct = form.querySelector<HTMLElement>('.progress-txt')!;
  const q = (s: string) => form.querySelector<HTMLElement>(`.q[data-step="${s}"]`)!;
  const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  const picked: Record<string, string> = {};
  const other = () => form.querySelector<HTMLInputElement>('input[name="building"][value="Other"]')!;

  // Students answer two extra questions; clubs and companies skip straight to the shared ones.
  const flow = () => [
    'role', ...(picked.role === 'student' ? ['level', 'building'] : []),
    'name', 'email', 'org', 'link', 'working_on', 'need',
  ];
  const copy: Record<string, [string, string, string]> = {
    student: ['What school do you go to?', 'What are you working on?', 'What would help most right now?'],
    college_club: ['Which university and club?', 'What does your club do?', 'Anything else we should know?'],
    organization: ['Which company?', 'How do you want to work with students?', 'Anything else we should know?'],
  };
  let at = 'role';

  const ok = (s: string) => {
    if (s === 'role') return !!picked.role;
    if (s === 'level') return !!picked.level && (picked.level !== 'other' || !!field('level_other').value.trim());
    if (s === 'building') return !!form.querySelector('input[name="building"]:checked') && (!other().checked || !!field('building_other').value.trim());
    const el = field(s) as HTMLInputElement | undefined;
    return !el || (el.required ? !!el.value.trim() && el.checkValidity() : el.checkValidity());
  };
  const hint = (s: string) => ({
    level: 'Tell us a bit more first.', building: 'Pick at least one.', name: 'Add your name to keep going.',
    email: 'That email looks off. Try you@email.com.', org: 'Fill this in to keep going.', working_on: 'A sentence or two is plenty.',
  } as Record<string, string>)[s] ?? 'Answer this one to keep going.';
  const paint = () => {
    const steps = flow(), i = steps.indexOf(at), last = i === steps.length - 1;
    const k = Math.round((i / (steps.length - 1)) * 100);
    bar.style.transform = `scaleX(${k / 100})`;
    pct.textContent = `${k}% done`;
    back.style.visibility = i ? 'visible' : 'hidden';
    nav.hidden = !i;
    next.hidden = at === 'role' || (at === 'level' && picked.level !== 'other');
    next.textContent = last ? 'Send application' : (at === 'link' || at === 'need') && !field(at).value.trim() ? 'Skip' : 'Next';
    next.classList.toggle('off', !ok(at));
  };
  const go = (to: string, dir: 1 | -1) => {
    q(at).hidden = true;
    const el = q(to);
    el.hidden = false;
    el.classList.remove('in', 'in-back');
    void el.offsetWidth;
    el.classList.add(dir > 0 ? 'in' : 'in-back');
    at = to;
    status.textContent = '';
    paint();
    // Text steps focus the field; choice steps focus the picked (or first) button so keyboard users stay in the form.
    (el.querySelector<HTMLElement>('input:not([type=checkbox]), textarea') ?? el.querySelector<HTMLElement>('.choice.on, .choice, .chip input'))?.focus({ preventScroll: true });
  };
  const step = (dir: 1 | -1) => {
    const steps = flow(), i = steps.indexOf(at);
    if (dir > 0 && !ok(at)) { status.textContent = hint(at); return; }
    if (dir > 0 && i === steps.length - 1) return send();
    go(steps[i + dir], dir);
  };

  form.addEventListener('click', (e) => {
    const c = (e.target as HTMLElement).closest<HTMLButtonElement>('.choice');
    if (!c) return;
    const { set, value } = c.dataset as { set: string; value: string };
    picked[set] = value;
    q(set).querySelectorAll('.choice').forEach((b) => b.classList.toggle('on', b === c));
    if (set === 'role') {
      const [org, work, need] = copy[value];
      document.getElementById('l-org')!.textContent = org;
      document.getElementById('l-work')!.textContent = work;
      document.getElementById('l-need')!.textContent = need;
    }
    if (set === 'level') {
      form.querySelector<HTMLElement>('[data-college-only]')!.hidden = value !== 'college';
      const t = field('level_other');
      t.hidden = value !== 'other';
      if (value === 'other') { paint(); return t.focus(); }
    }
    setTimeout(() => step(1), 180);
  });
  back.addEventListener('click', () => step(-1));
  form.addEventListener('input', () => { status.textContent = ''; paint(); });
  form.addEventListener('change', (e) => {
    if (e.target === other()) {
      const t = field('building_other');
      t.hidden = !other().checked;
      if (other().checked) t.focus();
    }
    paint();
  });
  form.addEventListener('submit', (e) => { e.preventDefault(); step(1); });
  form.addEventListener('keydown', (e) => {
    // Enter moves on from a one-line answer; in a text box it takes Cmd/Ctrl+Enter.
    const t = e.target as HTMLElement;
    if (e.key === 'Enter' && t.tagName === 'TEXTAREA' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); step(1); }
  });
  paint();

  async function send() {
    const fd = new FormData(form);
    if (fd.get('company_website')) return; // bot
    const data: Record<string, string> = { role: picked.role };
    if (picked.role === 'student') {
      data.level = picked.level === 'other' ? `other: ${String(fd.get('level_other')).trim()}` : picked.level;
      data.building = fd.getAll('building').map((b) => b === 'Other' ? `Other: ${String(fd.get('building_other')).trim()}` : b).join(', ');
    }
    for (const n of ['name', 'email', 'org', 'link', 'working_on', 'need']) {
      const v = String(fd.get(n) ?? '').trim();
      if (v) data[n] = v;
    }
    next.disabled = true;
    status.className = 'form-status';
    status.textContent = 'Sending...';
    try {
      const { url, key } = form.dataset;
      if (!url || !key) throw new Error('Supabase env vars missing');
      const res = await fetch(`${url}/rest/v1/applications`, {
        method: 'POST',
        headers: { apikey: key, Authorization: `Bearer ${key}`, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
        body: JSON.stringify({ ...data, source: location.pathname + location.search }),
      });
      if (!res.ok) throw new Error(await res.text());
      form.hidden = true;
      document.getElementById('apply-done')!.hidden = false;
    } catch (err) {
      console.error(err);
      next.disabled = false;
      status.className = 'form-status err';
      status.textContent = 'Something went wrong. Email contact@joinvenn.org and we will sort it out.';
    }
  }
</script>

<style>
  .form { margin-top: 32px; display: grid; gap: 24px; }
  .progress { display: flex; align-items: center; gap: 12px; font-size: 13px; color: var(--muted); }
  .progress-bar { flex: 1; height: 4px; border-radius: 4px; background: rgba(0, 0, 0, .07); overflow: hidden; }
  .progress-bar i { display: block; height: 100%; background: var(--black); border-radius: inherit; transform-origin: left; transform: scaleX(0); transition: transform .5s var(--ease); }
  .progress-txt { min-width: 7.5em; text-align: right; font-variant-numeric: tabular-nums; }
  .q { display: grid; gap: 12px; align-content: start; }
  .q.in { animation: q-in .45s var(--ease); }
  .q.in-back { animation: q-back .45s var(--ease); }
  @keyframes q-in { from { opacity: 0; transform: translateX(28px); filter: blur(4px); } }
  @keyframes q-back { from { opacity: 0; transform: translateX(-28px); filter: blur(4px); } }
  .q-h { display: block; font-size: clamp(1.35rem, 2.6vw, 1.75rem); font-weight: 600; letter-spacing: -.03em; line-height: 1.2; color: var(--black); }
  .q-hint { font-size: 14px; color: var(--muted); margin-top: -6px; }
  .q input:not([type=checkbox]), .q textarea {
    font: 17px/1.5 var(--font); color: var(--text); background: #fff; margin-top: 4px;
    border: 0; box-shadow: inset 0 0 0 1px #e5e5e5; border-radius: 14px; padding: 14px 16px; width: 100%;
  }
  .q textarea { min-height: 110px; resize: vertical; }
  .q input:focus, .q textarea:focus { outline: none; box-shadow: inset 0 0 0 2px #000; }
  .choices { display: grid; gap: 10px; }
  .choices.three { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 420px) { .choices.three { grid-template-columns: 1fr; } }
  .choice {
    font: inherit; text-align: left; padding: 16px 18px; border: 0; border-radius: 16px; background: #fff; cursor: pointer;
    box-shadow: inset 0 0 0 1px #e5e5e5; line-height: 1.4; transition: box-shadow .2s, transform .2s var(--ease);
  }
  .choice b { display: block; font-size: 16px; font-weight: 600; color: var(--black); }
  .choice small { color: var(--muted); font-size: 13px; }
  .choice:hover { box-shadow: inset 0 0 0 1px #b5b5b5; }
  .choice.on { box-shadow: inset 0 0 0 2px #000; }
  .choice:active { transform: scale(.985); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip input { position: absolute; opacity: 0; pointer-events: none; }
  .chip span {
    display: inline-block; padding: 10px 16px; border-radius: 999px; background: #fff; cursor: pointer; font-size: 15px;
    box-shadow: inset 0 0 0 1px #e5e5e5; transition: background .2s, color .2s, box-shadow .2s;
  }
  .chip input:checked + span { background: var(--black); color: #fff; box-shadow: none; }
  .choice:focus-visible, .chip input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .q-nav { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .q-next:disabled, .q-next.off { opacity: .3; cursor: default; transform: none; }
  .hp { position: absolute; left: -9999px; }
  .form-status { font-size: 15px; }
  .form-status:empty { display: none; }
  .form-status.err { color: #b91c1c; }
  .done { text-align: center; padding: 48px 0; }
  .done h3 { font-size: 28px; letter-spacing: -.03em; }
  @media (prefers-reduced-motion: reduce) { .q.in, .q.in-back { animation: none; } }
</style>
