---
// One entry per letter; quotes are lifted word for word from the PDFs. Letters without a pdf/letter get no dialog.
// Cards are white; ink overrides the near-black default and is sampled from the org's logo. mark: 'wide' (wordmark) or 'big' (larger icon).
type Testimonial = { org: string; logo?: string; mark?: 'wide' | 'big'; ink?: string; quote: string; name: string; role: string; pdf?: string; letter?: string[] };
const testimonials: Testimonial[] = [
  {
    org: 'The BU1LD',
    logo: '/logos/the-bu1ld.png',
    quote: 'Venn helped open doors we would not have been able to access so easily on our own. They do not just offer advice; they create real opportunities.',
    name: 'Ryan Gomez',
    role: 'Founder and CEO, The BU1LD',
    pdf: '/letters/the-bu1ld.pdf',
    letter: [
      'The BU1LD started with just 50 students from around the world in a WhatsApp group, with nothing more than an idea and a plan to build something meaningful together. Today, we have grown into a global community of over 5,500 members working on more than 500 projects across AI, research, and technology.',
      'Venn has been an important part of that journey, especially by helping us connect with Microsoft. As a student-led organization, getting opportunities to work with companies of that scale is incredibly difficult, and Venn helped open doors we would not have been able to access so easily on our own.',
      'Since then, we have built an ecosystem with access to approximately $250,000 in cloud credits and technical resources through our broader partnerships, while Venn has helped us reach an audience of over 500,000 people. What I appreciate most is that Venn genuinely believes in young founders and takes action to support them. They do not just offer advice; they create real opportunities.',
      'Going from a small WhatsApp group to a global research community has been an incredible journey, and we are genuinely grateful to Venn for being part of it.',
    ],
  },
  {
    org: 'Yvette Labs',
    logo: '/logos/yvette-labs.png',
    mark: 'wide',
    ink: '#151515',
    quote: 'We look forward to working with the Venn team to further our vision for safety amid the technological arms race we find ourselves in.',
    name: 'Chairman of the Board',
    role: 'Yvette Labs',
  },
  {
    org: 'The Imperial Review',
    logo: '/logos/imperial-review.png',
    mark: 'big',
    ink: '#55171e',
    quote: 'We recommend Venn to organizations seeking to connect with students and make a meaningful contribution to their growth.',
    name: 'The Editorial Staff',
    role: 'The Imperial Review',
  },
];
---
<section id="testimonials" class="tm">
  <div class="wrap">
    <h2 class="h2 tm-h">What partners say.</h2>
    <div class="tm-stage" aria-roledescription="carousel">
      {testimonials.map((t, i) => (
        <article class:list={['tm-card', { on: i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'} style={t.ink && `--ink: ${t.ink}`}>
          {t.logo && <img class:list={['tm-logo', t.mark]} src={t.logo} alt={t.org} width={t.mark === 'wide' ? 318 : 96} height="96" loading="lazy" />}
          <blockquote class="tm-quote">“{t.quote}”</blockquote>
          <p class:list={['tm-by', { big: !t.letter }]}><strong>{t.name}</strong><span>{t.role}</span></p>
          {t.letter && <button class="btn tm-open" type="button" data-letter={`letter-${i}`}>Read the full letter</button>}
        </article>
      ))}
    </div>
    {testimonials.length > 1 && (
      <div class="tm-nav">
        <button class="btn btn-ghost btn-sm" type="button" data-step="-1" aria-label="Previous testimonial">←</button>
        <button class="btn btn-ghost btn-sm" type="button" data-step="1" aria-label="Next testimonial">→</button>
      </div>
    )}
  </div>

  {testimonials.map((t, i) => t.letter && (
    <dialog class="tm-dialog" id={`letter-${i}`} aria-labelledby={`letter-${i}-title`}>
      <article class="tm-letter">
        <header>
          <img src={t.logo} alt="" width="56" height="56" loading="lazy" />
          <h3 id={`letter-${i}-title`}>{t.org} and Venn</h3>
        </header>
        {t.letter.map((para) => <p>{para}</p>)}
        <p class="tm-sign"><strong>{t.name}</strong><span>{t.role}</span></p>
        <footer>
          <a href={t.pdf} download>Download PDF</a>
          <button class="btn btn-sm" type="button" data-close>Close</button>
        </footer>
      </article>
    </dialog>
  ))}
</section>

<style>
  .tm { padding: 96px 0; }
  .tm-h { text-align: center; margin-bottom: 40px; }
  /* Cards stack in one grid cell and cross-fade, so the stage takes the tallest card's height. */
  .tm-stage { display: grid; max-width: 640px; margin: 0 auto; }
  .tm-card {
    --bg: #fff; --ink: #151515; --soft: color-mix(in srgb, var(--ink) 60%, var(--bg));
    grid-area: 1 / 1; background: var(--bg); color: var(--ink); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .08); border-radius: 28px; padding: clamp(28px, 4vw, 44px);
    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 20px;
    opacity: 0; transform: scale(.98); pointer-events: none; transition: opacity .5s ease, transform .5s var(--ease);
  }
  .tm-card.on { opacity: 1; transform: none; pointer-events: auto; }
  .tm-logo { width: 64px; height: 64px; border-radius: 16px; object-fit: cover; }
  .tm-logo.wide { width: auto; border-radius: 0; }
  .tm-logo.big { width: 83px; height: 83px; }
  .tm-quote { margin: 0; font-size: clamp(18px, 2.2vw, 24px); line-height: 1.3; font-weight: 600; letter-spacing: -.02em; }
  .tm-by { margin: 0; display: flex; flex-direction: column; gap: 2px; font-size: 15px; color: var(--soft); }
  .tm-by strong { color: var(--ink); font-weight: 600; font-size: 17px; }
  .tm-by.big { gap: 4px; font-size: 17px; font-weight: 600; }
  .tm-by.big strong { font-size: 21px; font-weight: 700; letter-spacing: -.02em; }
  .tm-open { background: var(--ink); color: var(--bg); }
  .tm-nav { display: flex; justify-content: center; gap: 8px; margin-top: 20px; }

  .tm-dialog { width: min(680px, calc(100vw - 32px)); max-height: 88vh; padding: 0; border: 0; border-radius: 24px; background: #fff; }
  .tm-dialog::backdrop { background: rgba(0, 0, 0, .45); backdrop-filter: blur(6px); }
  .tm-letter { padding: clamp(28px, 5vw, 52px); color: var(--body); font-size: 16px; line-height: 1.65; }
  .tm-letter header { display: flex; align-items: center; gap: 14px; margin-bottom: 24px; }
  .tm-letter header img { border-radius: 14px; object-fit: cover; }
  .tm-letter h3 { margin: 0; font-size: clamp(22px, 3vw, 28px); font-weight: 600; letter-spacing: -.03em; color: var(--black); }
  .tm-letter p { margin: 0 0 16px; }
  .tm-sign { display: flex; flex-direction: column; margin-top: 28px !important; color: var(--muted); font-size: 15px; }
  .tm-sign strong { color: var(--black); font-weight: 600; }
  .tm-letter footer { display: flex; align-items: center; justify-content: space-between; margin-top: 28px; padding-top: 16px; border-top: 1px solid var(--line); }
  .tm-letter footer a { font-size: 14px; color: var(--muted); }
</style>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>('.tm-card')];
  const stage = document.querySelector<HTMLElement>('.tm-stage')!;
  // Rotate on its own unless the visitor is reading (hover/focus) or prefers less motion.
  const auto = cards.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Each card stays up for its reading time: quote + byline at 250 wpm, plus 1.5s, held to 4-5s.
  const wait = (c: HTMLElement) => {
    const words = [...c.querySelectorAll('.tm-quote, .tm-by > *')].map((e) => e.textContent).join(' ').trim().split(/\s+/).length;
    return Math.min(5000, Math.max(4000, words / 250 * 60000 + 1500));
  };
  let at = 0, timer = 0;
  const tick = () => {
    clearTimeout(timer);
    timer = window.setTimeout(() => (stage.matches(':hover, :focus-within') ? tick() : show(at + 1)), wait(cards[at]));
  };
  const show = (i: number) => {
    at = (i + cards.length) % cards.length;
    cards.forEach((c, j) => { c.classList.toggle('on', j === at); c.toggleAttribute('aria-hidden', j !== at); });
    if (auto) tick();
  };
  document.querySelectorAll<HTMLButtonElement>('.tm-nav button').forEach((b) => b.addEventListener('click', () => show(at + Number(b.dataset.step))));
  if (auto) tick();

  document.querySelectorAll<HTMLButtonElement>('.tm-open').forEach((b) => b.addEventListener('click', () => {
    (document.getElementById(b.dataset.letter!) as HTMLDialogElement).showModal();
  }));
  document.querySelectorAll<HTMLDialogElement>('.tm-dialog').forEach((d) => {
    d.querySelector('[data-close]')!.addEventListener('click', () => d.close());
    // A click on the backdrop lands on the dialog itself, not its children.
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  });
</script>
