---
import '@fontsource/dancing-script/latin-700.css';

// "What's your thing?": the lead-in arrives letter by letter, then "thing" writes itself in forest-green cursive
// and a swash underlines it. The kinds of thing sit around the headline.
const lead = 'What’s your';
let hi = 0;
const words = lead.split(' ').map((w) => [...w].map((c) => [c, hi++] as const));
const kinds = [
  ['a club', 'tl'], ['a nonprofit', 'tr'], ['a project', 'bl'], ['a startup', 'br'],
];
---
<section class="hero">
  <div class="wrap">
    <div class="stage">
      <h1 aria-label="What’s your thing?">
        {words.map((w) => <><span class="hw" aria-hidden="true">{w.map(([c, i]) => <span class="hc" style={`--i:${i}`}>{c}</span>)}</span>{' '}</>)}<span class="hw" aria-hidden="true"><span class="thing"><span class="ink">thing</span><svg class="swash" viewBox="0 0 300 30" preserveAspectRatio="none"><path pathLength="1" d="M6 20 C 70 8, 150 6, 294 14" /></svg></span><span class="hc q" style={`--i:${hi + 4}`}>?</span></span>
      </h1>
      {kinds.map(([k, pos], i) => <span class:list={['kind', pos]} style={`--k:${i}`} aria-hidden="true">{k}</span>)}
    </div>
    <p class="sub reveal">Venn is a free program<br>for students building <span class="hl">their thing</span>.</p>
    <div class="hero-cta reveal">
      <a class="btn" href="#apply">Apply for Fall ’26</a>
      <a class="btn btn-ghost" href="#seasons">See past seasons</a>
    </div>
  </div>
</section>

<style>
  .hero { padding: 160px 0 0; text-align: center; overflow: hidden; --forest: #2a4a30; --leaf: #5f8f63; }
  .hero .wrap { width: 100%; }
  .stage { position: relative; display: inline-block; padding: 0 0 8px; }
  .hero h1 {
    font-size: clamp(2.75rem, 8vw, 6rem); font-weight: 600; letter-spacing: -.045em; line-height: 1.1;
    margin: 0 auto;
  }
  .hw { display: inline-block; white-space: nowrap; }
  .hc { display: inline-block; animation: hc-in .9s var(--ease) both; animation-delay: calc(var(--i) * 28ms); }
  .q { animation-delay: 2.1s; }
  @keyframes hc-in { from { opacity: 0; transform: translateY(.28em); filter: blur(10px); } }

  /* The thing: cursive, forest green, written left to right like a pen stroke, then underlined. */
  .thing { position: relative; display: inline-block; margin: 0 .04em 0 .02em; }
  .ink {
    display: inline-block; font-family: 'Dancing Script', cursive; font-weight: 700; font-size: 1.3em;
    letter-spacing: 0; line-height: .8; color: var(--forest); padding: 0 .08em;
    clip-path: inset(-30% 100% -40% 0); animation: write 1.5s cubic-bezier(.55, .1, .35, 1) .55s forwards;
  }
  @keyframes write { to { clip-path: inset(-30% -10% -40% 0); } }
  .swash { position: absolute; left: 2%; right: 0; bottom: -.12em; width: 98%; height: .28em; overflow: visible; }
  .swash path {
    fill: none; stroke: var(--leaf); stroke-width: 6; stroke-linecap: round; vector-effect: non-scaling-stroke;
    stroke-dasharray: 1; stroke-dashoffset: 1; animation: swash .7s var(--ease) 1.9s forwards;
  }
  @keyframes swash { to { stroke-dashoffset: 0; } }

  /* Kinds of thing: soft pills that pop in around the headline once the word is written. */
  .kind {
    display: inline-block; padding: 8px 16px; border-radius: 999px; font-size: 15px; font-weight: 500;
    letter-spacing: -.01em; color: var(--forest); background: #e9f0e7; box-shadow: inset 0 0 0 1px #d3e0cf;
    opacity: 0; animation: pop .6s cubic-bezier(.34, 1.56, .64, 1) forwards, bob 5s ease-in-out infinite;
    animation-delay: calc(2.2s + var(--k) * .15s), calc(3s + var(--k) * .6s);
  }
  @keyframes pop { from { opacity: 0; transform: scale(.6) translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes bob { 50% { translate: 0 -6px; } }
  .kind { margin: 24px 4px 0; }
  @media (max-width: 899px) { .stage { display: block; } .kind { margin: 20px 3px 0; } }
  @media (max-width: 480px) { .kind { font-size: 13px; padding: 7px 11px; margin: 16px 1px 0; } }
  @media (min-width: 900px) {
    .kind { position: absolute; margin: 0; }
    .tl { left: -6%; top: -56px; rotate: -4deg; }
    .tr { right: -8%; top: -40px; rotate: 3deg; }
    .bl { left: 2%; bottom: -52px; rotate: 3deg; }
    .br { right: -2%; bottom: -64px; rotate: -3deg; }
  }

  /* The subline sits midway between the headline+pills block and the CTAs: --gap above and below.
     The stage has 8px bottom padding below the pills (stacked layout); on desktop the pills hang 64px below it. */
  .hero { --gap: 44px; }
  .sub { max-width: none; margin: calc(var(--gap) - 8px) auto 0; color: var(--muted); font-size: clamp(17px, 1.8vw, 21px); line-height: 1.45; }
  .hl {
    white-space: nowrap; color: var(--forest); font-weight: 500; padding: .02em .32em; margin: 0 -.1em;
    background: #cfe6c9;
    border-radius: .35em .6em .4em .65em; transform: rotate(-1deg); display: inline-block;
    -webkit-box-decoration-break: clone; box-decoration-break: clone;
  }
  @media (min-width: 900px) { .sub { margin-top: calc(var(--gap) + 64px); } }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: var(--gap); }
  .hero-cta.reveal, .sub.reveal { transition-delay: .12s; }
  @media (prefers-reduced-motion: reduce) {
    .hc, .kind { animation: none; opacity: 1; }
    .ink { animation: none; clip-path: none; }
    .swash path { animation: none; stroke-dashoffset: 0; }
  }
</style>
