---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { seasons, orgOf } from '../../data/seasons';

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/seasons/*.jpg', { eager: true });
const photo = (id: string) => files[`../../assets/seasons/${id}.jpg`].default;
const org = (id: string) => orgOf[id.replace(/_\d+$/, '')];
// One bento block per season: a big photo with four small ones beside it.
const spans = [[6, 4], [3, 2], [3, 2], [3, 2], [3, 2]];
const logoName = (f: string) => ({ 'y-combinator.svg': 'Y Combinator', 'nepc.png': 'National Education Policy Center', 'cu-boulder.svg': 'CU Boulder', 'uc-berkeley.svg': 'UC Berkeley', 'johns-hopkins.svg': 'Johns Hopkins', 'mit.svg': 'MIT', 'usc.svg': 'USC' } as Record<string, string>)[f]
  ?? f.replace('.svg', '').replace(/^./, (c) => c.toUpperCase());
const tilt = [-2.2, 1.6, -1.1, 2.4, -1.8, 1.2, -2.6, 1.9, -1.4, 2.1, -.9, 1.5, -2, 1.3];
---
<section id="seasons" class="past">
 <div class="pin">
 <div class="stage">
  <h2 class="h2 top">Every season so far.</h2>

  <nav class="jump" aria-label="Seasons">
    {seasons.map((s) => <a href={`#${s.code}`} data-code={s.code}>{s.code}</a>)}
  </nav>

  <div class="wrap seasons">
    {seasons.map((s) => (
      <article id={s.code} class:list={['season', s.tone, ]}>
        <header class="head reveal">
          <div>
            <p class="code">{s.code}</p>
            <p class="name">{s.name}</p>
          </div>
          <div class="facts">
            <p class="reach">{s.reach}<span>students reached</span></p>
            <p class="line">{s.line}</p>
          </div>
        </header>
        {s.photos.length > 0 && (
          <div class="grid">
            {s.photos.map((id, i) => (
              <figure class="ph reveal" style={`--c:${spans[i][0]};--r:${spans[i][1]};--t:${tilt[i % tilt.length]}deg;--dl:${(i % 5) * 70}ms`}>
                <Image src={photo(id)} alt={`${org(id)} event`} widths={[480, 900]} sizes="(min-width: 900px) 50vw, 100vw" />
              </figure>
            ))}
          </div>
        )}
        <div class="logos reveal">
          {[['Core partners', s.partners, 'core'], ['Partnered with clubs at', s.clubs, 'clubs']].map(([label, files, kind]) => (
            <div class={kind as string}>
              <p>{label}</p>
              <ul>{(files as string[]).map((f) => <li><img src={`/logos/${f}`} alt={logoName(f)} title={logoName(f)} loading="lazy" decoding="async" /></li>)}</ul>
            </div>
          ))}
        </div>
      </article>
    ))}
  </div>
 </div>
 </div>
</section>


<script>
  // Seasons sit side by side in one track. On wide screens the section pins and vertical scroll drives the track
  // (F26 -> W26) before the page moves on; on phones the track just swipes.
  const pin = document.querySelector<HTMLElement>('.pin')!;
  const track = document.querySelector<HTMLElement>('.seasons')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.jump a')];
  const wide = matchMedia('(min-width: 761px)');
  const travel = () => track.scrollWidth - track.clientWidth;
  const size = () => { pin.style.height = wide.matches ? `${innerHeight + travel()}px` : ''; sync(); };
  const sync = () => {
    if (!wide.matches) return;
    const p = Math.min(1, Math.max(0, -pin.getBoundingClientRect().top / (pin.offsetHeight - innerHeight || 1)));
    track.scrollLeft = p * travel();
  };
  addEventListener('scroll', sync, { passive: true });
  addEventListener('resize', size);
  wide.addEventListener('change', size);
  size();

  links.forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault();
    const card = document.getElementById(a.dataset.code!)!;
    const left = Math.min(travel(), Math.max(0, card.offsetLeft - track.offsetLeft - (track.clientWidth - card.offsetWidth) / 2));
    if (wide.matches) scrollTo({ top: pin.offsetTop + (left / (travel() || 1)) * (pin.offsetHeight - innerHeight), behavior: 'smooth' });
    else track.scrollTo({ left, behavior: 'smooth' });
  }));
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (e.isIntersecting) links.forEach((a) => a.classList.toggle('on', a.dataset.code === e.target.id));
  }), { root: track, threshold: .6 });
  document.querySelectorAll('.season').forEach((s) => io.observe(s));
</script>

<style>
  .past { padding-top: 96px; }
  .top { text-align: center; padding: 0 16px; }
  /* Wide screens: the stage sticks under the frosted nav (~80px) and the cards fill what is left of the viewport. */
  @media (min-width: 761px) {
    .past { padding-top: 0; }
    .stage { position: sticky; top: 0; height: 100vh; height: 100svh; display: flex; flex-direction: column; padding-top: 92px; overflow: hidden; }
    .top { font-size: clamp(2rem, 4vw, 3rem); }
    .stage .jump { margin-top: 14px; }
    .stage .seasons { flex: 1; min-height: 0; width: 100%; overflow: hidden; scroll-snap-type: none; padding-top: 18px; padding-bottom: 20px; }
    /* The photo grid takes whatever height the header and logos leave, so every card fits the pinned stage. */
    .stage .season { overflow: hidden; display: flex; flex-direction: column; }
    .stage .grid { flex: 1; min-height: 0; grid-template-rows: repeat(4, minmax(0, 1fr)); grid-auto-rows: 0; }
    .stage .line { min-height: 4.5em; }
    .stage .logos ul { gap: 10px 18px; }
    .stage .clubs img { height: 26px; max-width: 120px; }
  }

  .jump {
    display: flex; gap: 6px; width: max-content; margin: 24px auto 0;
    padding: 5px; border-radius: 999px; background: rgba(255, 255, 255, .6);
    -webkit-backdrop-filter: blur(18px) saturate(140%); backdrop-filter: blur(18px) saturate(140%);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .06);
  }
  .jump a { padding: 8px 16px; border-radius: 999px; font-size: 14px; font-weight: 500; color: var(--muted); text-decoration: none; transition: background .4s var(--ease), color .4s var(--ease); }
  .jump a:hover { color: var(--black); }
  .jump a.on { background: var(--black); color: #fff; }

  .seasons {
    display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    max-width: none; padding: 28px max(16px, calc((100vw - 880px) * .15)) 40px; scroll-padding-inline: max(16px, calc((100vw - 880px) * .15));
  }
  .seasons::-webkit-scrollbar { display: none; }
  .season { flex: 0 0 min(88vw, 880px); scroll-snap-align: start; border-radius: 28px; padding: clamp(20px, 3vw, 32px); }
  .sky { background: linear-gradient(180deg, #dbe5f5, #f1f5fc); }
  .sage { background: linear-gradient(180deg, #d9e6d5, #f2f7f1); }
  .warm { background: linear-gradient(180deg, #ebe7e1, #f8f6f3); }
  .mix { background: linear-gradient(135deg, #d9e6d5, #dbe5f5 60%, #eef3fb); }

  .head { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; }
  .code { font-size: clamp(3rem, 7vw, 5rem); font-weight: 600; letter-spacing: -.055em; line-height: .9; color: var(--black); }
  .name { margin-top: 10px; font-size: 15px; color: var(--muted); }
  .reach { font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 600; letter-spacing: -.045em; line-height: 1; color: var(--black); }
  .reach span { display: block; margin-top: 8px; font-size: 14px; font-weight: 400; letter-spacing: 0; color: var(--muted); }
  .line { margin-top: 12px; font-size: 15px; line-height: 1.5; color: var(--body); max-width: 30rem; }

  .grid { display: grid; grid-template-columns: repeat(12, 1fr); grid-auto-rows: clamp(30px, min(4.5vw, 4.6vh), 58px); grid-auto-flow: dense; gap: 8px; margin-top: 20px; }
  .ph { position: relative; margin: 0; grid-column: span var(--c); grid-row: span var(--r); border-radius: 20px; overflow: hidden; background: rgba(255, 255, 255, .5); transition-delay: var(--dl); }
  .ph.reveal { transform: translateY(28px) rotate(var(--t)) scale(.96); }
  .ph.reveal.in { transform: none; }
  .ph img { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; display: block; filter: saturate(.82) contrast(.92) brightness(.97); transition: transform 1.2s var(--ease); }
  .ph:hover img { transform: scale(1.04); }

  .logos { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; padding-top: 16px; border-top: 1px solid rgba(0, 0, 0, .07); }
  .logos p { font-size: 13px; color: var(--muted); }
  .logos ul { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; margin: 10px 0 0; padding: 0; }
  .logos img { display: block; width: auto; object-fit: contain; mix-blend-mode: multiply; }
  .core img { height: 28px; max-width: 130px; }
  .clubs img { height: 30px; max-width: 140px; }

  @media (max-width: 760px) {
    .logos { grid-template-columns: minmax(0, 1fr); }
    .logos ul { gap: 12px 24px; }
    .core img { height: 24px; max-width: 110px; }
    .clubs img { height: 26px; max-width: 120px; }
    .head { grid-template-columns: minmax(0, 1fr); align-items: start; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: auto; gap: 8px; }
    .ph { grid-column: auto; grid-row: auto; aspect-ratio: 1; border-radius: 16px; }
    .ph:first-child { grid-column: span 2; aspect-ratio: 16 / 9; }
    .ph:nth-child(n+4) { display: none; }
  }
</style>
